{
  "name": "neonhub",
  "version": "1.0.0",
  "description": "NeonHub - Futuristic Enterprise Management System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../mobile && npm install",
    "start": "cd backend && npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "pm2:start:neonhub": "pm2 start ecosystem.neonhub.config.js --env production && pm2 save",
    "pm2:restart:neonhub": "pm2 reload ecosystem.neonhub.config.js --env production && pm2 save",
    "pm2:stop:neonhub": "pm2 delete ecosystem.neonhub.config.js",
    "pm2:logs:neonhub": "pm2 logs neonhub-backend neonhub-frontend neonhub-landing",
    "neonhub:menu": "bash ./neonhub.sh"
  },
  "keywords": [
    "enterprise",
    "management",
    "react",
    "nodejs",
    "mysql",
    "jwt",
    "dashboard",
    "futuristic",
    "neon"
  ],
  "author": "NeonHub Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neonhub/neonhub.git"
  }
}