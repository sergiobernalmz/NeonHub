            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-300000000004",
      "name": "Set — Error Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [700, 420]
    }
  ],
