{
  "name": "WF-C — Cambio de Contraseña",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "password-change",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-300000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "wh-c3d4e5f6-password-change-0003"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.change_url }}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "c3d4e5f6-0003-4000-8000-300000000002",
      "name": "IF — Validar Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ ($json.store_name || 'NeonHub') + ' <soporte@neonhub.es>' }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ 'Cambiar contraseña en ' + ($json.store_name || 'NeonHub') }}",
        "emailType": "html",
        "message": "=`<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1.0'><title>Cambiar contraseña en ${ $json.store_name || 'NeonHub' }</title></head><body style='margin:0;padding:0;background:#0f172a;font-family:Arial,Helvetica,sans-serif;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#0f172a;'><tr><td align='center' style='padding:48px 20px;'><table width='600' cellpadding='0' cellspacing='0' border='0' style='max-width:600px;width:100%;background:#1e293b;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);'><tr><td style='padding:44px 48px 40px;background:linear-gradient(135deg,#7c3aed 0%,#2563eb 100%);text-align:center;'><table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td style='text-align:center;'><div style='display:inline-block;width:52px;height:52px;background:rgba(255,255,255,0.15);border-radius:12px;margin-bottom:20px;line-height:52px;font-size:24px;'>🔒</div><h1 style='margin:0 0 8px;color:#ffffff;font-size:26px;font-weight:700;letter-spacing:-0.5px;'>${ $json.store_name || 'NeonHub' }</h1><p style='margin:0;color:rgba(255,255,255,0.7);font-size:14px;font-weight:400;'>Solicitud de cambio de contraseña</p></td></tr></table></td></tr><tr><td style='padding:44px 48px 40px;'><p style='margin:0 0 20px;color:#94a3b8;font-size:16px;line-height:1.75;'>Hola <strong style='color:#f1f5f9;'>${ $json.username }</strong>,</p><p style='margin:0 0 32px;color:#94a3b8;font-size:16px;line-height:1.75;'>Hemos recibido una solicitud para cambiar la contraseña de tu cuenta en <strong style='color:#f1f5f9;'>${ $json.store_name || 'NeonHub' }</strong>. Haz clic en el botón de abajo para establecer una nueva contraseña.</p><table cellpadding='0' cellspacing='0' border='0' width='100%'><tr><td align='center' style='padding-bottom:40px;'><a href='${ $json.change_url }' style='display:inline-block;background:linear-gradient(135deg,#7c3aed,#2563eb);color:#ffffff;text-decoration:none;font-size:16px;font-weight:700;padding:18px 60px;border-radius:12px;letter-spacing:0.2px;'>🔑 Cambiar mi contraseña</a></td></tr></table><div style='background:rgba(255,255,255,0.04);border-radius:10px;padding:20px 24px;margin-bottom:32px;border:1px solid rgba(255,255,255,0.07);'><p style='margin:0 0 8px;color:#64748b;font-size:13px;font-weight:500;text-transform:uppercase;letter-spacing:0.5px;'>¿El botón no funciona?</p><p style='margin:0;word-break:break-all;'><a href='${ $json.change_url }' style='color:#818cf8;font-size:13px;text-decoration:none;'>${ $json.change_url }</a></p></div><div style='background:rgba(124,58,237,0.08);border-radius:8px;padding:16px 20px;border-left:3px solid #7c3aed;'><p style='margin:0;color:#64748b;font-size:13px;line-height:1.6;'>⏱&nbsp; Este enlace caduca en <strong style='color:#a5b4fc;'>${ $json.expires_hours } hora(s)</strong> desde que fue generado.</p></div></td></tr><tr><td style='padding:24px 48px;background:rgba(0,0,0,0.2);border-top:1px solid rgba(255,255,255,0.06);text-align:center;'><p style='margin:0 0 4px;color:#334155;font-size:12px;'>NeonHub</p><p style='margin:0;color:#334155;font-size:12px;'>Si no solicitaste este cambio, puedes ignorar este email de forma segura. Tu contraseña actual no se verá afectada.</p></td></tr></table></td></tr></table></body></html>`",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-300000000003",
      "name": "Send Email — Cambio Contraseña",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 180],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP NeonHub"
        }
      },
      "notes": "CREDENCIAL: Misma credencial 'SMTP NeonHub' usada en WF-A y WF-B."
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error",
              "value": "Payload inválido — faltan campos requeridos: email o change_url"
