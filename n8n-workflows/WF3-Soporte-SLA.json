      "main": [
        [
          {
            "node": "IF — ¿hay tickets críticos?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF — ¿hay tickets críticos?": {
      "main": [
        [
          {
            "node": "Slack — #cobros-fallidos",
            "type": "main",
            "index": 0
          },
          {
            "node": "Trello — Crear tarjeta",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
