{
  "name": "WF-ORDER-1 — Pedido Confirmado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-confirmed",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "or1a0001-0001-4000-8000-order00000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wh-or1a0001-order-confirmed-0001"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.customer_email }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.order_number }}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "or1a0001-0001-4000-8000-order00000002",
      "name": "IF — Validar Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ ($json.body.store_name || 'NeonHub') + ' <soporte@neonhub.es>' }}",
        "toEmail": "={{ $json.body.customer_email }}",
        "subject": "={{ 'Pedido confirmado — #' + $json.body.order_number }}",
        "emailType": "html",
        "message": "=`<!DOCTYPE html><html lang='es' xml:lang='es'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1.0'><meta http-equiv='Content-Language' content='es'><title>Pedido confirmado — #${ $json.body.order_number }</title></head><body style='margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#f1f5f9;'><tr><td align='center' style='padding:48px 20px;'><table width='600' cellpadding='0' cellspacing='0' border='0' style='max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);border:1px solid #e2e8f0;'><tr><td style='padding:44px 48px 40px;background:linear-gradient(135deg,#22c55e 0%,#16a34a 100%);text-align:center;'>${ $json.body.store_logo ? `<img src='${ $json.body.store_logo }' alt='${ $json.body.store_name }' style='max-width:120px;max-height:50px;margin-bottom:16px;display:block;margin-left:auto;margin-right:auto;border-radius:8px;'>` : `<div style='display:inline-block;width:52px;height:52px;background:rgba(255,255,255,0.25);border-radius:12px;margin-bottom:16px;line-height:52px;text-align:center;font-size:28px;'>✅</div>` }<h1 style='margin:0 0 6px;color:#ffffff;font-size:24px;font-weight:700;letter-spacing:-0.5px;'>${ $json.body.store_name || 'NeonHub' }</h1><p style='margin:0;color:rgba(255,255,255,0.85);font-size:14px;'>Confirmación de pedido</p></td></tr><tr><td style='padding:40px 48px 32px;'><p style='margin:0 0 16px;color:#475569;font-size:16px;line-height:1.75;'>Hola <strong style='color:#1e293b;'>${ $json.body.customer_name }</strong>,</p><p style='margin:0 0 28px;color:#475569;font-size:16px;line-height:1.75;'>Tu pedido <strong style='color:#16a34a;'>#${ $json.body.order_number }</strong> ha sido confirmado en <strong style='color:#1e293b;'>${ $json.body.store_name || 'NeonHub' }</strong>. Estamos procesándolo.</p><div style='background:#f8fafc;border-radius:12px;padding:20px 24px;margin-bottom:24px;border:1px solid #e2e8f0;'><p style='margin:0 0 12px;color:#64748b;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;'>Productos del pedido</p><table width='100%' cellpadding='0' cellspacing='0' border='0'><thead><tr><th style='text-align:left;padding:8px 12px;color:#64748b;font-size:12px;font-weight:600;text-transform:uppercase;border-bottom:1px solid #e2e8f0;'>Producto</th><th style='text-align:center;padding:8px 12px;color:#64748b;font-size:12px;font-weight:600;text-transform:uppercase;border-bottom:1px solid #e2e8f0;'>Cant.</th><th style='text-align:right;padding:8px 12px;color:#64748b;font-size:12px;font-weight:600;text-transform:uppercase;border-bottom:1px solid #e2e8f0;'>Precio</th></tr></thead><tbody>${ $json.body.items && $json.body.items.length > 0 ? $json.body.items.map(function(i){ return '<tr><td style=\"padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#475569;font-size:14px;\">' + i.name + '</td><td style=\"padding:8px 12px;border-bottom:1px solid #e2e8f0;text-align:center;color:#475569;font-size:14px;\">' + i.quantity + '</td><td style=\"padding:8px 12px;border-bottom:1px solid #e2e8f0;text-align:right;color:#1e293b;font-size:14px;font-weight:600;\">€' + i.price + '</td></tr>'; }).join('') : '<tr><td colspan=\"3\" style=\"padding:8px 12px;color:#94a3b8;\">Sin artículos</td></tr>' }<tr><td colspan='2' style='padding:12px 12px 0;text-align:right;color:#64748b;font-size:13px;font-weight:600;text-transform:uppercase;'>Total</td><td style='padding:12px 12px 0;text-align:right;color:#16a34a;font-size:16px;font-weight:700;'>€${ Number($json.body.total).toFixed(2) }</td></tr></tbody></table></div><div style='background:#f8fafc;border-radius:10px;padding:18px 24px;margin-bottom:28px;border:1px solid #e2e8f0;'><p style='margin:0 0 8px;color:#64748b;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;'>Dirección de envío</p><p style='margin:0;color:#475569;font-size:14px;line-height:1.7;'>${ $json.body.shipping_address ? (($json.body.shipping_address.street || '') + ', ' + ($json.body.shipping_address.city || '') + ', ' + ($json.body.shipping_address.zip || '') + ', ' + ($json.body.shipping_address.country || '')) : 'Sin dirección' }</p></div></td></tr><tr><td style='padding:20px 48px;background:#f8fafc;border-top:1px solid #e2e8f0;text-align:center;'><p style='margin:0 0 4px;color:#94a3b8;font-size:12px;'>Enviado por NeonHub en nombre de ${ $json.body.store_name || 'NeonHub' }</p><p style='margin:0;color:#cbd5e1;font-size:12px;'>Si tienes dudas, contáctanos en soporte@neonhub.es</p></td></tr></table></td></tr></table></body></html>`",
        "options": {}
      },
      "id": "or1a0001-0001-4000-8000-order00000003",
      "name": "Send Email — Pedido Confirmado",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 180],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP NeonHub"
        }
      },
      "notes": "CREDENCIAL: Misma credencial 'SMTP NeonHub' usada en WF-A, WF-B y WF-C."
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error",
              "value": "Payload inválido — faltan campos requeridos: customer_email o order_number"
            },
            {
              "name": "payload_recibido",
              "value": "={{ JSON.stringify($json.body) }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "or1a0001-0001-4000-8000-order00000004",
      "name": "Set — Error Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "IF — Validar Payload", "type": "main", "index": 0 }]]
    },
    "IF — Validar Payload": {
      "main": [
        [{ "node": "Send Email — Pedido Confirmado", "type": "main", "index": 0 }],
        [{ "node": "Set — Error Payload", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "neonhub-wf-order1-confirmed-v2",
  "meta": { "templateCredsSetupCompleted": false, "instanceId": "neonhub-n8n" },
  "tags": [{ "name": "NeonHub" }, { "name": "Orders" }],
  "_readme": {
    "workflow": "WF-ORDER-1 — Pedido Confirmado",
    "trigger": "POST https://neonhub75482.n8nservidor.es/webhook/order-confirmed",
    "credencial_smtp": "Misma credencial 'SMTP NeonHub' usada en WF-A, WF-B y WF-C.",
    "estado": "INACTIVE — Revisar y activar manualmente",
    "nota_webhook": "Usa typeVersion 2 — las variables están bajo $json.body.*",
    "payload_esperado": {
      "order_id": "uuid", "order_number": "ORD-001",
      "customer_email": "cliente@gmail.com", "customer_name": "Sergio Bernal",
      "store_name": "NeonLabs", "store_subdomain": "neonlabs",
      "store_logo": "https://neonlabs.neonhub.es/logo.png", "total": 199.99,
      "items": [{ "name": "Producto X", "quantity": 2, "price": 99.99 }],
      "shipping_address": { "street": "Calle Mayor 1", "city": "Valencia", "zip": "46001", "country": "España" },
      "type": "order_confirmed"
    }
  }
}
