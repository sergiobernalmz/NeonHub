---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.astro';

const token = Astro.url.searchParams.get('token') || '';
let result: { success: boolean; message: string } | null = null;

if (token) {
  const BACKEND = (import.meta.env.PUBLIC_API_BASE_URL || 'http://127.0.0.1:4000/api').replace(/\/$/, '');
  try {
    const r = await fetch(`${BACKEND}/auth/unlock-account`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token })
    });
    result = await r.json();
  } catch {
    result = { success: false, message: 'Error al conectar con el servidor. Inténtalo de nuevo.' };
  }
}
---

<Layout title="Desbloquear cuenta - NeonHub">
  <Navbar client:load />
  <main class="min-h-screen flex flex-col items-center justify-center bg-white dark:bg-slate-950 px-4 py-24">
    <div class="bg-white dark:bg-white/10 border border-gray-200 dark:border-white/10 rounded-2xl p-8 max-w-md w-full text-center">

      {!token ? (
        <div>
          <div class="text-5xl mb-4">🔒</div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Enlace inválido</h1>
          <p class="text-gray-500 dark:text-slate-400 text-sm">
            Este enlace de desbloqueo no es válido. Solicita uno nuevo iniciando sesión.
          </p>
          <a href="/login" class="mt-6 inline-block px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">
            Ir al login
          </a>
        </div>
      ) : result?.success ? (
        <div>
          <div class="text-5xl mb-4">✅</div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Cuenta desbloqueada</h1>
          <p class="text-gray-500 dark:text-slate-400 text-sm mb-6">
            {result.message}
          </p>
          <a href="/login" class="inline-block px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">
            Iniciar sesión
          </a>
        </div>
      ) : (
        <div>
          <div class="text-5xl mb-4">❌</div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Token inválido o expirado</h1>
          <p class="text-gray-500 dark:text-slate-400 text-sm mb-6">
            {result?.message || 'El enlace de desbloqueo ha expirado o ya fue usado. Inicia sesión para recibir uno nuevo.'}
          </p>
          <a href="/login" class="inline-block px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">
            Ir al login
          </a>
        </div>
      )}

    </div>
  </main>
  <Footer />
</Layout>
