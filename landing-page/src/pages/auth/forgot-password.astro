---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.astro';
import ForgotPasswordForm from '../../components/ForgotPasswordForm.jsx';
---

<Layout title="Recuperar contraseña - NeonHub">
  <Navbar client:load />
  <main class="min-h-screen flex flex-col items-center justify-center bg-white dark:bg-slate-950 px-4 py-24">
    <div class="bg-white dark:bg-white/10 border border-gray-200 dark:border-white/10 rounded-2xl p-8 max-w-md w-full">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 text-center">¿Olvidaste tu contraseña?</h1>
      <p class="text-gray-500 dark:text-slate-400 text-sm text-center mb-8">
        Introduce tu email y te enviaremos un enlace para restablecerla.
      </p>
      <ForgotPasswordForm client:load />
    </div>
  </main>
  <Footer />
</Layout>
