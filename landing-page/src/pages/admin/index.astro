    <!-- Lead Delete Confirmation Modal -->
    <div id="lead-delete-modal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
        <div class="bg-gray-50 dark:bg-slate-900 border border-red-500/30 rounded-2xl p-6 w-full max-w-md">
            <h3 class="text-xl font-bold text-red-400 mb-1">⚠️ Eliminar lead</h3>
            <p class="text-xs text-gray-400 dark:text-slate-500 mb-4">Esta acción no se puede deshacer.</p>
            <p id="ldm-body" class="text-sm text-gray-600 dark:text-slate-300 mb-6"></p>
            <div class="flex gap-3 justify-end">
                <button id="ldm-cancel" class="px-4 py-2 bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:bg-white/10 text-gray-600 dark:text-slate-300 rounded-lg text-sm transition-colors border border-gray-200 dark:border-white/10">
                    Cancelar
                </button>
                <button id="ldm-confirm" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-colors">
                    Eliminar permanentemente
                </button>
            </div>
        </div>
    </div>

    <!-- Generated Password Modal -->
    <div id="pwd-modal" class="hidden fixed inset-0 z-[70] bg-black/70 flex items-center justify-center p-4">
        <div class="bg-gray-50 dark:bg-slate-900 border border-violet-500/30 rounded-2xl p-6 w-full max-w-md">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white">🔑 Contraseña generada</h3>
                <button id="pwd-modal-close" class="text-gray-400 hover:text-white transition-colors text-xl leading-none">&times;</button>
            </div>
            <p class="text-sm text-gray-400 dark:text-slate-400 mb-4">
                Esta es la contraseña inicial del propietario. <span class="text-yellow-400 font-medium">Guárdala ahora</span> — no volverá a mostrarse.
