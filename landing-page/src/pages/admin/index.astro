      if (!extendTrialStoreId) return;
      const daysEl = document.getElementById('et-days') as HTMLInputElement;
      const days = parseInt(daysEl?.value || '0');
      if (!days || days < 1) { showToast('Introduce un número de días válido', 'error'); return; }

