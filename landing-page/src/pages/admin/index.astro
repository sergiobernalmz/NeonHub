  // modal de confirmación de borrado de tienda
  let _sdmResolve: ((confirmed: boolean) => void) | null = null;

  function openStoreDeleteModal(storeName: string, userCount: number, orderCount: number): Promise<boolean> {
      return new Promise(resolve => {
          _sdmResolve = resolve;

          (document.getElementById('sdm-store-name') as HTMLElement).textContent = storeName;

          const body = document.getElementById('sdm-body') as HTMLElement;
          body.innerHTML = '';

          if (userCount > 0) {
              const p1 = document.createElement('p');
              p1.textContent = `Esta tienda tiene ${userCount} usuario${userCount !== 1 ? 's' : ''} registrado${userCount !== 1 ? 's' : ''}. Al eliminarla, perderán el acceso y todos sus datos serán borrados permanentemente.`;
              body.appendChild(p1);
          } else {
              const p1 = document.createElement('p');
              p1.textContent = 'Esta acción eliminará permanentemente la tienda y todos sus datos.';
              body.appendChild(p1);
          }

          if (orderCount > 0) {
              const p2 = document.createElement('p');
              p2.className = 'text-yellow-400/80';
              p2.textContent = `Tiene ${orderCount} pedido${orderCount !== 1 ? 's' : ''} que también ${orderCount !== 1 ? 'serán eliminados' : 'será eliminado'}.`;
              body.appendChild(p2);
          }

          document.getElementById('store-delete-modal')!.classList.remove('hidden');
      });
  }

  document.getElementById('sdm-cancel')?.addEventListener('click', () => {
      document.getElementById('store-delete-modal')!.classList.add('hidden');
      _sdmResolve?.(false);
      _sdmResolve = null;
  });

  document.getElementById('sdm-confirm')?.addEventListener('click', () => {
      document.getElementById('store-delete-modal')!.classList.add('hidden');
      _sdmResolve?.(true);
      _sdmResolve = null;
  });

  // modal de confirmación genérico — sustituye a los confirm() nativos del panel.
// Devuelve Promise<boolean>: true si el usuario confirma, false si cancela.
  let _gcmResolve: ((confirmed: boolean) => void) | null = null;

  const GCM_THEMES: Record<string, { btn: string; border: string; title: string }> = {
      red:    { btn: 'bg-red-600 hover:bg-red-700',      border: 'border-red-500/30',    title: 'text-red-400' },
      yellow: { btn: 'bg-yellow-500 hover:bg-yellow-600',  border: 'border-yellow-500/30', title: 'text-yellow-400' },
      green:  { btn: 'bg-green-600 hover:bg-green-700',    border: 'border-green-500/30',  title: 'text-green-400' }
  };

  function openConfirmModal(title: string, message: string, confirmLabel: string, theme: keyof typeof GCM_THEMES = 'red'): Promise<boolean> {
      return new Promise(resolve => {
          _gcmResolve = resolve;

          const t = GCM_THEMES[theme] || GCM_THEMES.red;
          const titleEl = document.getElementById('gcm-title') as HTMLElement;
          const msgEl = document.getElementById('gcm-message') as HTMLElement;
          const btn = document.getElementById('gcm-confirm') as HTMLButtonElement;
          const card = document.querySelector('#generic-confirm-modal > div') as HTMLElement;

          titleEl.textContent = title;
          titleEl.className = `text-xl font-bold mb-2 ${t.title}`;
          msgEl.textContent = message;
          btn.textContent = confirmLabel;
          btn.className = `px-4 py-2 text-white rounded-lg text-sm font-medium transition-colors ${t.btn}`;
          card.className = `bg-gray-50 dark:bg-slate-900 border rounded-2xl p-6 w-full max-w-md ${t.border}`;

          document.getElementById('generic-confirm-modal')!.classList.remove('hidden');
      });
  }

  document.getElementById('gcm-cancel')?.addEventListener('click', () => {
      document.getElementById('generic-confirm-modal')!.classList.add('hidden');
      _gcmResolve?.(false);
      _gcmResolve = null;
  });

  document.getElementById('gcm-confirm')?.addEventListener('click', () => {
      document.getElementById('generic-confirm-modal')!.classList.add('hidden');
      _gcmResolve?.(true);
      _gcmResolve = null;
  });

  // cerrar con Escape o clic en el fondo
  document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
          const modal = document.getElementById('generic-confirm-modal') as HTMLElement;
          if (modal && !modal.classList.contains('hidden')) {
              modal.classList.add('hidden');
              _gcmResolve?.(false);
              _gcmResolve = null;
          }
      }
  });

  document.getElementById('generic-confirm-modal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
          (e.currentTarget as HTMLElement).classList.add('hidden');
          _gcmResolve?.(false);
          _gcmResolve = null;
      }
  });

  // acciones de tienda (activar/desactivar, pausar, borrar)
  document.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const action = target.dataset.action;
          const storeId = target.dataset.id;
          const storeName = target.dataset.name || 'esta tienda';
          if (!action || !storeId) return;

          const labels: Record<string, string> = {
              toggle: target.textContent?.trim() === 'Desactivar' ? 'desactivar' : 'activar',
              pause: target.textContent?.trim() === 'Reactivar' ? 'reactivar' : 'pausar',
              delete: 'eliminar permanentemente'
          };
          const label = labels[action] || action;

if (action === 'delete') {
               const userCount = parseInt(target.dataset.userCount || '0');
               const orderCount = parseInt(target.dataset.orderCount || '0');
               const confirmed = await openStoreDeleteModal(storeName, userCount, orderCount);
               if (!confirmed) return;
           } else {
               const isDesactivating = action === 'toggle' && target.textContent?.trim() === 'Desactivar';
               const isPausing = action === 'pause' && target.textContent?.trim() === 'Pausar';
               const theme = (isDesactivating || isPausing) ? 'yellow' : 'green';
               const confirmLabel = isDesactivating ? 'Desactivar' : isPausing ? 'Pausar' : (action === 'pause' ? 'Reactivar' : 'Activar');
               const confirmed = await openConfirmModal(
                   `${confirmLabel} "${storeName}"`,
                   isDesactivating
                       ? 'La tienda dejará de estar accesible y sus clientes no podrán entrar. Podrás reactivarla cuando quieras.'
                       : isPausing
                           ? 'La tienda quedará pausada y no aceptará pedidos hasta que la reanudes.'
                           : `Se va a ${label} la tienda "${storeName}".`,
                   confirmLabel,
                   theme
               );
               if (!confirmed) return;
           }

          target.disabled = true;
          const original = target.textContent || '';
          target.textContent = '...';

          try {
              const res = await fetch('/api/admin/stores/action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action, storeId })
              });
              const data = await res.json();
              if (data.success) {
                  showToast(data.message || `"${storeName}" ${label} correctamente`);
                  setTimeout(() => window.location.reload(), 800);
              } else {
                  showToast(data.message || `Error al ${label}`, 'error');
                  target.disabled = false;
                  target.textContent = original;
              }
          } catch {
              showToast('Error de conexión', 'error');
              target.disabled = false;
              target.textContent = original;
          }
      });
  });

