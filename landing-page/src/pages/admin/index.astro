  // Entrar a una tienda como superadmin de plataforma.
  // Genera un token SSO de un solo uso (30s) y abre la tienda en pestana nueva
  // con la sesion ya iniciada. El token lo consume el frontend de la tienda al
  // cargar /admin?sso=... y se descarta de la URL.
  document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.sso-store-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const subdomain = btn.dataset.subdomain;
      if (!subdomain) return;

      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Conectando...';
      // Se abre la pestana de forma sincronica (dentro del gesto del usuario) para
      // que el popup blocker no la bloquee, y luego se le asigna la URL real.
      const win = window.open('', '_blank');
      if (win) win.document.write('<p style="font-family:sans-serif;padding:2rem">Conectando con la tienda...</p>');
      try {
          const res = await fetch('/api/sso-redirect', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ subdomain })
          });
          const data = await res.json();
          if (data.success && data.redirect_url) {
              if (win) {
                  win.location.href = data.redirect_url;
              } else {
                  window.location.href = data.redirect_url;
              }
              btn.textContent = 'Abierto en pestana nueva ✓';
          } else {
              win?.close();
              alert(data.message || 'No se pudo conectar con la tienda.');
              btn.disabled = false;
              btn.textContent = original;
          }
      } catch {
          win?.close();
          alert('Error de conexion. Intentalo de nuevo.');
          btn.disabled = false;
          btn.textContent = original;
      }
  });

  // comprobamos pagos vencidos
  document.getElementById('btn-check-overdue')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Comprobando...';
      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'check-overdue' })
          });
          const data = await res.json();
          if (!data.success) {
              showToast(data.message || 'Error al comprobar impagos', 'error');
              return;
          }
          const result = data.data || data;
          const overdueCount = result.overdueCount || 0;

          // Show detailed results in a modal
          const allOverdue = [
              ...(result.newOverdue || []).map((s: any) => ({ ...s, tag: 'Nuevo' })),
              ...(result.existingOverdue || []).map((s: any) => ({ ...s, tag: 'Existente' })),
              ...(result.suspended || []).map((s: any) => ({ ...s, tag: 'Suspendida' }))
          ];

          let modalHtml = `<div id="overdue-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
              <div class="bg-gray-800 rounded-2xl border border-gray-700 w-full max-w-2xl max-h-[80vh] overflow-hidden flex flex-col">
                  <div class="flex items-center justify-between p-6 border-b border-gray-700">
                      <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Resultado de Comprobación de Impagos</h2>
                      <button id="close-overdue-modal" class="text-gray-400 hover:text-gray-900 dark:text-white text-2xl">✕</button>
                  </div>
                  <div class="flex-1 overflow-auto p-6">`;

          if (overdueCount === 0) {
              modalHtml += `<div class="text-center py-8">
                  <p class="text-green-400 text-lg font-medium">✅ No hay tiendas con impagos</p>
                  <p class="text-gray-500 dark:text-slate-400 text-sm mt-2">Todas las tiendas están al día con sus pagos.</p>
              </div>`;
          } else {
              modalHtml += `<div class="mb-4 p-4 rounded-xl bg-red-500/10 border border-red-500/20">
                  <p class="text-red-400 font-medium">⚠️ ${result.summary}</p>
              </div>
              <table class="w-full text-left border-collapse">
                  <thead><tr class="border-b border-gray-200 dark:border-white/10">
                      <th class="py-3 px-3 text-gray-500 dark:text-slate-400 text-xs font-medium">Tienda</th>
                      <th class="py-3 px-3 text-gray-500 dark:text-slate-400 text-xs font-medium">Plan</th>
                      <th class="py-3 px-3 text-gray-500 dark:text-slate-400 text-xs font-medium">Importe</th>
                      <th class="py-3 px-3 text-gray-500 dark:text-slate-400 text-xs font-medium">Días vencido</th>
                      <th class="py-3 px-3 text-gray-500 dark:text-slate-400 text-xs font-medium">Estado</th>
                  </tr></thead><tbody class="divide-y divide-white/5">`;

              for (const s of allOverdue) {
                  const tagColor = s.tag === 'Suspendida' ? 'bg-red-500/10 text-red-400 border-red-500/20'
                      : s.tag === 'Nuevo' ? 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
                      : 'bg-orange-500/10 text-orange-400 border-orange-500/20';
                  modalHtml += `<tr class="hover:bg-gray-100 dark:hover:bg-white/10">
                      <td class="py-3 px-3"><p class="text-gray-900 dark:text-white text-sm font-medium">${escapeHtml(s.name)}</p><p class="text-xs text-gray-500 dark:text-slate-400">${escapeHtml(s.subdomain)}.neonhub.es</p></td>
                      <td class="py-3 px-3 text-gray-600 dark:text-slate-300 text-sm">${escapeHtml(s.plan_id || '—')}</td>
                      <td class="py-3 px-3 text-gray-900 dark:text-white text-sm font-medium">${s.amount} €</td>
                      <td class="py-3 px-3 text-red-400 text-sm font-medium">${s.days_past_due} días</td>
                      <td class="py-3 px-3"><span class="px-2 py-1 rounded-full text-xs font-medium border ${tagColor}">${s.tag}</span></td>
                  </tr>`;
              }
              modalHtml += `</tbody></table>`;
          }

          modalHtml += `</div></div></div>`;

          document.body.insertAdjacentHTML('beforeend', modalHtml);
          document.getElementById('close-overdue-modal')?.addEventListener('click', () => {
              document.getElementById('overdue-modal')?.remove();
          });
          document.getElementById('overdue-modal')?.addEventListener('click', (ev) => {
              if ((ev.target as HTMLElement).id === 'overdue-modal') {
                  document.getElementById('overdue-modal')?.remove();
              }
          });

      } catch {
          showToast('Error comprobando impagos', 'error');
      } finally {
          btn.disabled = false;
          btn.textContent = 'Comprobar Impagos';
      }
  });

