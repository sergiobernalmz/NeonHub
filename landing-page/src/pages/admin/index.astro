              setTimeout(() => {
                  document.getElementById('extend-trial-modal')?.classList.add('hidden');
                  extendTrialStoreId = null;
                  window.location.reload();
              }, 1800);
          } else {
              showToast(data.message || 'Error al extender el trial', 'error');
              saveBtn.disabled = false;
              saveBtn.textContent = 'Extender Trial';
