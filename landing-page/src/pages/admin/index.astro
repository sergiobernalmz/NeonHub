  let typingTimeout: ReturnType<typeof setTimeout> | null = null;

  // Socket.IO connection
  const socket = io(window.location.origin, {
      path: '/socket.io',
      transports: ['websocket', 'polling']
  });

  socket.on('connect', () => {
      console.log('🔌 Socket.IO conectado:', socket.id);
  });

  async function ticketAction(action: string, payload: Record<string, any> = {}) {
      const res = await fetch('/api/admin/tickets/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, ...payload })
      });
      return await res.json();
  }

  function renderMessages(ticket: any) {
      const container = document.getElementById('ticket-messages');
      if (!container) return;
      container.innerHTML = '';
      currentCustomerEmail = ticket.customer_email;

      // Original message
      const origDiv = document.createElement('div');
      origDiv.className = 'flex flex-col items-start';
      origDiv.innerHTML = `
          <div class="bg-gray-100 dark:bg-slate-800 border border-slate-700 rounded-2xl rounded-tl-sm p-4 max-w-[85%]">
              <p class="text-sm text-violet-300 mb-1 font-medium">${escapeHtml(ticket.customer_email)} (Mensaje Inicial)</p>
              <p class="text-gray-900 dark:text-white whitespace-pre-wrap text-sm">${escapeHtml(ticket.message)}</p>
              <p class="text-[10px] text-gray-400 dark:text-slate-500 mt-2">${new Date(ticket.created_at || ticket.createdAt).toLocaleString('es-ES')}</p>
          </div>
      `;
      container.appendChild(origDiv);

      // Responses
      const responses = ticket.responses || [];
      responses.forEach((reply: any) => {
          const isAdmin = reply.sender === 'admin';
          const readStatus = isAdmin
              ? `<p class="admin-message-status text-[10px] mt-1 ${ticket.read_by_customer ? 'text-violet-400' : 'text-gray-400 dark:text-slate-500'}">${ticket.read_by_customer ? '✓✓ Leído' : '✓ Enviado'}</p>`
              : '';
          const div = document.createElement('div');
          div.id = reply.id ? `reply-${reply.id}` : '';
          div.className = `flex flex-col ${isAdmin ? 'items-end' : 'items-start'}`;
          div.innerHTML = `
              <div class="${isAdmin
                  ? 'bg-violet-600/20 border border-violet-500/30 rounded-2xl rounded-tr-sm'
                  : 'bg-gray-100 dark:bg-slate-800 border border-slate-700 rounded-2xl rounded-tl-sm'
              } p-4 max-w-[85%]">
                  <p class="text-sm mb-1 font-medium ${isAdmin ? 'text-violet-300' : 'text-amber-400'}">${isAdmin ? 'Admin' : escapeHtml(ticket.customer_email)}</p>
                  <p class="text-gray-900 dark:text-white whitespace-pre-wrap text-sm">${escapeHtml(reply.message)}</p>
                  <p class="text-[10px] text-gray-400 dark:text-slate-500 mt-2">${reply.timestamp ? new Date(reply.timestamp).toLocaleString('es-ES') : ''}</p>
                  ${readStatus}
              </div>
          `;
          container.appendChild(div);
      });

      container.scrollTop = container.scrollHeight;
  }

  function appendMessage(reply: any, customerEmail: string) {
      const container = document.getElementById('ticket-messages');
      if (!container) return;
      if (reply.id && document.getElementById(`reply-${reply.id}`)) return; // deduplicate

      const isAdmin = reply.sender === 'admin';
      const readStatus = isAdmin
          ? `<p class="admin-message-status text-[10px] mt-1 text-gray-400 dark:text-slate-500">✓ Enviado</p>`
          : '';
      const div = document.createElement('div');
      if (reply.id) div.id = `reply-${reply.id}`;
      div.className = `flex flex-col ${isAdmin ? 'items-end' : 'items-start'}`;
      div.innerHTML = `
          <div class="${isAdmin
              ? 'bg-violet-600/20 border border-violet-500/30 rounded-2xl rounded-tr-sm'
              : 'bg-gray-100 dark:bg-slate-800 border border-slate-700 rounded-2xl rounded-tl-sm'
          } p-4 max-w-[85%]">
              <p class="text-sm mb-1 font-medium ${isAdmin ? 'text-violet-300' : 'text-amber-400'}">${isAdmin ? 'Admin' : escapeHtml(customerEmail)}</p>
              <p class="text-gray-900 dark:text-white whitespace-pre-wrap text-sm">${escapeHtml(reply.message)}</p>
              <p class="text-[10px] text-gray-400 dark:text-slate-500 mt-2">${reply.timestamp ? new Date(reply.timestamp).toLocaleString('es-ES') : ''}</p>
              ${readStatus}
          </div>
      `;
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
  }

  function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
  }

  async function selectTicket(ticketId: string) {
      // Leave previous ticket room
      if (currentTicketId) {
          socket.emit('ticket:leave', { ticketId: currentTicketId, role: 'admin' });
      }
      currentTicketId = ticketId;

      // nos unimos a la sala del nuevo ticket
      socket.emit('ticket:join', { ticketId, role: 'admin' });
      socket.emit('ticket:mark-read', { ticketId, role: 'admin' });

      // Reset indicators
      document.getElementById('customer-online-dot')?.classList.add('hidden');
      document.getElementById('typing-indicator')?.classList.add('hidden');

      // Highlight selected in list
      document.querySelectorAll('.ticket-item').forEach(el => {
          el.classList.remove('bg-violet-600/20', 'border-violet-500/50');
          el.classList.add('bg-black/20', 'border-white/10');
      });
      const selected = document.querySelector(`.ticket-item[data-ticket-id="${ticketId}"]`);
      if (selected) {
          selected.classList.remove('bg-black/20', 'border-white/10');
          selected.classList.add('bg-violet-600/20', 'border-violet-500/50');
          const dot = selected.querySelector('.bg-violet-500.rounded-full');
          if (dot) dot.remove();
          selected.classList.remove('ring-1', 'ring-violet-500/50');
      }

      // Show detail panel
      document.getElementById('ticket-empty-state')?.classList.add('hidden');
      const content = document.getElementById('ticket-detail-content');
      content?.classList.remove('hidden');

      // cargamos los detalles
      try {
          const result = await ticketAction('details', { ticketId });
          if (result.success) {
              const ticket = result.data;
              const subjectEl = document.getElementById('ticket-subject');
              const emailEl = document.getElementById('ticket-email');
              const idEl = document.getElementById('ticket-id-display');
              const statusSelect = document.getElementById('ticket-status-select') as HTMLSelectElement;

              if (subjectEl) subjectEl.textContent = ticket.subject;
              if (emailEl) emailEl.textContent = ticket.customer_email;
              if (idEl) idEl.textContent = `ID: ${ticket.id}`;
              if (statusSelect) statusSelect.value = ticket.status;

              renderMessages(ticket);
          } else {
              showToast('Error cargando ticket', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      }
  }

  // ── Socket.IO Event Handlers ──

  // Customer presence (online/offline indicator)
  socket.on('ticket:presence', ({ ticketId, role, online }: { ticketId: string; role: string; online: boolean }) => {
      if (ticketId === currentTicketId && role === 'customer') {
          const dot = document.getElementById('customer-online-dot');
          if (dot) dot.classList.toggle('hidden', !online);
      }
  });

  // indicador de escritura del cliente
  socket.on('ticket:typing', ({ ticketId, sender }: { ticketId: string; sender: string }) => {
      if (ticketId === currentTicketId && sender !== 'admin') {
          document.getElementById('typing-indicator')?.classList.remove('hidden');
      }
  });

  socket.on('ticket:stop-typing', ({ ticketId, sender }: { ticketId: string; sender: string }) => {
      if (ticketId === currentTicketId && sender !== 'admin') {
          document.getElementById('typing-indicator')?.classList.add('hidden');
      }
  });

  // confirmación de lectura del cliente
  socket.on('ticket:read', ({ ticketId, role }: { ticketId: string; role: string }) => {
      if (ticketId === currentTicketId && role === 'customer') {
          document.querySelectorAll('.admin-message-status').forEach(el => {
              el.textContent = '✓✓ Leído';
              el.classList.remove('text-slate-500');
              el.classList.add('text-violet-400');
          });
      }
  });

  // nueva respuesta recibida en tiempo real
  socket.on('ticket:new-reply', ({ ticketId, reply }: { ticketId: string; reply: any }) => {
      if (ticketId === currentTicketId) {
          // Append message to current conversation
          appendMessage(reply, currentCustomerEmail);
          // Hide typing indicator
          document.getElementById('typing-indicator')?.classList.add('hidden');
          // Mark as read since admin has it open
          socket.emit('ticket:mark-read', { ticketId, role: 'admin' });
      } else {
          // Highlight unread in ticket list
          const listItem = document.querySelector(`.ticket-item[data-ticket-id="${ticketId}"]`);
          if (listItem) {
              if (!listItem.querySelector('.bg-violet-500.rounded-full')) {
                  const titleDiv = listItem.querySelector('.flex.justify-between');
                  if (titleDiv) {
                      const dot = document.createElement('span');
                      dot.className = 'ml-2 w-2 h-2 bg-violet-500 rounded-full flex-shrink-0 mt-1.5';
                      titleDiv.appendChild(dot);
                  }
              }
              listItem.classList.add('ring-1', 'ring-violet-500/50');
          }
      }
  });

  // Status changed in real-time
  socket.on('ticket:status-changed', ({ ticketId, status }: { ticketId: string; status: string }) => {
      const listItem = document.querySelector(`.ticket-item[data-ticket-id="${ticketId}"]`);
      if (listItem) {
          const badge = listItem.querySelector('span[class*="rounded-full"][class*="text-\\[10px\\]"]');
          if (badge) {
              const colors: Record<string, string> = {
                  open: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
                  in_progress: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
                  resolved: 'bg-green-500/10 text-green-400 border-green-500/20'
              };
              const labels: Record<string, string> = { open: 'Abierto', in_progress: 'En Progreso', resolved: 'Resuelto' };
              badge.className = `px-2 py-0.5 ${colors[status]} text-[10px] rounded-full border font-medium`;
              badge.textContent = labels[status];
          }
      }
      if (ticketId === currentTicketId) {
          const statusSelect = document.getElementById('ticket-status-select') as HTMLSelectElement;
          if (statusSelect) statusSelect.value = status;
      }
  });

  // nuevo ticket creado (lo añadimos a la lista)
  socket.on('ticket:new', ({ ticket }: { ticket: any }) => {
      const listPanel = document.getElementById('ticket-list-panel');
      if (!listPanel) return;
      const emptyState = listPanel.querySelector('.text-center.text-gray-500 dark:text-slate-400');
      if (emptyState) emptyState.remove();

      const statusBadge = '<span class="px-2 py-0.5 bg-yellow-500/10 text-yellow-400 text-[10px] rounded-full border border-yellow-500/20 font-medium">Abierto</span>';
      const priorityBadge = ticket.priority === 'urgent'
          ? '<span class="px-2 py-0.5 bg-red-500/10 text-red-400 text-[10px] rounded-full border border-red-500/20 font-medium">Urgente</span>'
          : ticket.priority === 'high'
              ? '<span class="px-2 py-0.5 bg-orange-500/10 text-orange-400 text-[10px] rounded-full border border-orange-500/20 font-medium">Alta</span>'
              : '';

      const btn = document.createElement('button');
      btn.className = 'ticket-item w-full text-left p-4 rounded-xl border transition-all bg-gray-100 dark:bg-black/20 border-gray-200 dark:border-white/10 hover:border-gray-300 dark:border-white/20 ring-1 ring-violet-500/50';
      btn.dataset.ticketId = ticket.id;
      btn.innerHTML = `
          <div class="flex justify-between items-start mb-1">
              <h3 class="font-medium text-gray-900 dark:text-white line-clamp-1 text-sm">${escapeHtml(ticket.subject)}</h3>
              <span class="ml-2 w-2 h-2 bg-violet-500 rounded-full flex-shrink-0 mt-1.5"></span>
          </div>
          <p class="text-xs text-gray-500 dark:text-slate-400 line-clamp-1 mb-2">${escapeHtml(ticket.customer_email)}</p>
          <div class="flex items-center justify-between">
              ${statusBadge}
              <div class="flex items-center gap-2">
                  ${priorityBadge}
                  <span class="text-[10px] text-gray-400 dark:text-slate-500">${new Date(ticket.created_at || ticket.createdAt).toLocaleDateString('es-ES')}</span>
              </div>
          </div>
      `;
      btn.addEventListener('click', () => selectTicket(ticket.id));
      listPanel.prepend(btn);

      // actualizamos el contador de tickets en la pestaña
      const ticketTabBtn = document.querySelector('[data-tab="tickets"]');
      if (ticketTabBtn) {
          const currentCount = parseInt(ticketTabBtn.textContent?.match(/\d+/)?.[0] || '0');
          ticketTabBtn.childNodes[0].textContent = `Tickets (${currentCount + 1})`;
      }
  });

  // ── Click on ticket item ──
  document.querySelectorAll('.ticket-item').forEach(btn => {
      btn.addEventListener('click', () => {
          const ticketId = (btn as HTMLElement).dataset.ticketId;
          if (ticketId) selectTicket(ticketId);
      });
  });

  // ── Status change ──
  document.getElementById('ticket-status-select')?.addEventListener('change', async (e) => {
      if (!currentTicketId) return;
      const status = (e.target as HTMLSelectElement).value;
      try {
          const result = await ticketAction('status', { ticketId: currentTicketId, status });
          if (result.success) {
              showToast(`Estado cambiado a ${status === 'open' ? 'Abierto' : status === 'in_progress' ? 'En Progreso' : 'Resuelto'}`);
          } else {
              showToast(result.message || 'Error cambiando estado', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      }
  });

  // ── Admin reply ──
  const adminReplyInput = document.getElementById('admin-reply-input') as HTMLInputElement;

  // Typing indicator emit
  adminReplyInput?.addEventListener('input', () => {
      if (!currentTicketId) return;
      if (!isTyping) {
          isTyping = true;
          socket.emit('ticket:typing', { ticketId: currentTicketId, sender: 'admin' });
      }
      if (typingTimeout) clearTimeout(typingTimeout);
      typingTimeout = setTimeout(() => {
          isTyping = false;
          socket.emit('ticket:stop-typing', { ticketId: currentTicketId, sender: 'admin' });
      }, 2000);
  });

  document.getElementById('admin-reply-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentTicketId) return;

      const input = adminReplyInput;
      const btn = document.getElementById('admin-reply-btn') as HTMLButtonElement;
      const message = input.value.trim();
      if (!message) return;

      btn.disabled = true;
      btn.textContent = '...';

      // Stop typing
      if (isTyping) {
          isTyping = false;
          socket.emit('ticket:stop-typing', { ticketId: currentTicketId, sender: 'admin' });
          if (typingTimeout) clearTimeout(typingTimeout);
      }

      try {
          const result = await ticketAction('reply', { ticketId: currentTicketId, message });
          if (result.success) {
              input.value = '';
              // Append optimistically - socket event will be deduplicated by reply ID
              const ticket = result.data;
              const lastReply = ticket.responses?.[ticket.responses.length - 1];
              if (lastReply) appendMessage(lastReply, ticket.customer_email);
          } else {
              showToast(result.message || 'Error enviando respuesta', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      } finally {
          btn.disabled = false;
          btn.textContent = 'Enviar';
      }
  });

  // ── Filter tickets ──
  document.getElementById('ticket-filter')?.addEventListener('change', async (e) => {
      const statusFilter = (e.target as HTMLSelectElement).value;
      try {
          const result = await ticketAction('list', { statusFilter: statusFilter || undefined });
          if (result.success) {
              const listPanel = document.getElementById('ticket-list-panel');
              if (!listPanel) return;

              const tickets = result.data || [];
              if (tickets.length === 0) {
                  listPanel.innerHTML = '<div class="text-center py-8 text-gray-500 dark:text-slate-400">No hay tickets con ese filtro.</div>';
                  return;
              }

              listPanel.innerHTML = '';
              tickets.forEach((ticket: any) => {
                  const statusBadge = ticket.status === 'open'
                      ? '<span class="px-2 py-0.5 bg-yellow-500/10 text-yellow-400 text-[10px] rounded-full border border-yellow-500/20 font-medium">Abierto</span>'
                      : ticket.status === 'in_progress'
                          ? '<span class="px-2 py-0.5 bg-blue-500/10 text-blue-400 text-[10px] rounded-full border border-blue-500/20 font-medium">En Progreso</span>'
                          : '<span class="px-2 py-0.5 bg-green-500/10 text-green-400 text-[10px] rounded-full border border-green-500/20 font-medium">Resuelto</span>';

                  const priorityBadge = ticket.priority === 'urgent'
                      ? '<span class="px-2 py-0.5 bg-red-500/10 text-red-400 text-[10px] rounded-full border border-red-500/20 font-medium">Urgente</span>'
                      : ticket.priority === 'high'
                          ? '<span class="px-2 py-0.5 bg-orange-500/10 text-orange-400 text-[10px] rounded-full border border-orange-500/20 font-medium">Alta</span>'
                          : '';

                  const unreadDot = !ticket.read_by_admin
                      ? '<span class="ml-2 w-2 h-2 bg-violet-500 rounded-full flex-shrink-0 mt-1.5"></span>'
                      : '';

                  const btn = document.createElement('button');
                  btn.className = `ticket-item w-full text-left p-4 rounded-xl border transition-all bg-gray-100 dark:bg-black/20 border-gray-200 dark:border-white/10 hover:border-gray-300 dark:border-white/20 ${!ticket.read_by_admin ? 'ring-1 ring-violet-500/50' : ''}`;
                  btn.dataset.ticketId = ticket.id;
                  btn.innerHTML = `
                      <div class="flex justify-between items-start mb-1">
                          <h3 class="font-medium text-gray-900 dark:text-white line-clamp-1 text-sm">${escapeHtml(ticket.subject)}</h3>
                          ${unreadDot}
                      </div>
                      <p class="text-xs text-gray-500 dark:text-slate-400 line-clamp-1 mb-2">${escapeHtml(ticket.customer_email)}</p>
                      <div class="flex items-center justify-between">
                          ${statusBadge}
                          <div class="flex items-center gap-2">
                              ${priorityBadge}
                              <span class="text-[10px] text-gray-400 dark:text-slate-500">${new Date(ticket.created_at || ticket.createdAt).toLocaleDateString('es-ES')}</span>
                          </div>
                      </div>
                  `;
                  btn.addEventListener('click', () => selectTicket(ticket.id));
                  listPanel.appendChild(btn);
              });
          }
      } catch {
          showToast('Error filtrando tickets', 'error');
      }
  });

  // Refresh tickets
  document.getElementById('btn-refresh-tickets')?.addEventListener('click', () => window.location.reload());

  // ═══════════════════════════════════════════════
  // ── User modal — real-time validation helpers ─────────────────────────────────
  function ufSetError(errId: string, inpId: string, msg: string) {
      const errEl = document.getElementById(errId)!;
      const inp = document.getElementById(inpId) as HTMLInputElement;
      errEl.textContent = msg;
      errEl.classList.toggle('hidden', !msg);
      if (inp) inp.style.borderColor = msg ? '#ef4444' : (inp.value ? '#22c55e' : '');
  }

  function ufUpdateStrength(password: string) {
      const wrap = document.getElementById('uf-strength-wrap')!;
      const fill = document.getElementById('uf-strength-fill') as HTMLElement;
      const label = document.getElementById('uf-strength-label')!;
      const bits = document.getElementById('uf-strength-bits')!;
      if (!password) { wrap.classList.add('hidden'); return; }
      wrap.classList.remove('hidden');
      const entropy = calcPasswordEntropy(password);
      const s = getPasswordStrength(entropy);
      fill.style.width = Math.min((entropy / 128) * 100, 100) + '%';
      fill.style.background = s.color;
      label.textContent = s.label;
      (label as HTMLElement).style.color = s.color;
      bits.textContent = entropy + ' bits';
  }

  // User Management
  // ═══════════════════════════════════════════════

  const userModal = document.getElementById('user-modal');
  const userForm = document.getElementById('user-form') as HTMLFormElement;
  const userModalTitle = document.getElementById('user-modal-title');
  const userModalSubmit = document.getElementById('user-modal-submit');
  const userPasswordLabel = document.getElementById('user-form-password-label');
  const passwordInput = document.getElementById('user-form-password') as HTMLInputElement;

  function ufResetFieldErrors() {
      ['uf-err-username', 'uf-err-email', 'uf-err-password'].forEach(id => {
          const el = document.getElementById(id); if (el) { el.textContent = ''; el.classList.add('hidden'); }
      });
      ['user-form-username', 'user-form-email', 'user-form-password'].forEach(id => {
          const el = document.getElementById(id) as HTMLInputElement; if (el) el.style.borderColor = '';
      });
      const wrap = document.getElementById('uf-strength-wrap'); if (wrap) wrap.classList.add('hidden');
  }

  function openUserModal(editData?: any) {
      if (!userModal) return;
      userModal.classList.remove('hidden');
      ufResetFieldErrors();

      const idInput = document.getElementById('user-form-id') as HTMLInputElement;
      const usernameInput = document.getElementById('user-form-username') as HTMLInputElement;
      const emailInput = document.getElementById('user-form-email') as HTMLInputElement;
      const firstnameInput = document.getElementById('user-form-firstname') as HTMLInputElement;
      const lastnameInput = document.getElementById('user-form-lastname') as HTMLInputElement;
      const storeSelect = document.getElementById('user-form-store') as HTMLSelectElement;
      const roleSelect = document.getElementById('user-form-role') as HTMLSelectElement;

      if (editData) {
          if (userModalTitle) userModalTitle.textContent = 'Editar Usuario';
          if (userModalSubmit) userModalSubmit.textContent = 'Guardar Cambios';
          if (userPasswordLabel) userPasswordLabel.textContent = 'Contraseña (dejar vacío para no cambiar)';
          if (passwordInput) passwordInput.required = false;
          idInput.value = editData.id;
          usernameInput.value = editData.username || '';
          emailInput.value = editData.email || '';
          firstnameInput.value = editData.first_name || '';
          lastnameInput.value = editData.last_name || '';
          storeSelect.value = editData.store_id || '';
          roleSelect.value = editData.role || '';
      } else {
          if (userModalTitle) userModalTitle.textContent = 'Nuevo Usuario';
          if (userModalSubmit) userModalSubmit.textContent = 'Crear Usuario';
          if (userPasswordLabel) userPasswordLabel.textContent = 'Contraseña *';
          if (passwordInput) passwordInput.required = true;
          userForm.reset();
          idInput.value = '';
      }
  }

  function closeUserModal() {
      userModal?.classList.add('hidden');
  }

  document.getElementById('btn-add-user')?.addEventListener('click', () => openUserModal());
  document.getElementById('user-modal-cancel')?.addEventListener('click', closeUserModal);
  userModal?.addEventListener('click', (e) => { if (e.target === userModal) closeUserModal(); });

  document.getElementById('user-form-username')?.addEventListener('input', () => {
      const v = (document.getElementById('user-form-username') as HTMLInputElement).value.trim();
      if (v && !validateUsername(v)) ufSetError('uf-err-username', 'user-form-username', 'Entre 3 y 30 caracteres, solo letras, números y _');
      else ufSetError('uf-err-username', 'user-form-username', '');
  });
  document.getElementById('user-form-email')?.addEventListener('input', () => {
      const v = (document.getElementById('user-form-email') as HTMLInputElement).value.trim();
      if (v && !validateEmail(v)) ufSetError('uf-err-email', 'user-form-email', 'Introduce un email válido');
      else ufSetError('uf-err-email', 'user-form-email', '');
  });
  document.getElementById('user-form-password')?.addEventListener('input', () => {
      const v = (document.getElementById('user-form-password') as HTMLInputElement).value;
      ufUpdateStrength(v);
      if (v && v.length < 8) ufSetError('uf-err-password', 'user-form-password', 'Mínimo 8 caracteres');
      else if (v && !validatePassword(v)) ufSetError('uf-err-password', 'user-form-password', 'Contraseña demasiado débil');
      else ufSetError('uf-err-password', 'user-form-password', '');
  });

  userForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = userModalSubmit as HTMLButtonElement;
      submitBtn.disabled = true;
      const original = submitBtn.textContent || '';
      submitBtn.textContent = '...';

      const userId = (document.getElementById('user-form-id') as HTMLInputElement).value;
      const username = (document.getElementById('user-form-username') as HTMLInputElement).value;
      const email = (document.getElementById('user-form-email') as HTMLInputElement).value;
      const password = (document.getElementById('user-form-password') as HTMLInputElement).value;
      const first_name = (document.getElementById('user-form-firstname') as HTMLInputElement).value;
      const last_name = (document.getElementById('user-form-lastname') as HTMLInputElement).value;
      const store_id = (document.getElementById('user-form-store') as HTMLSelectElement).value;
      const role = (document.getElementById('user-form-role') as HTMLSelectElement).value;

      try {
          let body: any;
          if (userId) {
              const data: any = { username, email, first_name, last_name, store_id: store_id || null, role };
              if (password) data.password = password;
              body = { action: 'update', userId, data };
          } else {
              body = { action: 'create', username, email, password, first_name, last_name, store_id: store_id || undefined, role: role || undefined };
          }

          const res = await fetch('/api/admin/users/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
          });
          const result = await res.json();

          if (result.success) {
              showToast(result.message || (userId ? 'Usuario actualizado' : 'Usuario creado'));
              closeUserModal();
              setTimeout(() => window.location.reload(), 800);
          } else {
              showToast(result.message || 'Error', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = original;
      }
  });

  // Edit buttons
  document.querySelectorAll('.user-edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
          const data = JSON.parse((btn as HTMLElement).dataset.user || '{}');
          openUserModal(data);
      });
  });

  // Toggle active buttons
  document.querySelectorAll('.user-toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
          const target = btn as HTMLButtonElement;
          const userId = target.dataset.id;
          const userName = target.dataset.name;
          const isActive = target.dataset.active === 'true';
          if (!userId) return;
          if (!await openConfirmModal(
              `${isActive ? 'Desactivar' : 'Activar'} a "${userName}"`,
              isActive
                  ? 'El usuario no podrá iniciar sesión hasta que se reactive.'
                  : 'El usuario podrá volver a iniciar sesión.',
              isActive ? 'Desactivar' : 'Activar',
              isActive ? 'yellow' : 'green'
          )) return;

          target.disabled = true;
          try {
              const res = await fetch('/api/admin/users/action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'update', userId, data: { is_active: !isActive } })
              });
              const result = await res.json();
              if (result.success) {
                  showToast(`"${userName}" ${isActive ? 'desactivado' : 'activado'}`);
                  setTimeout(() => window.location.reload(), 800);
              } else {
                  showToast(result.message || 'Error', 'error');
                  target.disabled = false;
              }
          } catch {
              showToast('Error de conexión', 'error');
              target.disabled = false;
          }
      });
  });

  // botones de borrado (con detección inteligente del rol CEO)
  let pendingDeleteUserId = '';
  document.querySelectorAll('.user-delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
          const target = btn as HTMLButtonElement;
          const userId = target.dataset.id;
          const userName = target.dataset.name;
          if (!userId) return;
          target.disabled = true;
          try {
              const res = await fetch('/api/admin/users/action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'delete', userId })
              });
              const result = await res.json();
              if (result.requiresConfirmation) {
                  // CEO detected — show modal
                  pendingDeleteUserId = userId!;
                  const msgEl = document.getElementById('ceo-delete-message');
                  if (msgEl) msgEl.textContent = result.message;
                  document.getElementById('ceo-delete-modal')?.classList.remove('hidden');
                  target.disabled = false;
              } else if (result.success) {
                  showToast(result.message || 'Usuario eliminado');
                  setTimeout(() => window.location.reload(), 800);
              } else {
                  showToast(result.message || 'Error al eliminar', 'error');
                  target.disabled = false;
              }
          } catch {
              showToast('Error de conexión', 'error');
              target.disabled = false;
          }
      });
  });

  // CEO Delete modal buttons
  document.getElementById('ceo-delete-cancel')?.addEventListener('click', () => {
      document.getElementById('ceo-delete-modal')?.classList.add('hidden');
      pendingDeleteUserId = '';
  });
  document.getElementById('ceo-delete-user-only')?.addEventListener('click', async () => {
      document.getElementById('ceo-delete-modal')?.classList.add('hidden');
      try {
          const res = await fetch('/api/admin/users/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', userId: pendingDeleteUserId, confirm: 'user' })
          });
          const result = await res.json();
          if (result.success) {
              showToast(result.message || 'Usuario eliminado');
              setTimeout(() => window.location.reload(), 800);
          } else showToast(result.message || 'Error', 'error');
      } catch { showToast('Error de conexión', 'error'); }
  });
  document.getElementById('ceo-delete-both')?.addEventListener('click', async () => {
      document.getElementById('ceo-delete-modal')?.classList.add('hidden');
      try {
          const res = await fetch('/api/admin/users/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', userId: pendingDeleteUserId, confirm: 'both' })
          });
          const result = await res.json();
          if (result.success) {
              showToast(result.message || 'Usuario y tienda eliminados');
              setTimeout(() => window.location.reload(), 800);
          } else showToast(result.message || 'Error', 'error');
      } catch { showToast('Error de conexión', 'error'); }
  });

  // ═══════════════════════════════════════════════
  // Crear Tienda
  // ═══════════════════════════════════════════════

  document.getElementById('btn-create-store')?.addEventListener('click', () => {
      document.getElementById('create-store-modal')?.classList.remove('hidden');
  });
  document.getElementById('cs-cancel')?.addEventListener('click', () => {
      document.getElementById('create-store-modal')?.classList.add('hidden');
  });
  document.getElementById('create-store-modal')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('create-store-modal')) {
          document.getElementById('create-store-modal')?.classList.add('hidden');
      }
  });

  document.getElementById('create-store-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('cs-submit') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creando...';

      const payload = {
          action: 'create',
          name: (document.getElementById('cs-name') as HTMLInputElement).value,
          subdomain: (document.getElementById('cs-subdomain') as HTMLInputElement).value,
          plan_id: (document.getElementById('cs-plan') as HTMLSelectElement).value,
          owner_email: (document.getElementById('cs-email') as HTMLInputElement).value,
          owner_password: (document.getElementById('cs-password') as HTMLInputElement).value || undefined,
          owner_first_name: (document.getElementById('cs-firstname') as HTMLInputElement).value || undefined,
          owner_last_name: (document.getElementById('cs-lastname') as HTMLInputElement).value || undefined,
      };

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
          });
          const result = await res.json();
          if (result.success) {
              const pwd = result.data?.password;
              showToast(result.message);
              document.getElementById('create-store-modal')?.classList.add('hidden');
              if (pwd) {
                  showPasswordModal(pwd);
              } else {
                  setTimeout(() => window.location.reload(), 1200);
              }
          } else {
              showToast(result.message || 'Error al crear tienda', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Crear Tienda';
      }
  });

  // ═══════════════════════════════════════════════
  // Tickets: Buscar y Borrar
  // ═══════════════════════════════════════════════

  // Client-side search filter
  document.getElementById('ticket-search')?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll('.ticket-item').forEach(el => {
          const text = el.textContent?.toLowerCase() || '';
          (el as HTMLElement).style.display = text.includes(query) ? '' : 'none';
      });
  });

  // borramos el ticket actual
  document.getElementById('btn-delete-current-ticket')?.addEventListener('click', async () => {
      if (!currentTicketId) return;
      if (!await openConfirmModal(
          'Eliminar este ticket',
          'El ticket se eliminará permanentemente.',
          'Eliminar',
          'red'
      )) return;
      try {
          const result = await ticketAction('delete', { ticketId: currentTicketId });
          if (result.success) {
              showToast('Ticket eliminado');
              setTimeout(() => window.location.reload(), 600);
          } else showToast(result.message || 'Error', 'error');
      } catch { showToast('Error de conexión', 'error'); }
  });

  // borramos todos los tickets resueltos
  document.getElementById('btn-delete-resolved-tickets')?.addEventListener('click', async () => {
      if (!await openConfirmModal(
          'Eliminar TODOS los tickets resueltos',
          'Se eliminarán permanentemente todos los tickets resueltos. Esta acción no se puede deshacer.',
          'Eliminar todos',
          'red'
      )) return;
      try {
          const result = await ticketAction('delete-resolved', {});
          if (result.success) {
              showToast(result.message || 'Tickets resueltos eliminados');
              setTimeout(() => window.location.reload(), 600);
          } else showToast(result.message || 'Error', 'error');
      } catch { showToast('Error de conexión', 'error'); }
  });

</script>
