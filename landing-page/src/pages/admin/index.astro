<script>
import { calcPasswordEntropy, getPasswordStrength, validateEmail, validateUsername, validatePassword } from '../../utils/validation.js';

// --- Previsualización en tiempo real para configuración enterprise ---

// lee un File y devuelve un data URL (base64). Los Blob URLs están limitados al origen
// y no pueden cruzar de neonhub.es a sergiotesting.neonhub.es en el iframe.
function fileToDataUrl(file: File): Promise<string> {
    return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => resolve((e.target?.result as string) || '');
        reader.onerror = () => resolve('');
        reader.readAsDataURL(file);
    });
}

async function sendPreviewUpdate() {
    const name = document.getElementById('ec-store-name').value;
    const desc = document.getElementById('ec-store-desc').value;

    // Logo — usamos data URL para que el iframe de preview cross-origin pueda cargarlo
    const logoInput = document.getElementById('ec-logo') as HTMLInputElement;
    let logo = (document.getElementById('ec-logo-preview') as HTMLImageElement)?.src || '';
    if (logoInput?.files?.[0]) {
        logo = await fileToDataUrl(logoInput.files[0]);
    }

    // Favicon — same reason
    const favInput = document.getElementById('ec-favicon') as HTMLInputElement;
    let favicon = (document.getElementById('ec-favicon-preview') as HTMLImageElement)?.src || '';
    if (favInput?.files?.[0]) {
        favicon = await fileToDataUrl(favInput.files[0]);
    }

    // Recoger valores de diseño adicionales
    const layout = (document.getElementById('ec-layout') as HTMLSelectElement)?.value;
    const fontFamily = (document.getElementById('ec-font') as HTMLSelectElement)?.value;
    const fontWeight = (document.getElementById('ec-font-weight') as HTMLSelectElement)?.value;
    const buttonStyle = (document.getElementById('ec-button-style') as HTMLSelectElement)?.value;
    const headerText = (document.getElementById('ec-header-text') as HTMLInputElement)?.value;
    const footerText = (document.getElementById('ec-footer-text') as HTMLInputElement)?.value;
    const customCSS = (document.getElementById('ec-custom-css') as HTMLTextAreaElement)?.value;
    const poweredBy = (document.getElementById('ec-powered-by') as HTMLInputElement)?.checked;
    
    // Announcement
    const announcementText = (document.getElementById('ec-announcement-text') as HTMLInputElement)?.value;
    const announcementColor = (document.getElementById('ec-announcement-color') as HTMLInputElement)?.value;

    // Social Links
    const socialLinks = {
        instagram: (document.getElementById('ec-social-instagram') as HTMLInputElement)?.value || '',
        twitter: (document.getElementById('ec-social-twitter') as HTMLInputElement)?.value || '',
        facebook: (document.getElementById('ec-social-facebook') as HTMLInputElement)?.value || '',
        tiktok: (document.getElementById('ec-social-tiktok') as HTMLInputElement)?.value || ''
    };

    // Recoger secciones y features en tiempo real
    const sections: Record<string, boolean> = {};
    const features: Record<string, boolean> = {};
    document.querySelectorAll('[id^="ec-sec-"]').forEach(el => {
        const key = el.id.replace('ec-sec-', '');
        sections[key] = (el as HTMLInputElement).checked;
    });
    document.querySelectorAll('[id^="ec-feat-"]').forEach(el => {
        const key = el.id.replace('ec-feat-', '');
        features[key] = (el as HTMLInputElement).checked;
    });
    // Recoger límites en tiempo real
    const parseLimitValue = (id) => {
        const val = parseInt((document.getElementById(id) as HTMLInputElement)?.value);
        return isNaN(val) ? -1 : val;
    };
    const limits = {
        max_products: parseLimitValue('ec-max-products'),
        max_users: parseLimitValue('ec-max-users'),
        max_categories: parseLimitValue('ec-max-categories'),
        max_storage_mb: parseLimitValue('ec-max-storage')
    };
    postToIframe({ 
        name, desc, logo, favicon, layout, fontFamily, fontWeight, buttonStyle, 
        headerText, footerText, customCSS, poweredBy, announcementText, announcementColor,
        socialLinks, sections, features, limits 
    });
}

function postToIframe(payload) {
    const colors = {
        primary: document.getElementById('ec-primary-color').value,
        secondary: document.getElementById('ec-secondary-color').value,
        accent: document.getElementById('ec-accent-color').value,
        background: document.getElementById('ec-bg-color').value
    };
    // Gradient info
    const gradient_enabled = document.getElementById('ec-gradient-enabled')?.checked;
    const gradient_start = document.getElementById('ec-gradient-start')?.value;
    const gradient_end = document.getElementById('ec-gradient-end')?.value;
    const gradient_direction = document.getElementById('ec-gradient-direction')?.value;
    // Compose background style
    let backgroundStyle = colors.background;
    if (gradient_enabled) {
        backgroundStyle = `linear-gradient(${gradient_direction}, ${gradient_start}, ${gradient_end})`;
    }
    // Add design info for gradient support in live preview
    const design = {
        gradient_enabled,
        gradient_start,
        gradient_end,
        gradient_direction,
        button_style: payload.buttonStyle,
        layout: payload.layout,
        font_family: payload.fontFamily,
        font_weight: payload.fontWeight,
        header_text: payload.headerText,
        footer_text: payload.footerText,
        custom_css: payload.customCSS,
        show_powered_by: payload.poweredBy,
        announcement_text: payload.announcementText,
        announcement_color: payload.announcementColor,
        social_links: payload.socialLinks,
        backgroundStyle
    };
    const iframe = document.getElementById('ec-preview');
    if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage({
            type: 'SHOP_PREVIEW_UPDATE',
            payload: { ...payload, colors, design, sections: payload.sections, features: payload.features, limits: payload.limits }
        }, '*');
    }
}

