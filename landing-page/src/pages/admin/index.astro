  // ── Save Enterprise Config ──
  document.getElementById('ec-save')?.addEventListener('click', async () => {
          // Recoger límites de forma robusta
          const parseSaveLimit = (id) => {
              const val = parseInt((document.getElementById(id) as HTMLInputElement)?.value);
              return isNaN(val) ? -1 : val;
          };
          const limits = {
              max_products: parseSaveLimit('ec-max-products'),
              max_users: parseSaveLimit('ec-max-users'),
              max_categories: parseSaveLimit('ec-max-categories'),
              max_storage_mb: parseSaveLimit('ec-max-storage')
          };
      if (!currentStoreDetailId || !currentEnterpriseConfig) return;

      const saveBtn = document.getElementById('ec-save') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span>⏳</span> Guardando...';

      // 1. Upload images if selected
      const logoFile = (document.getElementById('ec-logo') as HTMLInputElement)?.files?.[0];
      const faviconFile = (document.getElementById('ec-favicon') as HTMLInputElement)?.files?.[0];
      
      let finalLogoUrl = currentEnterpriseConfig.branding?.logo_url || '';
      let finalFaviconUrl = currentEnterpriseConfig.branding?.favicon_url || '';

      if (logoFile || faviconFile) {
          saveBtn.innerHTML = '<span>⏳</span> Subiendo imágenes...';

          try {
              // pasamos por el endpoint SSR de Astro para que el admin secret
              // nunca salga del servidor. El cliente manda data URLs en base64;
              // el servidor las convierte a blobs antes de llamar al backend.
              const toBase64Payload = (file: File): Promise<{ data: string; type: string; name: string }> =>
                  new Promise((resolve, reject) => {
                      const reader = new FileReader();
                      reader.onload = (e) => resolve({ data: e.target?.result as string, type: file.type, name: file.name });
                      reader.onerror = reject;
                      reader.readAsDataURL(file);
                  });

              const payload: Record<string, any> = {
                  action: 'upload-enterprise-images',
                  storeId: currentStoreDetailId
              };
              if (logoFile) payload.logo = await toBase64Payload(logoFile);
              if (faviconFile) payload.favicon = await toBase64Payload(faviconFile);

              const uploadRes = await fetch('/api/admin/stores/action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload)
              });

              const uploadResult = await uploadRes.json();

              if (uploadResult.success && uploadResult.data?.images) {
                  const uploadedImgs = uploadResult.data.images;
                  if (logoFile) {
                      const match = uploadedImgs.find((img: any) => img.originalName === logoFile.name);
                      if (match) finalLogoUrl = match.url;
                  }
                  if (faviconFile) {
                      const match = uploadedImgs.find((img: any) => img.originalName === faviconFile.name);
                      if (match) finalFaviconUrl = match.url;
                  }
              } else {
                  showToast(uploadResult.message || 'Error al procesar imágenes', 'error');
                  saveBtn.disabled = false;
                  saveBtn.innerHTML = '<span>💾</span> Guardar Configuración';
                  return;
              }
          } catch (e) {
              showToast('Error de conexión con el servidor al subir imágenes', 'error');
              saveBtn.disabled = false;
              saveBtn.innerHTML = '<span>💾</span> Guardar Configuración';
              return;
          }
      }

      saveBtn.innerHTML = '<span>⏳</span> Guardando configuración...';

      // 2. Recoger secciones y funcionalidades de forma robusta
      const sections: Record<string, boolean> = {};
      document.querySelectorAll('[id^="ec-sec-"]').forEach(el => {
          const key = el.id.replace('ec-sec-', '');
          sections[key] = (el as HTMLInputElement).checked;
      });
      const features: Record<string, boolean> = {};
      document.querySelectorAll('[id^="ec-feat-"]').forEach(el => {
          const key = el.id.replace('ec-feat-', '');
          features[key] = (el as HTMLInputElement).checked;
      });

      const branding = {
          store_name: (document.getElementById('ec-store-name') as HTMLInputElement)?.value || '',
          store_description: (document.getElementById('ec-store-desc') as HTMLInputElement)?.value || '',
          primary_color: (document.getElementById('ec-primary-color') as HTMLInputElement)?.value || '',
          secondary_color: (document.getElementById('ec-secondary-color') as HTMLInputElement)?.value || '',
          accent_color: (document.getElementById('ec-accent-color') as HTMLInputElement)?.value || '',
          bg_color: (document.getElementById('ec-bg-color') as HTMLInputElement)?.value || '',
          logo_url: finalLogoUrl,
          favicon_url: finalFaviconUrl
      };

      const config = {
          branding,
          sections,
          features,
          design: {
              layout: (document.getElementById('ec-layout') as HTMLSelectElement)?.value || 'default',
              custom_css: (document.getElementById('ec-custom-css') as HTMLTextAreaElement)?.value || '',
              custom_header_html: currentEnterpriseConfig.design?.custom_header_html || '',
              custom_footer_html: currentEnterpriseConfig.design?.custom_footer_html || '',
              show_powered_by: (document.getElementById('ec-powered-by') as HTMLInputElement)?.checked ?? true,
              font_family: (document.getElementById('ec-font') as HTMLSelectElement)?.value || 'default',
              font_weight: (document.getElementById('ec-font-weight') as HTMLSelectElement)?.value || 'regular',
              button_style: (document.getElementById('ec-button-style') as HTMLSelectElement)?.value || 'rounded',
              gradient_enabled: (document.getElementById('ec-gradient-enabled') as HTMLInputElement)?.checked || false,
              gradient_start: (document.getElementById('ec-gradient-start') as HTMLInputElement)?.value || '#0ea5e9',
              gradient_end: (document.getElementById('ec-gradient-end') as HTMLInputElement)?.value || '#6366f1',
              gradient_direction: (document.getElementById('ec-gradient-direction') as HTMLSelectElement)?.value || 'to right',
              header_text: (document.getElementById('ec-header-text') as HTMLInputElement)?.value || '',
              footer_text: (document.getElementById('ec-footer-text') as HTMLInputElement)?.value || '',
              announcement_text: (document.getElementById('ec-announcement-text') as HTMLInputElement)?.value || '',
              announcement_color: (document.getElementById('ec-announcement-color') as HTMLInputElement)?.value || '#f59e0b',
              social_links: {
                  instagram: (document.getElementById('ec-social-instagram') as HTMLInputElement)?.value || '',
                  twitter: (document.getElementById('ec-social-twitter') as HTMLInputElement)?.value || '',
                  facebook: (document.getElementById('ec-social-facebook') as HTMLInputElement)?.value || '',
                  tiktok: (document.getElementById('ec-social-tiktok') as HTMLInputElement)?.value || '',
              }
          },
          limits
      };

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'update-enterprise-config', storeId: currentStoreDetailId, config })
          });
          const result = await res.json();
          if (result.success) {
              showToast('Configuración enterprise guardada');
              ecModal?.classList.add('hidden');
          } else {
              showToast(result.message || 'Error guardando', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      } finally {
          saveBtn.disabled = false;
          saveBtn.innerHTML = '<span>💾</span> Guardar Configuración';
      }
  });

