                                            <td class="py-4 px-4 text-right">
                                                <button 
                                                    class="approve-btn px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                                                    data-id={req.id}
                                                >
                                                    Aprobar y Crear
                                                </button>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                )}

                {/* Completed requests */}
                {completedRequests.length > 0 && (
                    <div class="mb-4">
                        <h3 class="text-lg font-semibold text-green-400 mb-4 flex items-center gap-2">
                            ✅ Completados ({completedRequests.length})
                        </h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-gray-200 dark:border-white/10">
                                        <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Tenant / Dominio</th>
                                        <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Cliente</th>
                                        <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Plan</th>
                                        <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Fecha</th>
                                        <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Estado</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                                    {completedRequests.map((req: any) => (
                                        <tr class="hover:bg-gray-100 dark:hover:bg-white/10 transition-colors opacity-60">
                                            <td class="py-3 px-4">
                                                <p class="text-gray-900 dark:text-white font-medium text-sm">{req.payload?.tenant_name || '—'}</p>
                                                <p class="text-xs text-gray-500 dark:text-slate-400">{req.payload?.subdomain ? `${req.payload.subdomain}.neonhub.es` : '—'}</p>
                                            </td>
                                            <td class="py-3 px-4">
                                                <p class="text-gray-600 dark:text-slate-300 text-sm">{req.payload?.owner_email || '—'}</p>
                                            </td>
                                            <td class="py-3 px-4">
                                                <span class="text-sm text-gray-600 dark:text-slate-300">{req.payload?.plan_id || '—'}</span>
                                            </td>
                                            <td class="py-3 px-4 text-sm text-gray-500 dark:text-slate-400">
                                                {formatDate(req.created_at)}
                                            </td>
                                            <td class="py-3 px-4">
                                                <span class="px-2 py-1 rounded-full bg-green-500/10 text-green-400 text-xs font-medium border border-green-500/20">
                                                    Completado
                                                </span>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                )}

                {/* sin solicitudes */}
                {requests.length === 0 && (
                    <div class="py-12 text-center text-gray-500 dark:text-slate-400">
                        No hay solicitudes de provisioning.
                    </div>
                )}

                {/* Only completed, no pending */}
                {pendingRequests.length === 0 && completedRequests.length === 0 && requests.length > 0 && (
                    <div class="py-8 text-center text-gray-500 dark:text-slate-400">
                        Todas las solicitudes han sido procesadas.
                    </div>
                )}
            </div>
        </div>

        <!-- ═══════════ Tab: Facturación ═══════════ -->
        <div id="tab-billing" class="tab-content hidden">
            <div class="p-6 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Resumen de Facturación</h2>
                    <button id="btn-check-overdue" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-sm font-medium transition-colors disabled:opacity-50">
                        Comprobar Impagos
                    </button>
                </div>

                {billing ? (
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="p-5 rounded-xl bg-green-500/5 border border-green-500/10">
                            <h3 class="text-green-400 text-sm font-medium mb-2">Ingresos Mensuales</h3>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">{billing.totalMonthlyRevenue ? `${(billing.totalMonthlyRevenue / 100).toFixed(2)} €` : '0.00 €'}</p>
                        </div>
                        <div class="p-5 rounded-xl bg-violet-500/5 border border-violet-500/10">
                            <h3 class="text-violet-400 text-sm font-medium mb-2">Suscripciones Activas</h3>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">{billing.activeSubscriptions || 0}</p>
                        </div>
                        <div class="p-5 rounded-xl bg-red-500/5 border border-red-500/10">
                            <h3 class="text-red-400 text-sm font-medium mb-2">Impagos</h3>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">{billing.overdueCount || 0}</p>
                        </div>
                    </div>
                ) : (
                    <div class="text-center py-8 text-gray-500 dark:text-slate-400">
                        <p>No se pudieron cargar los datos de facturación.</p>
                        <p class="text-sm mt-2">Es posible que el servicio de billing no esté configurado.</p>
                    </div>
                )}

                <!-- Stores billing detail -->
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Detalle por Tienda</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 dark:border-white/10">
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Tienda</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Plan</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Precio/mes</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Inicio</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Próx. Pago</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                            {stores.filter((s: any) => s.plan_id).length === 0 ? (
                                <tr>
                                    <td colspan="6" class="py-8 text-center text-gray-500 dark:text-slate-400">
                                        Ninguna tienda tiene plan activo.
                                    </td>
                                </tr>
                            ) : (
                                stores.filter((s: any) => s.plan_id).map((store: any) => (
                                    <tr class="hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                                        <td class="py-4 px-4">
                                            <p class="text-gray-900 dark:text-white font-medium">{store.name}</p>
                                            <p class="text-xs text-gray-500 dark:text-slate-400">{store.subdomain}.neonhub.es</p>
                                        </td>
                                        <td class="py-4 px-4 text-sm text-gray-600 dark:text-slate-300">{store.plan_id}</td>
                                        <td class="py-4 px-4 text-sm text-gray-900 dark:text-white font-medium">{formatPrice(store.plan_price_cents)}</td>
                                        <td class="py-4 px-4 text-sm text-gray-500 dark:text-slate-400">{formatDate(store.billing_start_date)}</td>
                                        <td class="py-4 px-4 text-sm text-gray-500 dark:text-slate-400">{formatDate(store.next_payment_date)}</td>
                                        <td class="py-4 px-4">
                                            <span class={`px-2 py-1 rounded-full text-xs font-medium border ${paymentStatusColors[store.payment_status] || 'bg-slate-500/10 text-gray-500 dark:text-slate-400 border-slate-500/20'}`}>
                                                {store.payment_status || '—'}
                                            </span>
                                        </td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Create/Edit User Modal (outside tabs so it's always accessible) -->
        <div id="user-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-white/10 rounded-2xl p-6 w-full max-w-lg">
                <h3 id="user-modal-title" class="text-lg font-bold text-gray-900 dark:text-white mb-4">Nuevo Usuario</h3>
                <form id="user-form" class="space-y-4">
                    <input type="hidden" id="user-form-id" />
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1">Nombre</label>
                            <input type="text" id="user-form-firstname" class="w-full px-3 py-2 bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                        </div>
                        <div>
                            <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1">Apellido</label>
                            <input type="text" id="user-form-lastname" class="w-full px-3 py-2 bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1">Username *</label>
                        <input type="text" id="user-form-username" required class="w-full px-3 py-2 bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                        <p id="uf-err-username" class="mt-1 text-xs text-red-400 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1">Email *</label>
                        <input type="email" id="user-form-email" required class="w-full px-3 py-2 bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                        <p id="uf-err-email" class="mt-1 text-xs text-red-400 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1" id="user-form-password-label">Contraseña *</label>
                        <input type="password" id="user-form-password" class="w-full px-3 py-2 bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                        <div id="uf-strength-wrap" class="mt-2 hidden">
                            <div style="background:#1e293b;border-radius:3px;height:5px;overflow:hidden;">
                                <div id="uf-strength-fill" style="height:100%;border-radius:3px;transition:width .2s,background .2s;width:0%"></div>
                            </div>
                            <div class="flex justify-between mt-1">
                                <span id="uf-strength-label" class="text-xs"></span>
                                <span id="uf-strength-bits" class="text-xs text-gray-400 dark:text-slate-500"></span>
                            </div>
                        </div>
                        <p id="uf-err-password" class="mt-1 text-xs text-red-400 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1">Tienda</label>
                        <select id="user-form-store" class="w-full px-3 py-2 bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500">
                            <option value="" class="bg-gray-100 dark:bg-slate-800 text-gray-900 dark:text-white">Sin asignar</option>
                            {stores.map((s: any) => (
                                <option value={s.id} class="bg-gray-100 dark:bg-slate-800 text-gray-900 dark:text-white">{s.name} ({s.subdomain})</option>
                            ))}
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-500 dark:text-slate-400 mb-1">Rol</label>
                        <select id="user-form-role" class="w-full px-3 py-2 bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500">
                            <option value="" class="bg-gray-100 dark:bg-slate-800 text-gray-900 dark:text-white">Sin rol</option>
                            {roles.map((r: any) => (
                                <option value={r.name} class="bg-gray-100 dark:bg-slate-800 text-gray-900 dark:text-white">{r.display_name || r.name} {r.description ? `- ${r.description}` : ''}</option>
                            ))}
                        </select>
                    </div>
                    <div class="flex justify-end gap-3 pt-2">
                        <button type="button" id="user-modal-cancel" class="px-4 py-2 bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-slate-300 rounded-lg text-sm hover:bg-gray-200 dark:bg-white/10 transition-colors">Cancelar</button>
                        <button type="submit" id="user-modal-submit" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">Crear Usuario</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ═══════════ Tab: Usuarios ═══════════ -->
        <div id="tab-users" class="tab-content hidden">
            <div class="p-6 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Gestión de Usuarios</h2>
                </div>

                <!-- Sub-tabs -->
                <div class="flex gap-2 mb-6 border-b border-gray-200 dark:border-white/10 pb-0">
                    <button class="users-subtab active px-4 py-2.5 text-sm font-medium rounded-t-lg transition-all bg-violet-600/20 text-violet-300 border border-violet-500/30 border-b-0 hover:text-gray-900 dark:hover:text-white" data-subtab="saas">
                        Clientes SaaS ({sortedUsers.length})
                    </button>
                    <button class="users-subtab px-4 py-2.5 text-sm font-medium rounded-t-lg transition-all text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white border border-transparent" data-subtab="leads">
                        Leads Landing ({leads.length})
                    </button>
                </div>

                <!-- Sub-tab: Clientes SaaS -->
                <div id="users-subtab-saas" class="users-subtab-content">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex gap-2 items-center">
                            <select id="user-role-filter" class="bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-slate-300 text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-violet-500">
                                <option value="" class="bg-gray-100 dark:bg-slate-800">Todos los roles</option>
                                <option value="staff" class="bg-gray-100 dark:bg-slate-800">Solo empleados</option>
                                <option value="customers" class="bg-gray-100 dark:bg-slate-800">Solo clientes</option>
                                <option value="ceo" class="bg-gray-100 dark:bg-slate-800">CEOs de Tiendas</option>
                                {roles.map((r: any) => (
                                    <option value={r.name} class="bg-gray-100 dark:bg-slate-800">{r.display_name || r.name}</option>
                                ))}
                            </select>
                            <button id="btn-add-user" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">
                                + Nuevo Usuario
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-gray-200 dark:border-white/10">
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Usuario</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Email</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Tienda</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm cursor-pointer hover:text-gray-900 dark:text-white transition-colors" id="sort-role-header">Rol ↕</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Estado</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Registro</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Nota</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="users-table-body" class="divide-y divide-gray-100 dark:divide-white/5">
                                {sortedUsers.length === 0 ? (
                                    <tr>
                                        <td colspan="8" class="py-8 text-center text-gray-500 dark:text-slate-400">No hay usuarios registrados.</td>
                                    </tr>
                                ) : (
                                    sortedUsers.map((u: any) => (
                                        <tr class="hover:bg-gray-100 dark:hover:bg-white/10 transition-colors user-row cursor-pointer"
                                            data-role={u.roles?.[0]?.name || ''}
                                            data-user-id={u.id}
                                            data-username={u.username}
                                            data-email={u.email}
                                            data-active={u.is_active ? 'true' : 'false'}
                                            data-since={u.created_at || u.createdAt || ''}
                                            data-locked-until={u.locked_until || ''}
                                        >
                                            <td class="py-4 px-4">
                                                <p class="text-gray-900 dark:text-white font-medium">{u.username}</p>
                                                {(u.first_name || u.last_name) && <p class="text-xs text-gray-500 dark:text-slate-400">{u.first_name} {u.last_name}</p>}
                                            </td>
                                            <td class="py-4 px-4 text-sm text-gray-600 dark:text-slate-300">{u.email}</td>
                                            <td class="py-4 px-4 text-sm">
                                                {(() => {
                                                    const all: any[] = u.stores?.length ? u.stores : (u.store ? [u.store] : []);
                                                    if (!all.length) return <span class="text-gray-400 dark:text-slate-500 italic text-xs">Sin tienda</span>;
                                                    return (
                                                        <div class="flex flex-col gap-0.5">
                                                            {all.map((s: any) => (
                                                                <span class="text-violet-400 text-xs leading-tight">
                                                                    {s.name}<span class="text-gray-400 dark:text-slate-500"> ({s.subdomain})</span>
                                                                </span>
                                                            ))}
                                                        </div>
                                                    );
                                                })()}
                                            </td>
                                            <td class="py-4 px-4">
                                                {u.roles?.length > 0 ? (() => {
                                                    const sorted = [...u.roles].sort((a: any, b: any) => (b.level || 0) - (a.level || 0));
                                                    const top = sorted[0];
                                                    const extra = sorted.length - 1;
                                                    return (
                                                        <span
                                                            class={`inline-flex items-center whitespace-nowrap px-2 py-1 rounded-full text-xs font-medium border cursor-default ${roleColors[top.name] || 'bg-violet-500/10 text-violet-400 border-violet-500/20'}`}
                                                            title={u.roles.map((r: any) => r.display_name || r.name).join(', ')}
                                                        >
                                                            {top.display_name || top.name}{extra > 0 ? ` +${extra}` : ''}
                                                        </span>
                                                    );
                                                })() : (
                                                    <span class="text-gray-400 dark:text-slate-500 text-sm">—</span>
                                                )}
                                            </td>
                                            <td class="py-4 px-4">
                                                {(() => {
                                                    const isLocked = u.locked_until && new Date(u.locked_until) > new Date();
                                                    if (isLocked) {
                                                        const rem = Math.ceil((new Date(u.locked_until).getTime() - Date.now()) / 60000);
                                                        return <span class="px-2 py-1 rounded-full text-xs font-medium border bg-orange-500/10 text-orange-400 border-orange-500/20" title={`Bloqueada hasta ${new Date(u.locked_until).toLocaleTimeString('es-ES')}`}>Bloqueada {rem}min</span>;
                                                    }
                                                    return <span class={`px-2 py-1 rounded-full text-xs font-medium border ${u.is_active ? 'bg-green-500/10 text-green-400 border-green-500/20' : 'bg-red-500/10 text-red-400 border-red-500/20'}`}>
                                                        {u.is_active ? 'Activo' : 'Inactivo'}
                                                    </span>;
                                                })()}
                                            </td>
                                            <td class="py-4 px-4 text-sm text-gray-500 dark:text-slate-400">{formatDate(u.created_at || u.createdAt)}</td>
                                            <td class="py-4 px-4 max-w-[160px]">
                                                <div class="note-cell" data-email={u.email}>
                                                    <span class="note-preview text-xs text-gray-500 dark:text-slate-400 italic cursor-pointer hover:text-gray-700 dark:text-slate-200 transition-colors" title="Click para editar">
                                                        {notes[u.email] ? notes[u.email].slice(0, 35) + (notes[u.email].length > 35 ? '…' : '') : '—'}
                                                    </span>
                                                    <div class="note-editor hidden mt-1">
                                                        <textarea class="note-textarea w-full bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 text-gray-700 dark:text-slate-200 text-xs rounded px-2 py-1 resize-none focus:outline-none focus:border-violet-500" rows="2" placeholder="Añadir nota...">{notes[u.email] || ''}</textarea>
                                                        <button class="note-save-btn mt-1 px-2 py-1 bg-violet-600/20 text-violet-400 border border-violet-500/20 rounded text-xs hover:bg-violet-600/30 transition-colors">Guardar</button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-4 px-4">
                                                {u.email === user.email ? (
                                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-600/20 text-gray-500 dark:text-slate-400 border border-slate-500/20">Tú mismo</span>
                                                ) : (
                                                    <div class="flex gap-2 flex-wrap">
                                                        <button class="user-reset-pwd-btn px-3 py-1.5 bg-blue-600/20 text-blue-400 border border-blue-500/20 rounded-lg text-xs font-medium hover:bg-blue-600/30 transition-colors"
                                                            data-email={u.email} data-name={u.username}>
                                                            Resetear contraseña
                                                        </button>
                                                        {u.locked_until && new Date(u.locked_until) > new Date() && (
                                                            <button class="user-unlock-btn px-3 py-1.5 bg-orange-600/20 text-orange-400 border border-orange-500/20 rounded-lg text-xs font-medium hover:bg-orange-600/30 transition-colors"
                                                                data-id={u.id} data-name={u.username}>
                                                                Desbloquear
                                                            </button>
                                                        )}
                                                        <button class="user-toggle-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors border"
                                                            data-id={u.id} data-name={u.username} data-active={u.is_active ? 'true' : 'false'}
                                                            class:list={[u.is_active ? 'bg-yellow-600/20 text-yellow-400 border-yellow-500/20 hover:bg-yellow-600/30' : 'bg-green-600/20 text-green-400 border-green-500/20 hover:bg-green-600/30']}>
                                                            {u.is_active ? 'Desactivar' : 'Activar'}
                                                        </button>
                                                        <button class="user-delete-btn px-3 py-1.5 bg-red-600/20 text-red-400 border border-red-500/20 rounded-lg text-xs font-medium hover:bg-red-600/30 transition-colors"
                                                            data-id={u.id} data-name={u.username}>
                                                            Eliminar
                                                        </button>
                                                    </div>
                                                )}
                                            </td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Sub-tab: Leads Landing -->
                <div id="users-subtab-leads" class="users-subtab-content hidden">
                    <div class="flex justify-end mb-3">
                        <button id="btn-add-lead" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">
                            + Nuevo Usuario
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-gray-200 dark:border-white/10">
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Email</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Verificado</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Estado</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Registro</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Nota</th>
                                    <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                                {leads.length === 0 ? (
                                    <tr>
                                        <td colspan="6" class="py-8 text-center text-gray-500 dark:text-slate-400">No hay leads registrados.</td>
                                    </tr>
                                ) : (
                                    leads.map((l: any) => (
                                        <tr class="hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                                            <td class="py-4 px-4 text-sm text-gray-900 dark:text-white">{l.email}</td>
                                            <td class="py-4 px-4">
                                                {l.email_verified ? (
                                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-green-500/10 text-green-400 border border-green-500/20">Verificado</span>
                                                ) : (
                                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">Pendiente</span>
                                                )}
                                            </td>
                                            <td class="py-4 px-4">
                                                {l.has_store ? (
                                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">Cliente activo</span>
                                                ) : (
                                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-500/10 text-gray-500 dark:text-slate-400 border border-slate-500/20">Solo lead</span>
                                                )}
                                            </td>
                                            <td class="py-4 px-4 text-sm text-gray-500 dark:text-slate-400">{formatDate(l.created_at)}</td>
                                            <td class="py-4 px-4 max-w-[160px]">
                                                <div class="note-cell" data-email={l.email}>
                                                    <span class="note-preview text-xs text-gray-500 dark:text-slate-400 italic cursor-pointer hover:text-gray-700 dark:text-slate-200 transition-colors" title="Click para editar">
                                                        {notes[l.email] ? notes[l.email].slice(0, 35) + (notes[l.email].length > 35 ? '…' : '') : '—'}
                                                    </span>
                                                    <div class="note-editor hidden mt-1">
                                                        <textarea class="note-textarea w-full bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 text-gray-700 dark:text-slate-200 text-xs rounded px-2 py-1 resize-none focus:outline-none focus:border-violet-500" rows="2" placeholder="Añadir nota...">{notes[l.email] || ''}</textarea>
                                                        <button class="note-save-btn mt-1 px-2 py-1 bg-violet-600/20 text-violet-400 border border-violet-500/20 rounded text-xs hover:bg-violet-600/30 transition-colors">Guardar</button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-4 px-4">
                                                {l.email === user.email ? (
                                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-600/20 text-gray-500 dark:text-slate-400 border border-slate-500/20">Tú mismo</span>
                                                ) : (
                                                    <div class="flex flex-wrap gap-2">
                                                        <button class="lead-reset-pwd-btn px-3 py-1.5 bg-blue-600/20 text-blue-400 border border-blue-500/20 rounded-lg text-xs font-medium hover:bg-blue-600/30 transition-colors"
                                                            data-email={l.email}>
                                                            Resetear contraseña
                                                        </button>
                                                        {!l.email_verified && (
                                                            <button class="lead-resend-btn px-3 py-1.5 bg-amber-600/20 text-amber-400 border border-amber-500/20 rounded-lg text-xs font-medium hover:bg-amber-600/30 transition-colors"
                                                                data-email={l.email}>
                                                                Reenviar verificación
                                                            </button>
                                                        )}
                                                        <button class="lead-delete-btn px-3 py-1.5 bg-red-600/20 text-red-400 border border-red-500/20 rounded-lg text-xs font-medium hover:bg-red-600/30 transition-colors"
                                                            data-id={l.id} data-email={l.email}>
                                                            Eliminar
                                                        </button>
                                                    </div>
                                                )}
                                            </td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════ Tab: Tickets ═══════════ -->
        <div id="tab-tickets" class="tab-content hidden">
            <div class="p-6 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <div class="flex flex-wrap justify-between items-center mb-6 gap-3">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Tickets de Soporte</h2>
                    <div class="flex flex-wrap gap-2 items-center">
                        <input id="ticket-search" type="text" placeholder="Buscar email o asunto..." class="bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-slate-300 text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-violet-500 w-48" />
                        <select id="ticket-filter" class="bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-slate-300 text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-violet-500">
                            <option value="" class="bg-gray-100 dark:bg-slate-800">Todos</option>
                            <option value="open" class="bg-gray-100 dark:bg-slate-800">Abiertos</option>
                            <option value="in_progress" class="bg-gray-100 dark:bg-slate-800">En Progreso</option>
                            <option value="resolved" class="bg-gray-100 dark:bg-slate-800">Resueltos</option>
                        </select>
                        <button id="btn-delete-resolved-tickets" class="px-3 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg text-sm font-medium transition-colors border border-red-500/20">
                            🗑 Limpiar Resueltos
                        </button>
                        <button id="btn-refresh-tickets" class="px-4 py-2 bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:bg-white/10 text-gray-600 dark:text-slate-300 rounded-lg text-sm font-medium transition-colors border border-gray-200 dark:border-white/10">
                            ↻ Actualizar
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Ticket List -->
                    <div id="ticket-list-panel" class="lg:col-span-1 space-y-3 max-h-[600px] overflow-y-auto pr-2">
                        {tickets.length === 0 ? (
                            <div class="text-center py-8 text-gray-500 dark:text-slate-400">
                                No hay tickets de soporte.
                            </div>
                        ) : (
                            tickets.map((ticket: any) => (
                                <button
                                    class={`ticket-item w-full text-left p-4 rounded-xl border transition-all bg-gray-100 dark:bg-black/20 border-gray-200 dark:border-white/10 hover:border-gray-300 dark:border-white/20 ${!ticket.read_by_admin ? 'ring-1 ring-violet-500/50' : ''}`}
                                    data-ticket-id={ticket.id}
                                >
                                    <div class="flex justify-between items-start mb-1">
                                        <h3 class="font-medium text-gray-900 dark:text-white line-clamp-1 text-sm">{ticket.subject}</h3>
                                        {!ticket.read_by_admin && (
                                            <span class="ml-2 w-2 h-2 bg-violet-500 rounded-full flex-shrink-0 mt-1.5"></span>
                                        )}
                                    </div>
                                    <p class="text-xs text-gray-500 dark:text-slate-400 line-clamp-1 mb-2">{ticket.customer_email}</p>
                                    <div class="flex items-center justify-between">
                                        {ticket.status === 'open' ? (
                                            <span class="px-2 py-0.5 bg-yellow-500/10 text-yellow-400 text-[10px] rounded-full border border-yellow-500/20 font-medium">Abierto</span>
                                        ) : ticket.status === 'in_progress' ? (
                                            <span class="px-2 py-0.5 bg-blue-500/10 text-blue-400 text-[10px] rounded-full border border-blue-500/20 font-medium">En Progreso</span>
                                        ) : (
                                            <span class="px-2 py-0.5 bg-green-500/10 text-green-400 text-[10px] rounded-full border border-green-500/20 font-medium">Resuelto</span>
                                        )}
                                        <div class="flex items-center gap-2">
                                            {ticket.priority === 'urgent' && (
                                                <span class="px-2 py-0.5 bg-red-500/10 text-red-400 text-[10px] rounded-full border border-red-500/20 font-medium">Urgente</span>
                                            )}
                                            {ticket.priority === 'high' && (
                                                <span class="px-2 py-0.5 bg-orange-500/10 text-orange-400 text-[10px] rounded-full border border-orange-500/20 font-medium">Alta</span>
                                            )}
                                            <span class="text-[10px] text-gray-400 dark:text-slate-500">
                                                {formatDate(ticket.created_at || ticket.createdAt)}
                                            </span>
                                        </div>
                                    </div>
                                </button>
                            ))
                        )}
                    </div>

                    <!-- Ticket Detail Panel -->
                    <div id="ticket-detail-panel" class="lg:col-span-2 bg-gray-100 dark:bg-black/20 rounded-xl border border-gray-200 dark:border-white/10 flex flex-col h-[600px]">
                        <div id="ticket-empty-state" class="flex-1 flex items-center justify-center text-gray-400 dark:text-slate-500">
                            Selecciona un ticket para ver los detalles
                        </div>
                        <div id="ticket-detail-content" class="hidden flex flex-col h-full">
                            <!-- Header -->
                            <div class="p-4 border-b border-gray-200 dark:border-white/10 flex justify-between items-start">
                                <div>
                                    <h3 id="ticket-subject" class="text-lg font-bold text-gray-900 dark:text-white"></h3>
                                    <div class="flex items-center gap-2 mt-0.5">
                                        <p id="ticket-email" class="text-sm text-gray-500 dark:text-slate-400"></p>
                                        <span id="customer-online-dot" class="hidden w-2.5 h-2.5 bg-green-500 rounded-full shadow-[0_0_6px_rgba(34,197,94,0.6)]" title="En línea"></span>
                                    </div>
                                    <p id="ticket-id-display" class="text-xs text-gray-400 dark:text-slate-500 mt-0.5"></p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <select id="ticket-status-select" class="bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-slate-300 text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:border-violet-500">
                                        <option value="open" class="bg-gray-100 dark:bg-slate-800">Abierto</option>
                                        <option value="in_progress" class="bg-gray-100 dark:bg-slate-800">En Progreso</option>
                                        <option value="resolved" class="bg-gray-100 dark:bg-slate-800">Resuelto</option>
                                    </select>
                                    <button id="btn-delete-current-ticket" class="px-2 py-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg text-xs transition-colors border border-red-500/20" title="Eliminar ticket">
                                        🗑
                                    </button>
                                </div>
                            </div>

                            <!-- Messages -->
                            <div id="ticket-messages" class="flex-1 p-4 overflow-y-auto space-y-4">
                            </div>

                            <!-- Typing indicator -->
                            <div id="typing-indicator" class="hidden px-4 py-2 text-sm text-gray-500 dark:text-slate-400 italic">
                                <span class="inline-flex items-center gap-1">
                                    <span class="flex gap-0.5">
                                        <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
                                        <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                                        <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
                                    </span>
                                    El cliente está escribiendo...
                                </span>
                            </div>
                            <!-- Reply Box -->
                            <div class="p-4 border-t border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-slate-900/50 rounded-b-xl">
                                <form id="admin-reply-form" class="flex gap-2">
                                    <input
                                        type="text"
                                        id="admin-reply-input"
                                        placeholder="Escribe tu respuesta..."
                                        class="flex-1 bg-gray-100 dark:bg-black/40 border border-slate-700 rounded-lg px-4 py-2 text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500"
                                    />
                                    <button
                                        type="submit"
                                        id="admin-reply-btn"
                                        class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium disabled:opacity-50 transition-colors"
                                    >
                                        Enviar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
  </main>

    <!-- Create Store Modal -->
    <div id="create-store-modal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
        <div class="bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-white/10 rounded-2xl p-6 w-full max-w-lg">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Crear Nueva Tienda</h3>
            <form id="create-store-form" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Nombre de la tienda *</label>
                        <input type="text" id="cs-name" required class="w-full px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" placeholder="Mi Tienda" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Subdominio *</label>
                        <div class="flex">
                            <input type="text" id="cs-subdomain" required class="flex-1 px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-l-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" placeholder="mitienda" />
                            <span class="px-3 py-2 bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-white/10 border-l-0 rounded-r-lg text-gray-500 dark:text-slate-400 text-sm">.neonhub.es</span>
                        </div>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Plan</label>
                    <select id="cs-plan" class="w-full px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500">
                        <option value="starter">Starter (499€)</option>
                        <option value="installation">Instalación (999€)</option>
                        <option value="enterprise">Enterprise (1.499€)</option>
                    </select>
                </div>
                <hr class="border-gray-200 dark:border-white/10" />
                <p class="text-sm text-gray-500 dark:text-slate-400">Datos del propietario (CEO)</p>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Email propietario *</label>
                        <input type="email" id="cs-email" required class="w-full px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" placeholder="owner@email.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Contraseña (opcional)</label>
                        <input type="text" id="cs-password" class="w-full px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" placeholder="Se genera automáticamente" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Nombre</label>
                        <input type="text" id="cs-firstname" class="w-full px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 dark:text-slate-300 mb-1">Apellidos</label>
                        <input type="text" id="cs-lastname" class="w-full px-3 py-2 bg-gray-100 dark:bg-black/40 border border-gray-200 dark:border-white/10 rounded-lg text-gray-900 dark:text-white text-sm focus:outline-none focus:border-violet-500" />
                    </div>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" id="cs-cancel" class="px-4 py-2 bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:bg-white/10 text-gray-600 dark:text-slate-300 rounded-lg text-sm transition-colors border border-gray-200 dark:border-white/10">Cancelar</button>
                    <button type="submit" id="cs-submit" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">Crear Tienda</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Store Delete Confirmation Modal -->
    <div id="store-delete-modal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
        <div class="bg-gray-50 dark:bg-slate-900 border border-red-500/30 rounded-2xl p-6 w-full max-w-md">
            <h3 class="text-xl font-bold text-red-400 mb-1">⚠️ Eliminar tienda "<span id="sdm-store-name"></span>"</h3>
