    <div id="generic-confirm-modal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
        <div class="bg-gray-50 dark:bg-slate-900 border rounded-2xl p-6 w-full max-w-md gcm-border">
            <h3 id="gcm-title" class="text-xl font-bold mb-2"></h3>
            <p id="gcm-message" class="text-sm text-gray-600 dark:text-slate-300 mb-6"></p>
            <div class="flex gap-3 justify-end">
                <button id="gcm-cancel" class="px-4 py-2 bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:hover:bg-white/10 text-gray-600 dark:text-slate-300 rounded-lg text-sm transition-colors border border-gray-200 dark:border-white/10">
