  // Sort role header toggle (ascending/descending)  
  let roleSortAsc = true;
  document.getElementById('sort-role-header')?.addEventListener('click', () => {
      const tbody = document.getElementById('users-table-body');
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll('.user-row'));
      const priority: Record<string, number> = { ceo_neonhub: 0, ceo: 1, admin: 2, manager: 3, employee: 4, viewer: 5, customer: 6 };
      rows.sort((a, b) => {
          const rA = (a as HTMLElement).dataset.role || 'zzz';
          const rB = (b as HTMLElement).dataset.role || 'zzz';
          const diff = (priority[rA] ?? 99) - (priority[rB] ?? 99);
          return roleSortAsc ? -diff : diff;
      });
      roleSortAsc = !roleSortAsc;
      rows.forEach(r => tbody.appendChild(r));
      const header = document.getElementById('sort-role-header');
      if (header) header.textContent = `Rol ${roleSortAsc ? '↕' : '↕'}`;
  });

