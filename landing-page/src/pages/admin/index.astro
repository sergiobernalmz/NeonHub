                                            <td class="py-4 px-4">
                                                <p class="text-gray-900 dark:text-white font-medium">{req.payload?.tenant_name || '—'}</p>
                                                <p class="text-xs text-gray-500 dark:text-slate-400">{req.payload?.subdomain ? `${req.payload.subdomain}.neonhub.es` : '—'}</p>
                                            </td>
                                            <td class="py-4 px-4">
                                                <p class="text-gray-600 dark:text-slate-300 text-sm">{req.payload?.owner_email || '—'}</p>
                                                <p class="text-xs text-gray-400 dark:text-slate-500">{req.payload?.owner_first_name || ''} {req.payload?.owner_last_name || ''}</p>
                                            </td>
                                            <td class="py-4 px-4">
                                                <span class="text-sm text-gray-600 dark:text-slate-300">{req.payload?.plan_id || '—'}</span>
                                            </td>
                                            <td class="py-4 px-4 text-sm text-gray-500 dark:text-slate-400">
                                                {formatDate(req.created_at)}
