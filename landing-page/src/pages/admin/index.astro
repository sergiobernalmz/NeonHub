  // ── New Lead modal — real-time validation helpers ────────────────────────────
  function nlSetError(errId: string, inpId: string, msg: string) {
      const errEl = document.getElementById(errId)!;
      const inp = document.getElementById(inpId) as HTMLInputElement;
      errEl.textContent = msg;
      errEl.classList.toggle('hidden', !msg);
      if (inp) inp.style.borderColor = msg ? '#ef4444' : (inp.value ? '#22c55e' : '');
  }

  function nlUpdateStrength(password: string) {
      const wrap = document.getElementById('nl-strength-wrap')!;
      const fill = document.getElementById('nl-strength-fill') as HTMLElement;
      const label = document.getElementById('nl-strength-label')!;
      const bits = document.getElementById('nl-strength-bits')!;
      if (!password) { wrap.classList.add('hidden'); return; }
      wrap.classList.remove('hidden');
      const entropy = calcPasswordEntropy(password);
      const s = getPasswordStrength(entropy);
      fill.style.width = Math.min((entropy / 128) * 100, 100) + '%';
      fill.style.background = s.color;
      label.textContent = s.label;
      (label as HTMLElement).style.color = s.color;
      bits.textContent = entropy + ' bits';
  }

  function nlValidate(): boolean {
      let ok = true;
      const u = (document.getElementById('new-lead-username') as HTMLInputElement).value.trim();
      const e = (document.getElementById('new-lead-email') as HTMLInputElement).value.trim();
      const p = (document.getElementById('new-lead-password') as HTMLInputElement).value;

      if (u && !validateUsername(u)) {
          nlSetError('nl-err-username', 'new-lead-username', 'Entre 3 y 30 caracteres, solo letras, números y _');
          ok = false;
      } else { nlSetError('nl-err-username', 'new-lead-username', ''); }

      if (e && !validateEmail(e)) {
          nlSetError('nl-err-email', 'new-lead-email', 'Introduce un email válido');
          ok = false;
      } else { nlSetError('nl-err-email', 'new-lead-email', ''); }

      if (p) {
          if (p.length < 8) {
              nlSetError('nl-err-password', 'new-lead-password', 'Mínimo 8 caracteres');
              ok = false;
          } else if (!validatePassword(p)) {
              nlSetError('nl-err-password', 'new-lead-password', 'Contraseña demasiado débil');
              ok = false;
          } else { nlSetError('nl-err-password', 'new-lead-password', ''); }
      }

      const allFilled = u && e && p;
      const confirmBtn = document.getElementById('new-lead-confirm') as HTMLButtonElement;
      if (confirmBtn) confirmBtn.disabled = !ok || !allFilled;
      return ok;
  }

