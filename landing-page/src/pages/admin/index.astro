  let currentModalUserId: string | null = null;

  document.querySelectorAll('.user-row').forEach(row => {
      row.addEventListener('click', async (e) => {
          if ((e.target as HTMLElement).closest('button') || (e.target as HTMLElement).closest('.note-cell')) return;
          const tr = row as HTMLElement;
          const userId = tr.dataset.userId;
          const username = tr.dataset.username || '';
          const email = tr.dataset.email || '';
          const isActive = tr.dataset.active === 'true';
          const since = tr.dataset.since;
          const lockedUntil = tr.dataset.lockedUntil;
          if (!userId) return;

          currentModalUserId = userId;

          const avatarEl = document.getElementById('ud-avatar');
          if (avatarEl) avatarEl.textContent = username.slice(0, 2).toUpperCase() || '??';
          const usernameEl = document.getElementById('ud-username');
          if (usernameEl) usernameEl.textContent = username;
          const emailEl = document.getElementById('ud-email');
          if (emailEl) emailEl.textContent = email;
          const statusEl = document.getElementById('ud-status');
          if (statusEl) {
              statusEl.textContent = isActive ? 'Activo' : 'Inactivo';
              statusEl.className = `px-2 py-0.5 rounded-full text-xs font-medium border ${isActive ? 'bg-green-500/10 text-green-400 border-green-500/20' : 'bg-red-500/10 text-red-400 border-red-500/20'}`;
          }
          const lockBadge = document.getElementById('ud-lock-badge');
          const unlockBtn = document.getElementById('ud-unlock-btn');
          const isLocked = lockedUntil && new Date(lockedUntil) > new Date();
          if (lockBadge) {
              if (isLocked) {
                  const rem = Math.ceil((new Date(lockedUntil!).getTime() - Date.now()) / 60000);
                  lockBadge.textContent = `Bloqueada ${rem} min`;
                  lockBadge.classList.remove('hidden');
              } else {
                  lockBadge.classList.add('hidden');
              }
          }
          if (unlockBtn) {
              if (isLocked) {
                  (unlockBtn as HTMLButtonElement).disabled = false;
                  unlockBtn.textContent = 'Desbloquear cuenta';
                  unlockBtn.classList.remove('hidden');
              } else {
                  unlockBtn.classList.add('hidden');
              }
          }
          const sinceEl = document.getElementById('ud-since');
          if (sinceEl) sinceEl.textContent = since ? `Registrado ${new Date(since).toLocaleDateString('es-ES')}` : '';

          const storesListEl = document.getElementById('ud-stores-list');
          if (storesListEl) storesListEl.innerHTML = '<p class="text-sm text-gray-400 dark:text-slate-500">Cargando...</p>';
          udModal?.classList.remove('hidden');

          try {
              const res = await fetch('/api/admin/users/action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'get-stores', userId })
              });
              const data = await res.json();
              if (!storesListEl) return;
              if (!data.success || !data.data?.length) {
                  storesListEl.innerHTML = '<p class="text-sm text-gray-400 dark:text-slate-500 italic">Sin tiendas asignadas</p>';
                  return;
              }
              const now = new Date();
              storesListEl.innerHTML = data.data.map((s: any) => {
                  const trialEnd = s.trial_ends_at ? new Date(s.trial_ends_at) : null;
                  const isTrial = s.payment_status === 'trial' && trialEnd;
                  const remDays = isTrial ? Math.ceil((trialEnd!.getTime() - now.getTime()) / 86400000) : 0;
                  const roleCls = udRoleColors[s.role_name] || 'bg-gray-500/10 text-gray-400 border-gray-500/20';
                  return `
                  <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10" data-store-id="${s.store_id}">
                      <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-2 flex-wrap mb-0.5">
                              <span class="text-sm font-medium text-gray-900 dark:text-white">${s.store_name}</span>
                              <span class="text-xs text-gray-400 dark:text-slate-500">(${s.subdomain})</span>
                              ${s.role_name ? `<span class="px-1.5 py-0.5 rounded-full text-xs font-medium border ${roleCls}">${s.role_display_name || s.role_name}</span>` : ''}
                          </div>
                          ${isTrial ? `<span class="text-xs ${remDays > 0 ? 'text-blue-400' : 'text-red-400'}">
                              ${remDays > 0 ? `⏳ ${remDays} días restantes` : '⚠️ Trial expirado'}
                              <span class="text-gray-400 dark:text-slate-500"> · hasta ${trialEnd!.toLocaleDateString('es-ES')}</span>
                          </span>` : ''}
                      </div>
                      <button
                          class="ud-remove-btn flex-shrink-0 px-2 py-1 bg-red-500/10 text-red-400 border border-red-500/20 hover:bg-red-500/20 rounded-lg text-xs font-medium transition-colors"
                          data-user-id="${userId}"
                          data-store-id="${s.store_id}"
                          data-store-name="${s.store_name}"
                          data-username="${username}"
                      >Eliminar</button>
                  </div>`;
              }).join('');

              storesListEl.querySelectorAll('.ud-remove-btn').forEach(btn => {
                  btn.addEventListener('click', async () => {
                      const b = btn as HTMLButtonElement;
                      const uid = b.dataset.userId!;
                      const sid = b.dataset.storeId!;
                      const sname = b.dataset.storeName!;
                      const uname = b.dataset.username!;
                      if (!await openConfirmModal(
                          `Quitar a "${uname}" de "${sname}"`,
                          'Perderá el acceso a esta tienda. Su cuenta seguirá existiendo.',
                          'Quitar de la tienda',
                          'red'
                      )) return;
                      b.disabled = true;
                      b.textContent = '...';
                      try {
                          const r = await fetch('/api/admin/users/action', {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json' },
                              body: JSON.stringify({ action: 'remove-from-store', userId: uid, storeId: sid })
                          });
                          const rd = await r.json();
                          if (rd.success) {
                              showToast(`"${uname}" eliminado de "${sname}"`);
                              b.closest('[data-store-id]')?.remove();
                              if (!storesListEl.querySelector('[data-store-id]')) {
                                  storesListEl.innerHTML = '<p class="text-sm text-gray-400 dark:text-slate-500 italic">Sin tiendas asignadas</p>';
                              }
                          } else {
                              showToast(rd.message || 'Error al eliminar', 'error');
                              b.disabled = false;
                              b.textContent = 'Eliminar';
                          }
                      } catch {
                          showToast('Error de conexión', 'error');
                          b.disabled = false;
                          b.textContent = 'Eliminar';
                      }
                  });
              });
          } catch {
              if (storesListEl) storesListEl.innerHTML = '<p class="text-sm text-red-400">Error al cargar tiendas</p>';
          }
      });
  });

  document.getElementById('ud-close')?.addEventListener('click', () => udModal?.classList.add('hidden'));
  udModal?.addEventListener('click', (e) => { if (e.target === udModal) udModal?.classList.add('hidden'); });

  document.getElementById('ud-unlock-btn')?.addEventListener('click', async () => {
      if (!currentModalUserId) return;
      const btn = document.getElementById('ud-unlock-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Desbloqueando...';
      try {
          const r = await fetch('/api/admin/users/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'unlock', userId: currentModalUserId })
          });
          const d = await r.json();
          if (d.success) {
              showToast('Cuenta desbloqueada correctamente', 'success');
              const lockBadge = document.getElementById('ud-lock-badge');
              if (lockBadge) lockBadge.classList.add('hidden');
              btn.classList.add('hidden');
          } else {
              showToast(d.message || 'Error al desbloquear', 'error');
              btn.disabled = false; btn.textContent = 'Desbloquear cuenta';
          }
      } catch { showToast('Error de red', 'error'); btn.disabled = false; btn.textContent = 'Desbloquear cuenta'; }
  });

  // ═══════════════════════════════════════════════
  // Plan Edit Modal
  // ═══════════════════════════════════════════════
  let planEditStoreId: string | null = null;

  function openPlanEditModal(storeId: string, storeName: string, currentPlan: string) {
      planEditStoreId = storeId;
      const modal = document.getElementById('plan-edit-modal');
      const nameEl = document.getElementById('pe-store-name');
      if (nameEl) {
          const planNames: Record<string, string> = { starter: 'Esencial', installation: 'Profesional', enterprise: 'Premium' };
          nameEl.textContent = `${storeName} — Plan actual: ${planNames[currentPlan] || currentPlan || 'Sin definir'}`;
      }
      // Pre-select current plan
      const radio = document.querySelector<HTMLInputElement>(`input[name="plan-choice"][value="${currentPlan}"]`);
      if (radio) radio.checked = true;
      modal?.classList.remove('hidden');
  }

  document.getElementById('pe-close')?.addEventListener('click', () => {
      document.getElementById('plan-edit-modal')?.classList.add('hidden');
      planEditStoreId = null;
  });

  document.getElementById('pe-save')?.addEventListener('click', async () => {
      if (!planEditStoreId) return;
      const selected = document.querySelector<HTMLInputElement>('input[name="plan-choice"]:checked');
      if (!selected) { showToast('Selecciona un plan', 'error'); return; }

      const saveBtn = document.getElementById('pe-save') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'update-plan', storeId: planEditStoreId, plan_id: selected.value })
          });
          const data = await res.json();
          if (data.success) {
              showToast(data.message || 'Plan actualizado correctamente');
              document.getElementById('plan-edit-modal')?.classList.add('hidden');
              planEditStoreId = null;
              setTimeout(() => window.location.reload(), 800);
          } else {
              showToast(data.message || 'Error al actualizar plan', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Actualizar Plan';
      }
  });

  // botones de edición del plan (al hacer clic en el texto del plan en la tabla)
  document.querySelectorAll('.plan-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = e.currentTarget as HTMLElement;
          openPlanEditModal(target.dataset.id || '', target.dataset.name || '', target.dataset.plan || '');
      });
  });

  // Manage store buttons
  document.querySelectorAll('.manage-store-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = e.currentTarget as HTMLElement;
          openStoreDetail(target.dataset.id || '');
      });
  });

  // ═══════════════════════════════════════════════
  // Store Detail Modal
  // ═══════════════════════════════════════════════
  const storeDetailModal = document.getElementById('store-detail-modal');
  const storeDetailClose = document.getElementById('store-detail-close');
  const storeDetailLoading = document.getElementById('store-detail-loading');
  const storeDetailContent = document.getElementById('store-detail-content');

  const roleColorMap: Record<string, string> = {
      ceo_neonhub: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
      ceo: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
      admin: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
      manager: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
      employee: 'bg-slate-500/10 text-gray-600 dark:text-slate-300 border-slate-500/20',
      viewer: 'bg-gray-500/10 text-gray-400 border-gray-500/20',
      customer: 'bg-pink-500/10 text-pink-400 border-pink-500/20'
  };

  function formatDateShort(d: string | null) {
      if (!d) return '—';
      return new Date(d).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  async function openStoreDetail(storeId: string) {
      if (!storeDetailModal) return;
      currentStoreDetailId = storeId;
      storeDetailModal.classList.remove('hidden');
      storeDetailLoading?.classList.remove('hidden');
      storeDetailContent?.classList.add('hidden');

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'detail', storeId })
          });
          const result = await res.json();

          if (result.success && result.data) {
              const { store, users: storeUsers, stats } = result.data;

              const isDemo = store.subdomain === 'demo';
              document.getElementById('sd-change-plan-btn')?.classList.toggle('hidden', isDemo);
              document.getElementById('sd-add-user-btn')?.classList.toggle('hidden', isDemo);
              document.getElementById('sd-demo-banner')?.classList.toggle('hidden', !isDemo);

              const titleEl = document.getElementById('store-detail-title');
              if (titleEl) titleEl.textContent = `${store.name} — ${store.subdomain}.neonhub.es`;

              // Plan label in quick plan section
              const planNames: Record<string, string> = { starter: 'Esencial', installation: 'Profesional', enterprise: 'Premium' };
              const planLabelEl = document.getElementById('sd-current-plan-label');
              if (planLabelEl) {
                  const pn = planNames[store.plan_id] || store.plan_id || 'Sin plan';
                  const price = store.plan_price_cents ? ` — ${(store.plan_price_cents / 100).toFixed(2)} €/mes` : '';
                  planLabelEl.textContent = `${pn}${price}`;
              }
              const changePlanBtn = document.getElementById('sd-change-plan-btn');
              if (changePlanBtn) {
                  changePlanBtn.onclick = () => {
                      closeStoreDetail();
                      openPlanEditModal(store.id, store.name, store.plan_id || '');
                  };
              }

              // Stats
              const setCount = (id: string, val: number) => {
                  const el = document.getElementById(id);
                  if (el) el.textContent = String(val);
              };
              setCount('sd-users', stats.userCount);
              setCount('sd-customers', stats.customerCount);
              setCount('sd-products', stats.productCount);
              setCount('sd-orders', stats.orderCount);
              setCount('sd-categories', stats.categoryCount);

              // Store info
              const infoEl = document.getElementById('sd-info');
              if (infoEl) {
                  const planLabel = store.plan_id || 'Sin plan';
                  const priceLabel = store.plan_price_cents ? `${(store.plan_price_cents / 100).toFixed(2)} €/mes` : '—';
                  const statusLabel = store.paused_at ? '⏸ Pausada' : store.is_active ? '✅ Activa' : '❌ Inactiva';
                  const paymentLabel = store.payment_status || '—';
                  const nextPayLabel = store.next_payment_date ? formatDateShort(store.next_payment_date) : '—';
                  const createdLabel = formatDateShort(store.created_at);

                  infoEl.innerHTML = `
                      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
                          <div><span class="text-gray-500 dark:text-slate-400">Plan:</span> <span class="text-gray-900 dark:text-white font-medium ml-1">${escapeHtml(planLabel)}</span></div>
                          <div><span class="text-gray-500 dark:text-slate-400">Precio:</span> <span class="text-gray-900 dark:text-white font-medium ml-1">${escapeHtml(priceLabel)}</span></div>
                          <div><span class="text-gray-500 dark:text-slate-400">Estado:</span> <span class="text-gray-900 dark:text-white font-medium ml-1">${statusLabel}</span></div>
                          <div><span class="text-gray-500 dark:text-slate-400">Pago:</span> <span class="text-gray-900 dark:text-white font-medium ml-1">${escapeHtml(paymentLabel)}</span></div>
                          <div><span class="text-gray-500 dark:text-slate-400">Próx. pago:</span> <span class="text-gray-900 dark:text-white font-medium ml-1">${escapeHtml(nextPayLabel)}</span></div>
                          <div><span class="text-gray-500 dark:text-slate-400">Creada:</span> <span class="text-gray-900 dark:text-white font-medium ml-1">${escapeHtml(createdLabel)}</span></div>
                      </div>
                  `;
              }

              // Split users: employees vs customers
              const employeeUsers = (storeUsers || []).filter((u: any) => !u.roles?.some((r: any) => r.name === 'customer'));
              const customerUsers = (storeUsers || []).filter((u: any) => u.roles?.some((r: any) => r.name === 'customer'));

              const empCountEl = document.getElementById('sd-emp-count');
              const custCountEl = document.getElementById('sd-cust-count');
              if (empCountEl) empCountEl.textContent = `(${employeeUsers.length})`;
              if (custCountEl) custCountEl.textContent = `(${customerUsers.length})`;

              // Store detail tab switching
              const sdCurrentStore = { id: storeId, customersLoaded: false };
              document.querySelectorAll('.sd-tab-btn').forEach((btn: Element) => {
                  btn.addEventListener('click', () => {
                      const target = (btn as HTMLElement).dataset.sdtab;
                      document.querySelectorAll('.sd-tab-btn').forEach(b => {
                          b.classList.remove('active', 'bg-violet-600/20', 'text-violet-300', 'border-violet-500/30');
                          b.classList.add('text-slate-400', 'border-white/10');
                      });
                      btn.classList.add('active', 'bg-violet-600/20', 'text-violet-300', 'border-violet-500/30');
                      btn.classList.remove('text-slate-400', 'border-white/10');
                      document.querySelectorAll('.sd-tab-panel').forEach(p => p.classList.add('hidden'));
                      document.getElementById(`sd-tab-${target}`)?.classList.remove('hidden');
                      if (target === 'customers' && !sdCurrentStore.customersLoaded) {
                          sdCurrentStore.customersLoaded = true;
                          loadStoreCustomers(sdCurrentStore.id);
                      }
                  });
              });

              // Employees table
              const usersTableEl = document.getElementById('sd-users-table');
              if (usersTableEl) {
                  if (employeeUsers.length === 0) {
                      usersTableEl.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-gray-500 dark:text-slate-400 text-sm">No hay empleados en esta tienda.</td></tr>';
                  } else {
                      usersTableEl.innerHTML = employeeUsers.map((u: any) => {
                          const roleBadges = u.roles?.length > 0
                              ? u.roles.map((r: any) => {
                                  const colors = roleColorMap[r.name] || 'bg-violet-500/10 text-violet-400 border-violet-500/20';
                                  return `<span class="px-2 py-0.5 rounded-full text-xs font-medium border ${colors}">${escapeHtml(r.display_name || r.name)}</span>`;
                              }).join(' ')
                              : '<span class="text-gray-400 dark:text-slate-500 text-xs">—</span>';
                          const statusBadge = u.is_active
                              ? '<span class="px-2 py-0.5 rounded-full text-xs bg-green-500/10 text-green-400 border border-green-500/20">Activo</span>'
                              : '<span class="px-2 py-0.5 rounded-full text-xs bg-red-500/10 text-red-400 border border-red-500/20">Inactivo</span>';
                          const userData = JSON.stringify({ id: u.id, username: u.username, email: u.email, first_name: u.first_name || '', last_name: u.last_name || '', store_id: u.store_id, role: u.roles?.[0]?.name || '' }).replace(/"/g, '&quot;');
                          return `<tr class="hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                              <td class="py-3 px-3"><p class="text-gray-900 dark:text-white text-sm font-medium">${escapeHtml(u.username)}</p>${u.first_name || u.last_name ? `<p class="text-xs text-gray-500 dark:text-slate-400">${escapeHtml((u.first_name || '') + ' ' + (u.last_name || ''))}</p>` : ''}</td>
                              <td class="py-3 px-3 text-sm text-gray-600 dark:text-slate-300">${escapeHtml(u.email)}</td>
                              <td class="py-3 px-3">${roleBadges}</td>
                              <td class="py-3 px-3">${statusBadge}</td>
                              <td class="py-3 px-3 text-xs text-gray-500 dark:text-slate-400">${formatDateShort(u.created_at)}</td>
                              <td class="py-3 px-3 text-right">
                                  <div class="flex gap-1 justify-end">
                                      <button class="sd-edit-user px-2 py-1 bg-blue-600/20 text-blue-400 border border-blue-500/20 rounded-lg text-[10px] font-medium hover:bg-blue-600/30 transition-colors" data-user="${userData}">Editar</button>
                                      <button class="sd-delete-user px-2 py-1 bg-red-600/20 text-red-400 border border-red-500/20 rounded-lg text-[10px] font-medium hover:bg-red-600/30 transition-colors" data-id="${u.id}" data-name="${escapeHtml(u.username)}">Eliminar</button>
                                  </div>
                              </td>
                          </tr>`;
                      }).join('');

                      usersTableEl.querySelectorAll('.sd-edit-user').forEach((btn: Element) => {
                          btn.addEventListener('click', () => {
                              const data = JSON.parse((btn as HTMLElement).dataset.user || '{}');
                              closeStoreDetail();
                              openUserModal(data);
                          });
                      });
                      usersTableEl.querySelectorAll('.sd-delete-user').forEach((btn: Element) => {
                          btn.addEventListener('click', async () => {
                              const target = btn as HTMLButtonElement;
                              const userId = target.dataset.id;
                              const userName = target.dataset.name;
                              if (!userId) return;
                              if (!await openConfirmModal(
                                  `Eliminar a "${userName}"`,
                                  'Se eliminará el usuario y todos sus datos. Esta acción no se puede deshacer.',
                                  'Eliminar permanentemente',
                                  'red'
                              )) return;
                              target.disabled = true;
                              try {
                                  const res = await fetch('/api/admin/users/action', {
                                      method: 'POST',
                                      headers: { 'Content-Type': 'application/json' },
                                      body: JSON.stringify({ action: 'delete', userId })
                                  });
                                  const result = await res.json();
                                  if (result.success) {
                                      showToast('Usuario eliminado');
                                      closeStoreDetail();
                                      setTimeout(() => window.location.reload(), 800);
                                  } else {
                                      showToast(result.message || 'Error al eliminar', 'error');
                                      target.disabled = false;
                                  }
                              } catch {
                                  showToast('Error de conexión', 'error');
                                  target.disabled = false;
                              }
                          });
                      });
                  }
              }

              // cargamos el historial de pagos
              loadPayments(storeId);

              // mostramos la sección enterprise solo para tiendas enterprise/premium
              const enterpriseSection = document.getElementById('sd-enterprise-section');
              if (enterpriseSection) {
                  const planLower = (store.plan_id || '').toLowerCase();
                  if (planLower === 'enterprise' || planLower === 'premium') {
                      enterpriseSection.classList.remove('hidden');
                  } else {
                      enterpriseSection.classList.add('hidden');
                  }
              }

              storeDetailLoading?.classList.add('hidden');
              storeDetailContent?.classList.remove('hidden');
          } else {
              showToast(result.message || 'Error cargando detalle', 'error');
              storeDetailModal.classList.add('hidden');
          }
      } catch {
          showToast('Error de conexión', 'error');
          storeDetailModal.classList.add('hidden');
      }
  }

  function closeStoreDetail() {
      storeDetailModal?.classList.add('hidden');
  }

  async function loadStoreCustomers(storeId: string) {
      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'get-customers', storeId })
          });
          const result = await res.json();
          if (!result.success) { return; }
          const { user_customers, customer_records } = result.data;

          // Sección A: clientes registrados (usuarios con login)
          const cuTbody = document.getElementById('sd-customer-users-table');
          if (cuTbody) {
              if (!user_customers?.length) {
                  cuTbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-gray-400 dark:text-slate-500 text-xs">No hay clientes registrados.</td></tr>';
              } else {
                  cuTbody.innerHTML = user_customers.map((u: any) => {
                      const statusBadge = u.is_active
                          ? '<span class="px-2 py-0.5 rounded-full text-xs bg-green-500/10 text-green-400 border border-green-500/20">Activo</span>'
                          : '<span class="px-2 py-0.5 rounded-full text-xs bg-red-500/10 text-red-400 border border-red-500/20">Inactivo</span>';
                      return `<tr class="hover:bg-gray-100 dark:hover:bg-white/10">
                          <td class="py-3 px-3"><p class="text-gray-900 dark:text-white text-sm font-medium">${escapeHtml(u.first_name || u.username || '')} ${escapeHtml(u.last_name || '')}</p></td>
                          <td class="py-3 px-3 text-sm text-gray-600 dark:text-slate-300">${escapeHtml(u.email)}</td>
                          <td class="py-3 px-3 text-xs text-gray-500 dark:text-slate-400">${formatDateShort(u.created_at)}</td>
                          <td class="py-3 px-3">${statusBadge}</td>
                          <td class="py-3 px-3 text-right">
                              <button class="sd-delete-user px-2 py-1 bg-red-600/20 text-red-400 border border-red-500/20 rounded-lg text-[10px] font-medium hover:bg-red-600/30 transition-colors" data-id="${u.id}" data-name="${escapeHtml(u.username || u.email)}">Eliminar</button>
                          </td>
                      </tr>`;
                  }).join('');
                  cuTbody.querySelectorAll('.sd-delete-user').forEach((btn: Element) => {
                      btn.addEventListener('click', async () => {
                          const target = btn as HTMLButtonElement;
                          const userId = target.dataset.id;
                          const userName = target.dataset.name;
                          if (!userId) return;
                          if (!await openConfirmModal(
                                  `Eliminar a "${userName}"`,
                                  'Se eliminará el usuario y todos sus datos. Esta acción no se puede deshacer.',
                                  'Eliminar permanentemente',
                                  'red'
                              )) return;
                          target.disabled = true;
                          const r = await fetch('/api/admin/users/action', {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json' },
                              body: JSON.stringify({ action: 'delete', userId })
                          }).then(r => r.json()).catch(() => ({ success: false }));
                          if (r.success) { showToast('Cliente eliminado'); target.closest('tr')?.remove(); }
                          else { showToast(r.message || 'Error', 'error'); target.disabled = false; }
                      });
                  });
              }
          }

          // Section B: B2B customer records
          const crTbody = document.getElementById('sd-customer-records-table');
          if (crTbody) {
              if (!customer_records?.length) {
                  crTbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-gray-400 dark:text-slate-500 text-xs">No hay fichas de clientes.</td></tr>';
              } else {
                  crTbody.innerHTML = customer_records.map((c: any) => {
                      const statusBadge = c.is_active
                          ? '<span class="px-2 py-0.5 rounded-full text-xs bg-green-500/10 text-green-400 border border-green-500/20">Activo</span>'
                          : '<span class="px-2 py-0.5 rounded-full text-xs bg-red-500/10 text-red-400 border border-red-500/20">Inactivo</span>';
                      return `<tr class="hover:bg-gray-100 dark:hover:bg-white/10">
                          <td class="py-3 px-3 text-sm text-gray-900 dark:text-white">${escapeHtml(c.first_name || '')} ${escapeHtml(c.last_name || '')}</td>
                          <td class="py-3 px-3 text-sm text-gray-600 dark:text-slate-300">${escapeHtml(c.email || '—')}</td>
                          <td class="py-3 px-3 text-xs text-gray-500 dark:text-slate-400 font-mono">${escapeHtml(c.customer_code || '—')}</td>
                          <td class="py-3 px-3 text-xs text-gray-500 dark:text-slate-400">${escapeHtml(c.company_name || '—')}</td>
                          <td class="py-3 px-3 text-xs text-gray-500 dark:text-slate-400 text-center">${c.order_count ?? 0}</td>
                          <td class="py-3 px-3">${statusBadge}</td>
                      </tr>`;
                  }).join('');
              }
          }
      } catch {
          showToast('Error cargando clientes', 'error');
      }
  }

  storeDetailClose?.addEventListener('click', closeStoreDetail);
  storeDetailModal?.addEventListener('click', (e) => { if (e.target === storeDetailModal) closeStoreDetail(); });

  let currentStoreDetailId: string | null = null;

  document.getElementById('sd-add-user-btn')?.addEventListener('click', () => {
      if (!currentStoreDetailId) return;
      closeStoreDetail();
      openUserModal();
      // preseleccionamos la tienda en el formulario de usuario
      const storeSelect = document.getElementById('user-form-store') as HTMLSelectElement;
      if (storeSelect) storeSelect.value = currentStoreDetailId;
  });

  // El detalle de tienda se abre unicamente desde el boton "Gestionar"
  // (manejado arriba, junto al resto de botones de accion). Anteriormente
  // toda la fila era clicable, lo que hacia que pulsar en un espacio en blanco
  // o en el nombre abriera el modal sin querer.

  // ═══════════════════════════════════════════════
  // Payment History
  // ═══════════════════════════════════════════════
  async function loadPayments(storeId: string) {
      const summaryEl = document.getElementById('sd-payment-summary');
      const tableEl = document.getElementById('sd-payments-table');
      if (!summaryEl || !tableEl) return;

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'get-payments', storeId })
          });
          const result = await res.json();

          if (result.success) {
              const { payments, summary } = result.data;

              summaryEl.innerHTML = `
                  <div class="p-3 rounded-lg bg-green-500/10 border border-green-500/20">
                      <p class="text-xs text-green-400">Total Pagado</p>
                      <p class="text-lg font-bold text-green-300">${escapeHtml(summary.total_paid_formatted)}</p>
                  </div>
                  <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20">
                      <p class="text-xs text-blue-400">Nº de Pagos</p>
                      <p class="text-lg font-bold text-blue-300">${summary.total_payments}</p>
                  </div>
              `;

              if (!payments || payments.length === 0) {
                  tableEl.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-gray-500 dark:text-slate-400 text-sm">No hay pagos registrados.</td></tr>';
              } else {
                  tableEl.innerHTML = payments.map((p: any) => `<tr class="hover:bg-gray-100 dark:hover:bg-white/10">
                      <td class="py-2 px-3 text-sm text-gray-900 dark:text-white">${escapeHtml(p.payment_date || formatDateShort(p.created_at))}</td>
                      <td class="py-2 px-3 text-sm text-gray-600 dark:text-slate-300">${escapeHtml(p.concept)}</td>
                      <td class="py-2 px-3 text-sm text-green-400 font-medium">${(p.amount_cents / 100).toFixed(2)} €</td>
                      <td class="py-2 px-3 text-sm text-gray-500 dark:text-slate-400">${escapeHtml(p.payment_method || '—')}</td>
                      <td class="py-2 px-3 text-right">
                          <button class="delete-payment-btn px-2 py-1 bg-red-600/20 text-red-400 border border-red-500/20 rounded-lg text-[10px] font-medium hover:bg-red-600/30 transition-colors" data-id="${p.id}">Eliminar</button>
                      </td>
                  </tr>`).join('');

                  tableEl.querySelectorAll('.delete-payment-btn').forEach((btn: Element) => {
                      btn.addEventListener('click', async () => {
                          const paymentId = (btn as HTMLElement).dataset.id;
                          if (!paymentId) return;
                          if (!await openConfirmModal(
                              'Eliminar este pago',
                              'El registro del pago se eliminará permanentemente.',
                              'Eliminar',
                              'red'
                          )) return;
                          try {
                              const delRes = await fetch('/api/admin/stores/action', {
                                  method: 'POST',
                                  headers: { 'Content-Type': 'application/json' },
                                  body: JSON.stringify({ action: 'delete-payment', paymentId })
                              });
                              const delResult = await delRes.json();
                              if (delResult.success) {
                                  showToast('Pago eliminado');
                                  loadPayments(storeId);
                              } else {
                                  showToast(delResult.message || 'Error', 'error');
                              }
                          } catch { showToast('Error de conexión', 'error'); }
                      });
                  });
              }
          }
      } catch {
          summaryEl.innerHTML = '';
          tableEl.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-red-400 text-sm">Error cargando pagos</td></tr>';
      }
  }

  // Register payment modal
  const registerPaymentModal = document.getElementById('register-payment-modal');
  const rpConceptSelect = document.getElementById('rp-concept-select') as HTMLSelectElement;
  const rpConceptCustom = document.getElementById('rp-concept-custom') as HTMLInputElement;

  document.getElementById('sd-register-payment-btn')?.addEventListener('click', () => {
      if (!currentStoreDetailId) return;
      // ponemos hoy como fecha por defecto
      const dateInput = document.getElementById('rp-date') as HTMLInputElement;
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
      registerPaymentModal?.classList.remove('hidden');
  });

  document.getElementById('rp-close')?.addEventListener('click', () => registerPaymentModal?.classList.add('hidden'));
  registerPaymentModal?.addEventListener('click', (e) => { if (e.target === registerPaymentModal) registerPaymentModal.classList.add('hidden'); });

  rpConceptSelect?.addEventListener('change', () => {
      if (rpConceptSelect.value === 'custom') {
          rpConceptCustom?.classList.remove('hidden');
          rpConceptCustom?.focus();
      } else {
          rpConceptCustom?.classList.add('hidden');
      }
  });

  document.getElementById('rp-submit')?.addEventListener('click', async () => {
      const amountInput = document.getElementById('rp-amount') as HTMLInputElement;
      const methodSelect = document.getElementById('rp-method') as HTMLSelectElement;
      const dateInput = document.getElementById('rp-date') as HTMLInputElement;
      const notesInput = document.getElementById('rp-notes') as HTMLTextAreaElement;

      const amount = parseFloat(amountInput?.value || '0');
      if (!amount || amount <= 0) { showToast('Introduce un importe válido', 'error'); return; }

      const concept = rpConceptSelect?.value === 'custom'
          ? rpConceptCustom?.value?.trim()
          : rpConceptSelect?.value;
      if (!concept) { showToast('Selecciona un concepto', 'error'); return; }

      const submitBtn = document.getElementById('rp-submit') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Registrando...';

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                  action: 'register-payment',
                  storeId: currentStoreDetailId,
                  amount_cents: Math.round(amount * 100),
                  concept,
                  payment_method: methodSelect?.value || 'manual',
                  payment_date: dateInput?.value || undefined,
                  notes: notesInput?.value?.trim() || undefined
              })
          });
          const result = await res.json();
          if (result.success) {
              showToast('Pago registrado correctamente');
              registerPaymentModal?.classList.add('hidden');
              // Reset form
              amountInput.value = '';
              rpConceptSelect.value = 'Mensualidad';
              rpConceptCustom.classList.add('hidden');
              rpConceptCustom.value = '';
              notesInput.value = '';
              // Reload payments
              if (currentStoreDetailId) loadPayments(currentStoreDetailId);
          } else {
              showToast(result.message || 'Error registrando pago', 'error');
          }
      } catch {
          showToast('Error de conexión', 'error');
      } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Registrar Pago';
      }
  });

  // ═══════════════════════════════════════════════
  // Enterprise Configuration
  // ═══════════════════════════════════════════════
  const ecModal = document.getElementById('enterprise-config-modal');
  let currentEnterpriseConfig: any = null;

  const sectionLabels: Record<string, string> = {
      hero: 'Hero / Banner Principal',
      featured_products: 'Productos Destacados',
      categories: 'Categorías',
      new_arrivals: 'Nuevos Productos',
      sustainability: 'Sostenibilidad',
      testimonials: 'Testimonios',
      newsletter: 'Newsletter',
      custom_banner: 'Banner Personalizado'
  };

  const featureLabels: Record<string, string> = {
      products: 'Gestión de Productos',
      gallery: 'Galería de Imágenes',
      orders: 'Gestión de Pedidos',
      customers: 'Gestión de Clientes',
      analytics: 'Analíticas',
      sustainability: 'Métricas Sostenibilidad',
      reports: 'Reportes',
      invoices: 'Facturación',
      tickets: 'Tickets de Soporte',
      certifications: 'Certificaciones'
  };

  function renderToggle(id: string, label: string, checked: boolean): string {
      return `<label class="flex items-center justify-between p-3 rounded-lg bg-gray-100 dark:bg-slate-800/50 border border-white/5 cursor-pointer hover:bg-gray-100 dark:bg-slate-800 transition-colors">
          <span class="text-sm text-gray-600 dark:text-slate-300">${escapeHtml(label)}</span>
          <input type="checkbox" id="${id}" ${checked ? 'checked' : ''} class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-violet-500 focus:ring-violet-500">
      </label>`;
  }

  // ── Tab Navigation ──
  document.querySelectorAll('.ec-tab').forEach(tab => {
      tab.addEventListener('click', () => {
          const tabName = (tab as HTMLElement).dataset.ecTab;
          // desactivamos todas las pestañas y paneles
          document.querySelectorAll('.ec-tab').forEach(t => {
              t.classList.remove('active', 'bg-slate-800', 'text-white', 'border-b-2', 'border-violet-500');
              t.classList.add('text-slate-400', 'hover:text-slate-200');
          });
          document.querySelectorAll('.ec-tab-content').forEach(c => c.classList.add('hidden'));
          // Activate clicked tab
          tab.classList.add('active', 'bg-slate-800', 'text-white', 'border-b-2', 'border-violet-500');
          tab.classList.remove('text-slate-400', 'hover:text-slate-200');
          document.getElementById(`ec-tab-${tabName}`)?.classList.remove('hidden');
      });
  });
  // activamos la primera pestaña al cargar
  const firstTab = document.querySelector('.ec-tab');
  if (firstTab) {
      firstTab.classList.add('bg-slate-800', 'text-white', 'border-b-2', 'border-violet-500');
      firstTab.classList.remove('text-slate-400', 'hover:text-slate-200');
  }

  // ── Color ↔ Hex Sync ──
  function syncColorHex(colorId: string, hexId: string) {
      const colorEl = document.getElementById(colorId) as HTMLInputElement;
      const hexEl = document.getElementById(hexId) as HTMLInputElement;
      if (!colorEl || !hexEl) return;
      hexEl.value = colorEl.value;
      colorEl.addEventListener('input', () => { hexEl.value = colorEl.value; updateColorPreview(); updateButtonPreview(); });
      hexEl.addEventListener('input', () => {
          if (/^#[0-9a-fA-F]{6}$/.test(hexEl.value)) { colorEl.value = hexEl.value; updateColorPreview(); updateButtonPreview(); }
      });
  }
  syncColorHex('ec-primary-color', 'ec-primary-hex');
  syncColorHex('ec-secondary-color', 'ec-secondary-hex');
  syncColorHex('ec-accent-color', 'ec-accent-hex');
  syncColorHex('ec-bg-color', 'ec-bg-hex');

  // ── Color Palette Preview ──
  function updateColorPreview() {
      const p = (document.getElementById('ec-primary-color') as HTMLInputElement)?.value || '#0ea5e9';
      const s = (document.getElementById('ec-secondary-color') as HTMLInputElement)?.value || '#6366f1';
      const a = (document.getElementById('ec-accent-color') as HTMLInputElement)?.value || '#22d3ee';
      const b = (document.getElementById('ec-bg-color') as HTMLInputElement)?.value || '#0f172a';
      const setC = (id: string, c: string) => { const el = document.getElementById(id); if (el) el.style.backgroundColor = c; };
      setC('ec-preview-primary', p);
      setC('ec-preview-secondary', s);
      setC('ec-preview-accent', a);
      setC('ec-preview-bg', b);
  }

  // ── Gradient Toggle & Preview ──
  const gradientEnabledEl = document.getElementById('ec-gradient-enabled') as HTMLInputElement;
  const gradientOptionsEl = document.getElementById('ec-gradient-options');
  gradientEnabledEl?.addEventListener('change', () => {
      if (gradientOptionsEl) {
          gradientOptionsEl.classList.toggle('opacity-40', !gradientEnabledEl.checked);
          gradientOptionsEl.classList.toggle('pointer-events-none', !gradientEnabledEl.checked);
      }
      updateGradientPreview();
  });

  function updateGradientPreview() {
      const start = (document.getElementById('ec-gradient-start') as HTMLInputElement)?.value || '#0ea5e9';
      const end = (document.getElementById('ec-gradient-end') as HTMLInputElement)?.value || '#6366f1';
      const dir = (document.getElementById('ec-gradient-direction') as HTMLSelectElement)?.value || 'to right';
      const preview = document.getElementById('ec-gradient-preview');
      if (preview) preview.style.background = `linear-gradient(${dir}, ${start}, ${end})`;
  }
  document.getElementById('ec-gradient-start')?.addEventListener('input', updateGradientPreview);
  document.getElementById('ec-gradient-end')?.addEventListener('input', updateGradientPreview);
  document.getElementById('ec-gradient-direction')?.addEventListener('change', updateGradientPreview);

  // ── Color Presets ──
  document.querySelectorAll('.ec-preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
                    // Cambia más aspectos visuales al seleccionar una paleta
                    const setColor = (id: string, hexId: string, val: string) => {
                            const cEl = document.getElementById(id) as HTMLInputElement;
                            const hEl = document.getElementById(hexId) as HTMLInputElement;
                            if (cEl) { cEl.value = val; cEl.dispatchEvent(new Event('input')); }
                            if (hEl) hEl.value = val;
                    };
                    setColor('ec-primary-color', 'ec-primary-hex', el.dataset.primary || '#0ea5e9');
                    setColor('ec-secondary-color', 'ec-secondary-hex', el.dataset.secondary || '#6366f1');
                    setColor('ec-accent-color', 'ec-accent-hex', el.dataset.accent || '#22d3ee');
                    setColor('ec-bg-color', 'ec-bg-hex', el.dataset.bg || '#0f172a');

                    // Cambia también el estilo de botones y tipografía según la paleta
                    const fontEl = document.getElementById('ec-font') as HTMLSelectElement;
                    const buttonStyleEl = document.getElementById('ec-button-style') as HTMLSelectElement;
                    const techPresets = ['neo-tokyo', 'abyss', 'indigo-dark', 'void'];
                    const luxuryPresets = ['onyx', 'velvet', 'rouge', 'platinum', 'space'];
                    const organicPresets = ['carbon', 'meadow', 'tropical', 'cream', 'blossom'];
                    if (techPresets.includes(el.dataset.preset || '')) {
                        if (fontEl) fontEl.value = 'mono';
                        if (buttonStyleEl) buttonStyleEl.value = 'square';
                    } else if (luxuryPresets.includes(el.dataset.preset || '')) {
                        if (fontEl) fontEl.value = 'serif';
                        if (buttonStyleEl) buttonStyleEl.value = 'pill';
                    } else if (organicPresets.includes(el.dataset.preset || '')) {
                        if (fontEl) fontEl.value = 'rounded';
                        if (buttonStyleEl) buttonStyleEl.value = 'rounded';
                    } else {
                        if (fontEl) fontEl.value = 'default';
                        if (buttonStyleEl) buttonStyleEl.value = 'rounded';
                    }

                    const gradientEnabled = el.dataset.gradientEnabled === 'true';
                    const gEnabledEl = document.getElementById('ec-gradient-enabled') as HTMLInputElement;
                    const gradientOptionsEl = document.getElementById('ec-gradient-options');
                    if (gEnabledEl) {
                            gEnabledEl.checked = gradientEnabled;
                            gEnabledEl.dispatchEvent(new Event('change'));
                    }
                    if (gradientEnabled) {
                            const setVal = (id: string, val: string) => {
                                    const e = document.getElementById(id) as HTMLInputElement;
                                    if (e && val) { e.value = val; e.dispatchEvent(new Event('input')); e.dispatchEvent(new Event('change')); }
                            };
                            setVal('ec-gradient-start', el.dataset.gradientStart || '#000000');
                            setVal('ec-gradient-end', el.dataset.gradientEnd || '#000000');
                            setVal('ec-gradient-direction', el.dataset.gradientDirection || 'to right');
                    }

                    updateColorPreview();
                    updateButtonPreview();
                    updateGradientPreview();
                    sendPreviewUpdate();

                    // Highlight active preset
                    document.querySelectorAll('.ec-preset-btn').forEach(b => b.classList.remove('ring-2', 'ring-violet-500'));
                    el.classList.add('ring-2', 'ring-violet-500');
      });
  });

  // ── Button Style Preview ──
  function updateButtonPreview() {
      const primary = (document.getElementById('ec-primary-color') as HTMLInputElement)?.value || '#0ea5e9';
      const secondary = (document.getElementById('ec-secondary-color') as HTMLInputElement)?.value || '#6366f1';
      const accent = (document.getElementById('ec-accent-color') as HTMLInputElement)?.value || '#22d3ee';
      const style = (document.getElementById('ec-button-style') as HTMLSelectElement)?.value || 'rounded';
      const radiusMap: Record<string, string> = { rounded: '8px', pill: '9999px', square: '0px', soft: '6px' };
      const radius = radiusMap[style] || '8px';
      const bp = document.getElementById('ec-btn-preview-primary') as HTMLElement;
      const bs = document.getElementById('ec-btn-preview-secondary') as HTMLElement;
      const ba = document.getElementById('ec-btn-preview-accent') as HTMLElement;
      if (bp) { bp.style.backgroundColor = primary; bp.style.borderRadius = radius; }
      if (bs) { bs.style.borderColor = secondary; bs.style.color = secondary; bs.style.borderRadius = radius; bs.style.backgroundColor = 'transparent'; }
      if (ba) { ba.style.backgroundColor = accent; ba.style.borderRadius = radius; }
  }
  document.getElementById('ec-button-style')?.addEventListener('change', updateButtonPreview);

  // ── Open Enterprise Config ──
  document.getElementById('sd-open-enterprise-btn')?.addEventListener('click', async () => {
      if (!currentStoreDetailId) return;
      ecModal?.classList.remove('hidden');

      // volvemos a la primera pestaña
      document.querySelectorAll('.ec-tab').forEach(t => {
          t.classList.remove('active', 'bg-slate-800', 'text-white', 'border-b-2', 'border-violet-500');
          t.classList.add('text-slate-400', 'hover:text-slate-200');
      });
      document.querySelectorAll('.ec-tab-content').forEach(c => c.classList.add('hidden'));
      const ft = document.querySelector('.ec-tab');
      if (ft) {
          ft.classList.add('active', 'bg-slate-800', 'text-white', 'border-b-2', 'border-violet-500');
          ft.classList.remove('text-slate-400', 'hover:text-slate-200');
      }
      document.getElementById('ec-tab-identity')?.classList.remove('hidden');

      // establecemos el src del iframe de preview
      const previewIframe = document.getElementById('ec-preview') as HTMLIFrameElement;
      if (previewIframe && window.stores) {
          const tienda = window.stores.find(s => s.id === currentStoreDetailId);
          if (tienda && tienda.subdomain) {
              const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
              const previewBase = isLocal ? 'http://localhost:3000' : `https://${tienda.subdomain}.neonhub.es`;
              previewIframe.src = `${previewBase}/shop?preview=true&tenant=${tienda.subdomain}`;
          } else {
              previewIframe.src = '';
          }
      }

      try {
          const res = await fetch('/api/admin/stores/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'get-enterprise-config', storeId: currentStoreDetailId })
          });
          const result = await res.json();
          if (result.success) {
              currentEnterpriseConfig = result.data.config;
              const config = result.data.config;

              if (config.branding) {
                  const setVal = (id: string, val: string) => {
                      const el = document.getElementById(id) as HTMLInputElement;
                      if (el && val !== undefined) el.value = val;
                  };
                  setVal('ec-store-name', config.branding.store_name || '');
                  setVal('ec-store-desc', config.branding.store_description || '');
                  setVal('ec-primary-color', config.branding.primary_color || '#0ea5e9');
                  setVal('ec-secondary-color', config.branding.secondary_color || '#6366f1');
                  setVal('ec-accent-color', config.branding.accent_color || '#22d3ee');
                  setVal('ec-bg-color', config.branding.bg_color || '#0f172a');
                  // Sync hex inputs
                  setVal('ec-primary-hex', config.branding.primary_color || '#0ea5e9');
                  setVal('ec-secondary-hex', config.branding.secondary_color || '#6366f1');
                  setVal('ec-accent-hex', config.branding.accent_color || '#22d3ee');
                  setVal('ec-bg-hex', config.branding.bg_color || '#0f172a');

                  // Logo preview – FIX: show/hide properly
                  const logoPreview = document.getElementById('ec-logo-preview') as HTMLImageElement;
                  const logoPlaceholder = document.getElementById('ec-logo-placeholder');
                  if (logoPreview && config.branding.logo_url) {
                      logoPreview.src = config.branding.logo_url;
                      logoPreview.style.display = 'block';
                      if (logoPlaceholder) logoPlaceholder.style.display = 'none';
                  } else if (logoPreview) {
                      logoPreview.style.display = 'none';
                      if (logoPlaceholder) logoPlaceholder.style.display = 'block';
                  }

                  // Favicon preview
                  const faviconPreview = document.getElementById('ec-favicon-preview') as HTMLImageElement;
                  const faviconPlaceholder = document.getElementById('ec-favicon-placeholder');
                  if (faviconPreview && config.branding.favicon_url) {
                      faviconPreview.src = config.branding.favicon_url;
                      faviconPreview.style.display = 'block';
                      if (faviconPlaceholder) faviconPlaceholder.style.display = 'none';
                  }
              }

              // Render sections
              const sectionsEl = document.getElementById('ec-sections');
              if (sectionsEl) {
                  const safeSections = config.sections || {};
                  const defaultSections = Object.keys(sectionLabels).reduce((acc, key) => ({...acc, [key]: true}), {});
                  const mergedSections = { ...defaultSections, ...safeSections };
                  sectionsEl.innerHTML = Object.entries(mergedSections).map(([key, val]) =>
                      renderToggle(`ec-sec-${key}`, sectionLabels[key] || key, val as boolean)
                  ).join('');
                  // Añadir listeners para previsualización en tiempo real
                  Object.keys(mergedSections).forEach(key => {
                      const cb = document.getElementById(`ec-sec-${key}`);
                      if (cb) {
                          cb.addEventListener('change', sendPreviewUpdate);
                      }
                  });
              }

              // Render features
              const featuresEl = document.getElementById('ec-features');
              if (featuresEl) {
                  const safeFeatures = config.features || {};
                  const defaultFeatures = Object.keys(featureLabels).reduce((acc, key) => ({...acc, [key]: true}), {});
                  const mergedFeatures = { ...defaultFeatures, ...safeFeatures };
                  featuresEl.innerHTML = Object.entries(mergedFeatures).map(([key, val]) =>
                      renderToggle(`ec-feat-${key}`, featureLabels[key] || key, val as boolean)
