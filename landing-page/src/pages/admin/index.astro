---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.astro';
import { validateSession } from '../../lib/auth';
import { getStores, getProvisioningRequests, getBillingSummary, getTickets, getUsers, getRoles, getLeads, getNotes } from '../../lib/adminApi';

const sessionId = Astro.cookies.get('app_auth_token')?.value;
const session = sessionId ? await validateSession(sessionId) : null;

if (!session || session.user.role !== 'admin') {
    return Astro.redirect('/dashboard');
}

const { user } = session;

// cargamos todos los datos desde la API de admin en el servidor
let stores: any[] = [];
let requests: any[] = [];
let billing: any = null;
let tickets: any[] = [];
let users: any[] = [];
let roles: any[] = [];
let leads: any[] = [];
let notes: Record<string, string> = {};

try {
    const [storesRes, requestsRes, billingRes, ticketsRes, usersRes, rolesRes, leadsRes, notesRes] = await Promise.all([
        getStores(),
        getProvisioningRequests(),
        getBillingSummary(),
        getTickets(),
        getUsers(),
        getRoles(),
        getLeads(),
        getNotes()
    ]);
    if (storesRes?.success) stores = storesRes.data || [];
    if (requestsRes?.success) requests = requestsRes.data || [];
    if (billingRes?.success) billing = billingRes.data || null;
    if (ticketsRes?.success) tickets = ticketsRes.data || [];
    if (usersRes?.success) users = usersRes.data || [];
    if (rolesRes?.success) roles = rolesRes.data || [];
    if (leadsRes?.success) leads = leadsRes.data || [];
    if (notesRes?.success) notes = notesRes.data || {};
} catch (error) {
    console.error("Error fetching admin data:", error);
}

const activeStores = stores.filter((s: any) => s.is_active);
const pausedStores = stores.filter((s: any) => s.paused_at);
const pendingRequests = requests.filter((r: any) => r.status === 'queued' || r.status === 'processing');
const completedRequests = requests.filter((r: any) => r.status === 'completed');
const openTickets = tickets.filter((t: any) => t.status === 'open' || t.status === 'in_progress');
const unreadTickets = tickets.filter((t: any) => !t.read_by_admin);

// colores para las badges según el rol
const roleColors: Record<string, string> = {
    ceo_neonhub: 'bg-red-500/10 text-red-400 border-red-500/20',
    ceo: 'bg-violet-500/10 text-violet-400 border-violet-500/20',
    admin: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
    manager: 'bg-green-500/10 text-green-400 border-green-500/20',
    employee: 'bg-green-500/10 text-green-400 border-green-500/20',
    viewer: 'bg-gray-500/10 text-gray-400 border-gray-500/20',
    customer: 'bg-gray-500/10 text-gray-400 dark:text-slate-500 border-gray-500/20'
};

// ordenamos usuarios: ceo_neonhub primero, luego ceo, luego por nivel de rol
const rolePriority: Record<string, number> = { ceo_neonhub: 0, ceo: 1, admin: 2, manager: 3, employee: 4, viewer: 5, customer: 6 };
const sortedUsers = [...users].sort((a: any, b: any) => {
    const roleA = a.roles?.[0]?.name || 'zzz';
    const roleB = b.roles?.[0]?.name || 'zzz';
    return (rolePriority[roleA] ?? 99) - (rolePriority[roleB] ?? 99);
});
const ceoUsers = users.filter((u: any) => u.roles?.some((r: any) => r.name === 'ceo'));

const formatDate = (d: string | null) => d ? new Date(d).toLocaleDateString('es-ES') : '—';
const formatPrice = (cents: number | null) => cents ? `${(cents / 100).toFixed(2)} €` : '—';

const paymentStatusColors: Record<string, string> = {
    paid: 'bg-green-500/10 text-green-400 border-green-500/20',
    pending: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
    overdue: 'bg-red-500/10 text-red-400 border-red-500/20',
    cancelled: 'bg-slate-500/10 text-gray-500 dark:text-slate-400 border-slate-500/20',
    trial: 'bg-blue-500/10 text-blue-400 border-blue-500/20'
};
---

<Layout title="Panel de Administración - NeonHub">
  <Navbar client:load user={user} />
  <main class="min-h-screen pt-32 pb-12 px-6 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Panel de Administración</h1>
                <p class="text-gray-500 dark:text-slate-400 mt-1">Gestión completa de tiendas, provisioning y facturación</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-sm text-gray-500 dark:text-slate-400">{user.email}</span>
                <span class="px-3 py-1 bg-violet-600/20 text-violet-400 rounded-full text-sm font-medium border border-violet-500/30">
                    Admin
                </span>
            </div>
        </div>
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
            <div class="p-5 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <h3 class="text-gray-500 dark:text-slate-400 text-xs font-medium mb-1 uppercase tracking-wider">Total Tiendas</h3>
                <p class="text-3xl font-bold text-gray-900 dark:text-white">{stores.length}</p>
            </div>
            <div class="p-5 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <h3 class="text-gray-500 dark:text-slate-400 text-xs font-medium mb-1 uppercase tracking-wider">Activas</h3>
                <p class="text-3xl font-bold text-green-400">{activeStores.length}</p>
            </div>
            <div class="p-5 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <h3 class="text-gray-500 dark:text-slate-400 text-xs font-medium mb-1 uppercase tracking-wider">Pausadas</h3>
                <p class="text-3xl font-bold text-yellow-400">{pausedStores.length}</p>
            </div>
            <div class="p-5 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <h3 class="text-gray-500 dark:text-slate-400 text-xs font-medium mb-1 uppercase tracking-wider">Provisioning</h3>
                <p class="text-3xl font-bold text-orange-400">{pendingRequests.length}</p>
            </div>
            <div class="p-5 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <h3 class="text-gray-500 dark:text-slate-400 text-xs font-medium mb-1 uppercase tracking-wider">Completados</h3>
                <p class="text-3xl font-bold text-violet-400">{completedRequests.length}</p>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-1 mb-6 bg-gray-100 dark:bg-white/5 rounded-xl p-1 border border-gray-200 dark:border-white/10 w-fit">
            <button class="tab-btn active px-5 py-2.5 rounded-lg text-sm font-medium transition-all" data-tab="stores">
                Tiendas ({stores.length})
            </button>
            <button class="tab-btn px-5 py-2.5 rounded-lg text-sm font-medium transition-all" data-tab="provisioning">
                Provisioning {pendingRequests.length > 0 ? `(${pendingRequests.length} pendientes)` : `(${requests.length})`}
            </button>
            <button class="tab-btn px-5 py-2.5 rounded-lg text-sm font-medium transition-all" data-tab="billing">
                Facturación
            </button>
            <button class="tab-btn px-5 py-2.5 rounded-lg text-sm font-medium transition-all" data-tab="users">
                Usuarios ({sortedUsers.length})
            </button>
            <button class="tab-btn px-5 py-2.5 rounded-lg text-sm font-medium transition-all relative" data-tab="tickets">
                Tickets ({tickets.length})
                {unreadTickets.length > 0 && (
                    <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                        {unreadTickets.length}
                    </span>
                )}
            </button>
        </div>

        <!-- ═══════════ Tab: Tiendas ═══════════ -->
        <div id="tab-stores" class="tab-content">
            <div class="p-6 rounded-2xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Gestión de Tiendas</h2>
                    <div class="flex gap-2">
                        <button id="btn-create-store" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors">
                            + Nueva Tienda
                        </button>
                        <button id="btn-refresh" class="px-4 py-2 bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:bg-white/10 text-gray-600 dark:text-slate-300 rounded-lg text-sm font-medium transition-colors border border-gray-200 dark:border-white/10">
                            ↻ Actualizar
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 dark:border-white/10">
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Tienda</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Plan</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Precio</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Pago</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Próx. Pago</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Estado</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm">Stats</th>
                                <th class="py-3 px-4 font-medium text-gray-500 dark:text-slate-400 text-sm text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                            {stores.length === 0 ? (
                                <tr>
                                    <td colspan="8" class="py-8 text-center text-gray-500 dark:text-slate-400">
                                        No hay tiendas registradas.
                                    </td>
                                </tr>
                            ) : (
                                stores.map((store: any) => (
                                    <tr class="hover:bg-gray-100 dark:hover:bg-white/10 transition-colors store-detail-row" data-store-id={store.id}>
                                        <td class="py-4 px-4">
                                            <div>
                                                <p class="text-gray-900 dark:text-white font-medium">{store.name}</p>
                                                <a href={`https://${store.subdomain}.neonhub.es`} target="_blank" class="text-xs text-violet-400 hover:text-violet-300 transition-colors" onclick="event.stopPropagation()">
                                                    {store.subdomain}.neonhub.es ↗
                                                </a>
                                                <button
                                                    data-subdomain={store.subdomain}
                                                    class="sso-store-btn mt-1 text-xs text-violet-300 hover:text-violet-200 transition-colors disabled:opacity-50 disabled:cursor-wait">
                                                    Entrar como admin →
                                                </button>
                                            </div>
                                        </td>
                                        <td class="py-4 px-4">
                                            {store.subdomain === 'demo' ? (
                                                <span class="text-sm text-gray-400 dark:text-slate-500 cursor-default">{store.plan_id || '—'}</span>
                                            ) : (
                                                <span class="text-sm text-gray-600 dark:text-slate-300 cursor-pointer hover:text-violet-400 transition-colors plan-edit-btn" data-id={store.id} data-name={store.name} data-plan={store.plan_id}>{store.plan_id || '—'}</span>
                                            )}
                                        </td>
                                        <td class="py-4 px-4">
                                            <span class="text-sm text-gray-600 dark:text-slate-300">{formatPrice(store.plan_price_cents)}</span>
                                        </td>
                                        <td class="py-4 px-4">
                                            {store.payment_status ? (
                                                <span class={`px-2 py-1 rounded-full text-xs font-medium border ${paymentStatusColors[store.payment_status] || 'bg-slate-500/10 text-gray-500 dark:text-slate-400 border-slate-500/20'}`}>
                                                    {store.payment_status}
                                                </span>
                                            ) : (
                                                <span class="text-sm text-gray-400 dark:text-slate-500">—</span>
                                            )}
                                        </td>
                                        <td class="py-4 px-4">
                                            <span class="text-sm text-gray-500 dark:text-slate-400">{formatDate(store.next_payment_date)}</span>
                                        </td>
                                        <td class="py-4 px-4">
                                            {store.paused_at ? (
                                                <span class="px-2 py-1 rounded-full bg-yellow-500/10 text-yellow-400 text-xs font-medium border border-yellow-500/20" title={store.paused_reason || ''}>
                                                    Pausada
                                                </span>
                                            ) : store.is_active ? (
                                                <span class="px-2 py-1 rounded-full bg-green-500/10 text-green-400 text-xs font-medium border border-green-500/20">
                                                    Activa
                                                </span>
                                            ) : (
                                                <span class="px-2 py-1 rounded-full bg-red-500/10 text-red-400 text-xs font-medium border border-red-500/20">
                                                    Inactiva
                                                </span>
                                            )}
                                        </td>
                                        <td class="py-4 px-4">
                                            <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-slate-400">
                                                <span class="whitespace-nowrap" title="Usuarios">👤 {store.userCount || 0}</span>
                                                <span class="whitespace-nowrap" title="Productos">📦 {store.productCount || 0}</span>
                                                <span class="whitespace-nowrap" title="Pedidos">🛒 {store.orderCount || 0}</span>
                                            </div>
                                        </td>
                                        <td class="py-4 px-4">
                                            {store.subdomain !== 'main' ? (
                                                <div class="flex gap-2 justify-end flex-wrap">
                                                    {store.subdomain === 'demo' && (
                                                        <span class="px-2 py-1 rounded-full text-xs font-medium border bg-blue-500/10 text-blue-400 border-blue-500/20 whitespace-nowrap" title="La tienda demo está protegida contra modificaciones">
                                                            🔒 Solo lectura
                                                        </span>
                                                    )}
                                                    <button
                                                        class={`action-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors border ${store.is_active ? 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20 hover:bg-yellow-500/20' : 'bg-green-500/10 text-green-400 border-green-500/20 hover:bg-green-500/20'}`}
                                                        data-action="toggle"
                                                        data-id={store.id}
                                                        data-name={store.name}
                                                    >
                                                        {store.is_active ? 'Desactivar' : 'Activar'}
                                                    </button>
                                                    {store.paused_at ? (
                                                        <button
                                                            class="action-btn px-3 py-1.5 bg-blue-500/10 text-blue-400 border-blue-500/20 hover:bg-blue-500/20 rounded-lg text-xs font-medium transition-colors border"
                                                            data-action="pause"
                                                            data-id={store.id}
                                                            data-name={store.name}
                                                        >
                                                            Reactivar
                                                        </button>
                                                    ) : (
                                                        <button
                                                            class="action-btn px-3 py-1.5 bg-orange-500/10 text-orange-400 border-orange-500/20 hover:bg-orange-500/20 rounded-lg text-xs font-medium transition-colors border"
                                                            data-action="pause"
                                                            data-id={store.id}
                                                            data-name={store.name}
                                                        >
                                                            Pausar
                                                        </button>
                                                    )}
                                                    {store.subdomain !== 'demo' && store.payment_status === 'trial' && (
                                                        <button
                                                            class="extend-trial-btn px-3 py-1.5 bg-blue-500/10 text-blue-400 border-blue-500/20 hover:bg-blue-500/20 rounded-lg text-xs font-medium transition-colors border"
                                                            data-id={store.id}
                                                            data-name={store.name}
                                                            data-trial-ends={store.trial_ends_at}
                                                        >
                                                            Extender trial
                                                        </button>
                                                    )}
                                                    {store.subdomain !== 'demo' && (
                                                        <button
                                                            class="action-btn px-3 py-1.5 bg-red-500/10 text-red-400 border-red-500/20 hover:bg-red-500/20 rounded-lg text-xs font-medium transition-colors border"
                                                            data-action="delete"
                                                            data-id={store.id}
                                                            data-name={store.name}
                                                            data-user-count={store.userCount || 0}
                                                            data-order-count={store.orderCount || 0}
                                                        >
                                                            Eliminar
                                                        </button>
                                                    )}
                                                    {store.subdomain !== 'demo' && (
                                                        <button
                                                            class="manage-store-btn px-3 py-1.5 bg-violet-500/10 text-violet-400 border-violet-500/20 hover:bg-violet-500/20 rounded-lg text-xs font-semibold transition-colors border"
                                                            data-id={store.id}
                                                            data-name={store.name}
                                                            data-subdomain={store.subdomain}
                                                        >
                                                            Gestionar
                                                        </button>
                                                    )}
                                                </div>
                                            ) : (
                                                <span class="text-xs text-gray-400 dark:text-slate-500 italic">Principal</span>
                                            )}
                                        </td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════ Tab: Provisioning ═══════════ -->

        <!-- Store Detail Modal -->
        <div id="store-detail-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-white/10 rounded-2xl p-6 w-full max-w-3xl max-h-[85vh] overflow-y-auto">
                <div class="flex justify-between items-center mb-6">
                    <h3 id="store-detail-title" class="text-xl font-bold text-gray-900 dark:text-white">Detalle de Tienda</h3>
                    <button id="store-detail-close" class="text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:text-white transition-colors text-2xl leading-none">&times;</button>
                </div>
                <div id="store-detail-loading" class="text-center py-8 text-gray-500 dark:text-slate-400">Cargando...</div>
                <div id="store-detail-content" class="hidden">
                    <!-- Demo banner -->
                    <div id="sd-demo-banner" class="hidden mb-4 flex items-center gap-2 px-4 py-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-sm font-semibold">
                        🔒 Tienda Demo — Solo lectura. Las acciones de gestión están desactivadas.
                    </div>
                    <!-- Info cards -->
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
                        <div class="p-3 rounded-xl bg-violet-500/5 border border-violet-500/10 text-center">
                            <p class="text-violet-400 text-xs font-medium mb-1">Usuarios</p>
                            <p id="sd-users" class="text-xl font-bold text-gray-900 dark:text-white">0</p>
                        </div>
                        <div class="p-3 rounded-xl bg-blue-500/5 border border-blue-500/10 text-center">
                            <p class="text-blue-400 text-xs font-medium mb-1">Clientes</p>
                            <p id="sd-customers" class="text-xl font-bold text-gray-900 dark:text-white">0</p>
                        </div>
                        <div class="p-3 rounded-xl bg-green-500/5 border border-green-500/10 text-center">
                            <p class="text-green-400 text-xs font-medium mb-1">Productos</p>
                            <p id="sd-products" class="text-xl font-bold text-gray-900 dark:text-white">0</p>
                        </div>
                        <div class="p-3 rounded-xl bg-amber-500/5 border border-amber-500/10 text-center">
                            <p class="text-amber-400 text-xs font-medium mb-1">Pedidos</p>
                            <p id="sd-orders" class="text-xl font-bold text-gray-900 dark:text-white">0</p>
                        </div>
                        <div class="p-3 rounded-xl bg-pink-500/5 border border-pink-500/10 text-center">
                            <p class="text-pink-400 text-xs font-medium mb-1">Categorías</p>
                            <p id="sd-categories" class="text-xl font-bold text-gray-900 dark:text-white">0</p>
                        </div>
                    </div>
                    <!-- Store info row -->
                    <div id="sd-info" class="p-4 rounded-xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 mb-4">
                    </div>

                    <!-- Quick Plan Change -->
                    <div class="mb-6 p-4 rounded-xl bg-violet-500/5 border border-violet-500/20">
                        <div class="flex items-center justify-between">
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">📋 Plan de suscripción</h4>
                                <p id="sd-current-plan-label" class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">Cargando...</p>
                            </div>
                            <button id="sd-change-plan-btn" class="px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-xs font-semibold transition-colors">
                                Cambiar Plan
                            </button>
                        </div>
                    </div>

                    <!-- Store detail tabs: Empleados / Clientes -->
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex gap-2">
                            <button class="sd-tab-btn active px-3 py-1.5 text-xs font-medium rounded-lg transition-all bg-violet-600/20 text-violet-300 border border-violet-500/30" data-sdtab="employees">
                                👥 Empleados <span id="sd-emp-count" class="ml-1 opacity-70"></span>
                            </button>
                            <button class="sd-tab-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:text-white border border-gray-200 dark:border-white/10" data-sdtab="customers">
                                🛍️ Clientes <span id="sd-cust-count" class="ml-1 opacity-70"></span>
                            </button>
                        </div>
                        <button id="sd-add-user-btn" class="px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-xs font-medium transition-colors">+ Añadir Usuario</button>
                    </div>

                    <!-- Tab: Empleados -->
                    <div id="sd-tab-employees" class="sd-tab-panel">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-gray-200 dark:border-white/10">
                                        <th class="py-2 px-3 font-medium text-gray-500 dark:text-slate-400 text-xs">Usuario</th>
                                        <th class="py-2 px-3 font-medium text-gray-500 dark:text-slate-400 text-xs">Email</th>
                                        <th class="py-2 px-3 font-medium text-gray-500 dark:text-slate-400 text-xs">Rol</th>
                                        <th class="py-2 px-3 font-medium text-gray-500 dark:text-slate-400 text-xs">Estado</th>
                                        <th class="py-2 px-3 font-medium text-gray-500 dark:text-slate-400 text-xs">Registro</th>
                                        <th class="py-2 px-3 font-medium text-gray-500 dark:text-slate-400 text-xs text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="sd-users-table" class="divide-y divide-gray-100 dark:divide-white/5"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab: Clientes -->
                    <div id="sd-tab-customers" class="sd-tab-panel hidden">
                        <!-- Sección A: Clientes con login -->
                        <div class="mb-6">
                            <h5 class="text-sm font-semibold text-gray-600 dark:text-slate-300 mb-3 flex items-center gap-2">
