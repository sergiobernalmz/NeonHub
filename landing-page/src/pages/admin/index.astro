      const copyBtn = document.getElementById('pwd-modal-copy') as HTMLButtonElement;
      try {
          await navigator.clipboard.writeText(valEl.textContent || '');
          copyBtn.textContent = '¡Copiado!';
          setTimeout(() => { copyBtn.textContent = 'Copiar'; }, 2000);
