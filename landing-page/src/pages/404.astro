---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.astro';
import { validateSession } from '../lib/auth';

const sessionId = Astro.cookies.get('app_auth_token')?.value;
const session = sessionId ? await validateSession(sessionId) : null;
const user = session ? session.user : null;
---

<Layout title="Página no encontrada — NeonHub" noindex={true}>
  <Navbar client:load user={user} />

  <main class="min-h-screen bg-white dark:bg-slate-950 flex flex-col items-center justify-center text-center px-6 py-20">

    <p class="text-8xl md:text-9xl font-black leading-none mb-4"
       style="background:linear-gradient(135deg,#6366f1,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
      404
    </p>

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-3">
      Página no encontrada
    </h1>

    <p class="text-gray-500 dark:text-slate-400 mb-10 max-w-sm leading-relaxed">
      La página que buscas no existe o ha sido movida.
    </p>

    <div class="flex gap-3 flex-wrap justify-center">
      <a href="/"
         class="px-7 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-lg transition-colors">
        Volver al inicio
      </a>
      <a href="/contacto"
         class="px-7 py-3 border border-gray-300 dark:border-white/20 hover:border-gray-400 dark:hover:border-white/40 hover:bg-gray-100 dark:hover:bg-white/5 text-gray-700 dark:text-white font-medium rounded-lg transition-colors">
        Contactar soporte
      </a>
    </div>

  </main>

  <Footer />
</Layout>
