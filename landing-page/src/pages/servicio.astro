---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.astro';
import { validateSession } from '../lib/auth';

const sessionId = Astro.cookies.get('app_auth_token')?.value;
const session = sessionId ? await validateSession(sessionId) : null;
const user = session ? session.user : null;
const dashboardUrl = user?.role === 'admin' ? '/admin' : '/dashboard';

const modules = [
  { icon: '🛍️', title: 'Gestión de Productos',   desc: 'Añade, edita y organiza tu catálogo fácilmente' },
  { icon: '📦', title: 'Gestión de Pedidos',      desc: 'Sigue el estado de cada pedido en tiempo real' },
  { icon: '👥', title: 'Clientes',                desc: 'Gestiona tu base de clientes y su historial' },
  { icon: '🖼️', title: 'Galería',                 desc: 'Sube y organiza las imágenes de tu tienda' },
  { icon: '📊', title: 'Analíticas',              desc: 'Visualiza las métricas clave de tu negocio' },
  { icon: '🌱', title: 'Sostenibilidad',          desc: 'Mide el impacto ambiental de tu comercio' },
  { icon: '📋', title: 'Informes',                desc: 'Genera reportes detallados de ventas y productos' },
  { icon: '🧾', title: 'Facturación',             desc: 'Facturas automáticas para cada pedido' },
  { icon: '🎫', title: 'Tickets de soporte',      desc: 'Atiende las dudas de tus clientes' },
  { icon: '🏷️', title: 'Descuentos y Envío',     desc: 'Crea códigos de descuento y configura el envío' },
  { icon: '↩️', title: 'Devoluciones',            desc: 'Gestiona solicitudes de devolución fácilmente' },
  { icon: '🏅', title: 'Certificaciones',         desc: 'Destaca la calidad y sostenibilidad de tus productos' },
];

const tech = [
  { icon: '⚡', title: 'Infraestructura robusta',  desc: 'Alojamiento en la nube con alta disponibilidad' },
  { icon: '🔒', title: 'Seguridad',                desc: 'JWT, HTTPS, protección contra ataques' },
  { icon: '💳', title: 'Pagos con Stripe',         desc: 'Integración nativa con el procesador líder mundial' },
  { icon: '📧', title: 'Emails automáticos',       desc: 'Notificaciones automáticas para cada evento' },
  { icon: '🎨', title: 'Personalización total',    desc: '20 temas predefinidos y editor visual de colores' },
  { icon: '🌐', title: 'Multi-idioma',             desc: 'Soporte para múltiples idiomas y monedas' },
];
---

<Layout
  title="Servicio — NeonHub"
  description="Todo lo que necesitas para vender online. Gestión de productos, pedidos, clientes, analíticas, facturación y mucho más en una sola plataforma."
  canonical="https://neonhub.es/servicio"
>
  <Navbar client:load user={user} />

  <main class="min-h-screen bg-white dark:bg-[#0f0e1a] overflow-x-hidden">

    <!-- HERO -->
    <section class="pt-36 pb-20 px-6 text-center relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-violet-500/8 dark:bg-violet-700/12 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto relative z-10">
        <div id="hero-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 mb-6 text-xs text-gray-500 dark:text-slate-400 font-semibold tracking-wider uppercase" style="opacity:0">
          <svg class="w-3 h-3 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Plataforma SaaS
        </div>

        <h1 id="hero-title" class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white mb-6 leading-tight" style="opacity:0">
          Todo lo que necesitas<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 to-indigo-500">para vender online</span>
        </h1>

        <p id="hero-sub" class="text-gray-500 dark:text-slate-400 text-xl max-w-2xl mx-auto mb-10 leading-relaxed" style="opacity:0">
          NeonHub es la plataforma SaaS que te da las herramientas para crear y gestionar tu tienda en minutos. Sin código, sin complicaciones.
        </p>

        <div id="hero-cta" class="flex flex-col sm:flex-row items-center justify-center gap-4" style="opacity:0">
          {user ? (
            <a href={dashboardUrl}
              class="px-8 py-4 rounded-full font-bold text-white text-base transition-all duration-300 hover:scale-105 active:scale-95"
              style="background:linear-gradient(135deg,#7c3aed,#4f46e5);box-shadow:0 0 35px rgba(124,58,237,0.35)">
              Ir a mi dashboard →
            </a>
          ) : (
            <a href="/register"
              class="px-8 py-4 rounded-full font-bold text-white text-base transition-all duration-300 hover:scale-105 active:scale-95"
              style="background:linear-gradient(135deg,#7c3aed,#4f46e5);box-shadow:0 0 35px rgba(124,58,237,0.35)">
              Crear mi tienda gratis →
            </a>
          )}
          <a href="/precios"
            class="px-8 py-4 rounded-full font-semibold text-gray-700 dark:text-slate-300 text-base border border-gray-200 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/5 transition-all duration-300">
            Ver precios
          </a>
        </div>
      </div>
    </section>

    <!-- MÓDULOS -->
    <section class="modules-section px-6 pb-24">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="modules-heading text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4" style="opacity:0">
            12 módulos incluidos en{' '}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 to-indigo-500">todos los planes</span>
          </h2>
          <p class="modules-sub text-gray-500 dark:text-slate-400 text-lg max-w-2xl mx-auto" style="opacity:0">
            Una plataforma completa que cubre cada aspecto de tu negocio online, desde el primer producto hasta el último informe.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {modules.map((mod, i) => (
            <div
              class="module-card group p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
              style="opacity:0"
              data-index={i}
            >
              <div class="flex items-start gap-4">
                <div class="text-3xl flex-shrink-0 mt-0.5">{mod.icon}</div>
                <div>
                  <h3 class="font-bold text-gray-900 dark:text-white mb-1 group-hover:text-violet-600 dark:group-hover:text-violet-300 transition-colors">{mod.title}</h3>
                  <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{mod.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CARACTERÍSTICAS TÉCNICAS -->
    <section class="tech-section px-6 pb-24">
      <div class="max-w-7xl mx-auto">
        <div class="rounded-3xl p-12 md:p-16 border border-gray-100 dark:border-white/8" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9); background-color: var(--tech-bg, #f8fafc);">
          <div class="text-center mb-12">
            <h2 class="tech-heading text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4" style="opacity:0">
              Tecnología de{' '}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 to-indigo-500">vanguardia</span>
            </h2>
            <p class="tech-sub text-gray-500 dark:text-slate-400 text-lg max-w-2xl mx-auto" style="opacity:0">
              Construido con las mejores herramientas para garantizar velocidad, seguridad y escalabilidad.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {tech.map((item, i) => (
              <div class="tech-card flex items-start gap-4" style="opacity:0" data-index={i}>
                <div class="text-2xl flex-shrink-0">{item.icon}</div>
                <div>
                  <h3 class="font-bold text-gray-900 dark:text-white mb-1">{item.title}</h3>
                  <p class="text-sm text-gray-500 dark:text-slate-400">{item.desc}</p>
                </div>
              </div>
            ))}
            <div class="tech-card flex items-start gap-4" style="opacity:0" data-index={tech.length}>
              <div class="text-2xl flex-shrink-0">🖥️</div>
              <div>
                <h3 class="font-bold text-gray-900 dark:text-white mb-1">App de escritorio</h3>
                <p class="text-sm text-gray-500 dark:text-slate-400">Gestiona tu tienda desde Windows sin necesidad de abrir el navegador.</p>
                <a href="https://neonhub.es/updates/download"
                  style="display:inline-block;margin-top:8px;color:#6366f1;font-size:13px;font-weight:600;text-decoration:none;">
                  ⬇️ Descargar para Windows →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="cta-section px-6 pb-32">
      <div class="max-w-3xl mx-auto text-center">
        <div class="cta-card rounded-3xl p-12 relative overflow-hidden" style="background:linear-gradient(135deg,rgba(109,40,217,0.12),rgba(79,70,229,0.08));border:1px solid rgba(139,92,246,0.2);opacity:0">
          <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 50% 0%,rgba(124,58,237,0.1),transparent 70%)"></div>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-4 relative z-10">¿Listo para empezar?</h2>
          <p class="text-gray-500 dark:text-slate-400 mb-8 text-lg relative z-10">
            Crea tu tienda en minutos. Sin permanencia, sin costes ocultos.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10">
            {user ? (
              <a href={dashboardUrl}
                class="px-8 py-4 rounded-full font-bold text-white text-sm transition-all duration-300 hover:scale-105 active:scale-95"
                style="background:linear-gradient(135deg,#7c3aed,#4f46e5);box-shadow:0 0 40px rgba(124,58,237,0.35)">
                Ir a mi dashboard →
              </a>
            ) : (
              <a href="/register"
                class="px-8 py-4 rounded-full font-bold text-white text-sm transition-all duration-300 hover:scale-105 active:scale-95"
                style="background:linear-gradient(135deg,#7c3aed,#4f46e5);box-shadow:0 0 40px rgba(124,58,237,0.35)">
                Crear mi tienda gratis →
              </a>
            )}
            <a href="/precios"
              class="px-8 py-4 rounded-full font-semibold text-gray-600 dark:text-slate-300 text-sm border border-gray-200 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/5 transition-all duration-300">
              Ver planes y precios
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* tarjetas de módulo — por defecto modo claro, override para oscuro */
  .module-card {
    background-color: #f9fafb;
    border-color: #e5e7eb;
  }
  :global(.dark) .module-card {
    background-color: rgba(30, 41, 59, 0.5);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .module-card:hover {
    box-shadow: 0 8px 30px rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.3);
  }

  /* fondo de la sección de tecnología */
  .tech-section > div > div {
    background: linear-gradient(135deg, #f8fafc, #f1f5f9) !important;
  }
  :global(.dark) .tech-section > div > div {
    background: linear-gradient(135deg, rgba(15,23,42,0.8), rgba(15,14,26,0.95)) !important;
    border-color: rgba(255,255,255,0.08) !important;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    // animación de entrada del hero
    gsap.set(['#hero-title', '#hero-sub'], { y: 30 });
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.to('#hero-badge', { opacity: 1, duration: 0.5 })
      .to('#hero-title', { opacity: 1, y: 0, duration: 0.7 }, '-=0.3')
      .to('#hero-sub',   { opacity: 1, y: 0, duration: 0.5 }, '-=0.4')
      .to('#hero-cta',   { opacity: 1, duration: 0.4 }, '-=0.2');

    // título de la sección de módulos
    gsap.to('.modules-heading', {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '.modules-section', start: 'top 85%', once: true },
    });
    gsap.to('.modules-sub', {
      opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', delay: 0.1,
      scrollTrigger: { trigger: '.modules-section', start: 'top 85%', once: true },
    });
    gsap.set(['.modules-heading', '.modules-sub'], { y: 20 });

    // tarjetas de módulo con stagger
    gsap.to('.module-card', {
      opacity: 1, y: 0, stagger: 0.06, duration: 0.6, ease: 'power2.out',
      scrollTrigger: { trigger: '.modules-section', start: 'top 75%', once: true },
    });
    gsap.set('.module-card', { y: 30 });

    // sección de tecnología
    gsap.set(['.tech-heading', '.tech-sub'], { y: 20 });
    gsap.to('.tech-heading', {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '.tech-section', start: 'top 85%', once: true },
    });
    gsap.to('.tech-sub', {
      opacity: 1, y: 0, duration: 0.5, delay: 0.1, ease: 'power3.out',
      scrollTrigger: { trigger: '.tech-section', start: 'top 85%', once: true },
    });
    gsap.to('.tech-card', {
      opacity: 1, x: 0, stagger: 0.08, duration: 0.5, ease: 'power2.out',
      scrollTrigger: { trigger: '.tech-section', start: 'top 80%', once: true },
    });
    gsap.set('.tech-card', { x: -15 });

    // llamada a la acción
    gsap.to('.cta-card', {
      opacity: 1, scale: 1, duration: 0.7, ease: 'back.out(1.3)',
      scrollTrigger: { trigger: '.cta-section', start: 'top 85%', once: true },
    });
    gsap.set('.cta-card', { scale: 0.96 });

  } else {
    gsap.set(['#hero-badge','#hero-title','#hero-sub','#hero-cta',
              '.modules-heading','.modules-sub','.module-card',
              '.tech-heading','.tech-sub','.tech-card','.cta-card'], { opacity: 1 });
  }
</script>
