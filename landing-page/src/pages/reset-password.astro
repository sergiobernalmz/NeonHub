---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.astro';
import ResetPasswordForm from '../components/ResetPasswordForm.jsx';

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token') || '';
const source = url.searchParams.get('source') || '';
const subdomain = url.searchParams.get('subdomain') || '';
---

<Layout title="Restablecer contraseña — NeonHub" noindex={true}>
  <Navbar client:load />
  <main class="min-h-screen flex flex-col items-center justify-center bg-white dark:bg-slate-950 px-4 py-24">
    <div class="bg-white dark:bg-white/10 border border-gray-200 dark:border-white/10 rounded-2xl p-8 max-w-md w-full shadow-sm dark:shadow-none">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 text-center">Restablecer contraseña</h1>
      <p class="text-gray-500 dark:text-slate-400 text-sm text-center mb-8">
        Introduce tu nueva contraseña a continuación.
      </p>
      <ResetPasswordForm token={token} source={source} subdomain={subdomain} client:load />
    </div>
  </main>
  <Footer />
</Layout>
