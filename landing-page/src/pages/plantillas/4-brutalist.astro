---
import {
  PLANS,
  FEATURES,
  HOME_FAQ,
  HOW_IT_WORKS,
  HOME_SEO,
  HERO,
  SITE,
  NAV_LINKS,
  CTA_BAND,
  PLANS_NOTE,
} from "../../data/home-content.ts";

const jsonLdOrganization = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "NeonHub",
  url: "https://neonhub.es",
  logo: "https://neonhub.es/neonhub.png",
  contactPoint: {
    "@type": "ContactPoint",
    email: "soporte@neonhub.es",
    telephone: "+34 662552645",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Valencia",
      addressCountry: "ES",
    },
    contactOption: "SpanishLanguage",
  },
  sameAs: ["https://getneonlabs.com/"],
});

const jsonLdWebsite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "NeonHub",
  url: "https://neonhub.es",
});
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{HOME_SEO.title} | NeonHub</title>
  <meta name="description" content={HOME_SEO.description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={HOME_SEO.canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;700&family=Oswald:wght@700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={jsonLdOrganization} />
  <script type="application/ld+json" set:html={jsonLdWebsite} />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --black: #000000;
      --white: #ffffff;
      --accent: #ff3c00;
      --font-heading: 'Anton', 'Oswald', sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-mono);
      background-color: var(--white);
      color: var(--black);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* GRID BACKGROUND PATTERN */
    .grid-bg {
      background-image:
        linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* NAVBAR */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--black);
      border-bottom: 4px solid var(--white);
      padding: 0 24px;
    }

    .navbar-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .navbar-logo {
      font-family: var(--font-heading);
      font-size: 1.75rem;
      color: var(--white);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .navbar-links {
      display: flex;
      gap: 32px;
      list-style: none;
    }

    .navbar-links a {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--white);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      transition: color 0.15s;
    }

    .navbar-links a:hover {
      color: var(--accent);
    }

    /* HERO */
    .hero {
      min-height: calc(100vh - 64px);
      display: flex;
      align-items: center;
      padding: 80px 24px;
      position: relative;
    }

    .hero-inner {
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .hero h1 {
      font-family: var(--font-heading);
      font-size: clamp(3.5rem, 12vw, 10rem);
      font-weight: 400;
      line-height: 0.9;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      margin-bottom: 32px;
      color: var(--black);
    }

    .hero-subtitle {
      font-family: var(--font-mono);
      font-size: 1rem;
      max-width: 540px;
      margin-bottom: 48px;
      line-height: 1.7;
      color: var(--black);
    }

    .hero-buttons {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .btn {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 16px 32px;
      border: 3px solid var(--black);
      cursor: pointer;
      transition: all 0.15s;
      display: inline-block;
    }

    .btn-primary {
      background: var(--black);
      color: var(--white);
    }

    .btn-primary:hover {
      background: var(--accent);
      border-color: var(--accent);
    }

    .btn-secondary {
      background: var(--white);
      color: var(--black);
    }

    .btn-secondary:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--white);
    }

    /* SECTION COMMON */
    .section {
      padding: 100px 24px;
    }

    .section-inner {
      max-width: 1400px;
      margin: 0 auto;
    }

    .section-title {
      font-family: var(--font-heading);
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      margin-bottom: 64px;
      color: var(--black);
    }

    /* FEATURES */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 4px solid var(--black);
      border-left: 4px solid var(--black);
    }

    .feature-item {
      border-right: 4px solid var(--black);
      border-bottom: 4px solid var(--black);
      padding: 40px 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .feature-index {
      font-family: var(--font-heading);
      font-size: 4rem;
      line-height: 1;
      color: var(--accent);
    }

    .feature-title {
      font-family: var(--font-mono);
      font-size: 1.125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .feature-desc {
      font-size: 0.875rem;
      line-height: 1.7;
      color: #333;
    }

    .feature-item a.feature-title {
      color: var(--black);
    }

    .feature-item a.feature-title:hover {
      color: var(--accent);
    }

    /* HOW IT WORKS */
    .how-it-works {
      background: var(--black);
      color: var(--white);
    }

    .how-it-works .section-title {
      color: var(--white);
    }

    .steps-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 4px solid var(--white);
      border-left: 4px solid var(--white);
    }

    .step-item {
      border-right: 4px solid var(--white);
      padding: 48px 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .step-num {
      font-family: var(--font-heading);
      font-size: 6rem;
      line-height: 1;
      color: var(--accent);
    }

    .step-title {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .step-desc {
      font-size: 0.875rem;
      line-height: 1.7;
      color: #ccc;
    }

    /* PRICING */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 4px solid var(--black);
    }

    .plan-card {
      padding: 48px 32px;
      border-right: 4px solid var(--black);
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .plan-card:last-child {
      border-right: none;
    }

    .plan-card.featured {
      background: var(--black);
      color: var(--white);
    }

    .plan-card.featured .plan-name,
    .plan-card.featured .plan-price,
    .plan-card.featured .plan-subtitle,
    .plan-card.featured .plan-feature {
      color: var(--white);
    }

    .plan-card.featured .plan-cta {
      background: var(--white);
      color: var(--black);
      border-color: var(--white);
    }

    .plan-card.featured .plan-cta:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--white);
    }

    .plan-name {
      font-family: var(--font-heading);
      font-size: 2rem;
      text-transform: uppercase;
    }

    .plan-subtitle {
      font-size: 0.875rem;
      line-height: 1.6;
      color: #333;
    }

    .plan-price {
      font-family: var(--font-heading);
      font-size: 3rem;
      line-height: 1;
    }

    .plan-price-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 4px;
    }

    .plan-price-period {
      font-size: 0.875rem;
      font-weight: 400;
    }

    .plan-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }

    .plan-feature {
      font-size: 0.875rem;
      line-height: 1.5;
      padding-left: 20px;
      position: relative;
    }

    .plan-feature::before {
      content: "—";
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .plan-cta {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 16px 24px;
      border: 3px solid var(--black);
      background: var(--black);
      color: var(--white);
      cursor: pointer;
      transition: all 0.15s;
      text-align: center;
    }

    .plan-cta:hover {
      background: var(--accent);
      border-color: var(--accent);
    }

    .plans-note {
      margin-top: 32px;
      font-size: 0.75rem;
      line-height: 1.6;
      color: #666;
      max-width: 800px;
    }

    /* FAQ */
    .faq-list {
      border-top: 4px solid var(--black);
    }

    .faq-item {
      border-bottom: 4px solid var(--black);
      padding: 32px 0;
    }

    .faq-q {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 16px;
    }

    .faq-a {
      font-size: 0.875rem;
      line-height: 1.7;
      color: #333;
      max-width: 800px;
    }

    /* CTA BAND */
    .cta-band {
      background: var(--black);
      padding: 100px 24px;
    }

    .cta-band-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
      flex-wrap: wrap;
    }

    .cta-band-text {
      color: var(--white);
    }

    .cta-band-title {
      font-family: var(--font-heading);
      font-size: clamp(2rem, 5vw, 3.5rem);
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .cta-band-subtitle {
      font-size: 1rem;
      line-height: 1.6;
      color: #ccc;
    }

    .cta-band .btn {
      background: var(--white);
      color: var(--black);
      border-color: var(--white);
      flex-shrink: 0;
    }

    .cta-band .btn:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--white);
    }

    /* FOOTER */
    .footer {
      background: var(--black);
      border-top: 4px solid var(--white);
      padding: 48px 24px;
    }

    .footer-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 24px;
    }

    .footer-logo {
      font-family: var(--font-heading);
      font-size: 1.5rem;
      color: var(--white);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .footer-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }

    .footer-links a {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #ccc;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: color 0.15s;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    .footer-copy {
      font-size: 0.75rem;
      color: #666;
      width: 100%;
      text-align: center;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid #222;
    }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      .features-grid,
      .pricing-grid,
      .steps-row {
        grid-template-columns: 1fr;
      }

      .feature-item {
        border-right: none;
      }

      .plan-card {
        border-right: none;
        border-bottom: 4px solid var(--black);
      }

      .plan-card:last-child {
        border-bottom: none;
      }

      .step-item {
        border-right: none;
        border-bottom: 4px solid var(--white);
      }

      .step-item:last-child {
        border-bottom: none;
      }

      .cta-band-inner {
        flex-direction: column;
        text-align: center;
      }
    }

    @media (max-width: 768px) {
      .navbar-links {
        display: none;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 15vw, 5rem);
      }

      .hero-buttons {
        flex-direction: column;
      }

      .btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/" class="navbar-logo">NeonHub</a>
      <ul class="navbar-links">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero grid-bg">
    <div class="hero-inner">
      <h1>{HERO.h1}</h1>
      <p class="hero-subtitle">{HERO.subtitle}</p>
      <div class="hero-buttons">
        <a href={HERO.ctaPrimary.href} class="btn btn-primary">{HERO.ctaPrimary.label}</a>
        <a href={HERO.ctaSecondary.href} class="btn btn-secondary" target="_blank" rel="noopener">{HERO.ctaSecondary.label}</a>
      </div>
      <p style="margin-top: 24px; font-size: 0.75rem; color: #666;">{HERO.ctaMicrocopy}</p>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="section-inner">
      <h2 class="section-title">Caracteristicas</h2>
      <div class="features-grid">
        {FEATURES.map((feature, i) => (
          <div class="feature-item">
            <span class="feature-index">{String(i + 1).padStart(2, '0')}</span>
            {feature.linkTo ? (
              <a href={feature.linkTo} class="feature-title">{feature.title}</a>
            ) : (
              <span class="feature-title">{feature.title}</span>
            )}
            <p class="feature-desc">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how-it-works">
    <div class="section-inner">
      <h2 class="section-title">Como funciona</h2>
      <div class="steps-row">
        {HOW_IT_WORKS.map((step) => (
          <div class="step-item">
            <span class="step-num">{String(step.step).padStart(2, '0')}</span>
            <span class="step-title">{step.title}</span>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section">
    <div class="section-inner">
      <h2 class="section-title">Planes</h2>
      <div class="pricing-grid">
        {PLANS.map((plan) => (
          <div class={`plan-card${plan.featured ? ' featured' : ''}`}>
            <div>
              <p class="plan-name">{plan.name}</p>
              <p class="plan-subtitle">{plan.subtitle}</p>
            </div>
            <div>
              {plan.priceLabel && <p class="plan-price-label">{plan.priceLabel}</p>}
              <p class="plan-price">{plan.priceInstall}€</p>
              <p class="plan-price-period">+ {plan.priceMonthly}€/mes + IVA</p>
            </div>
            <ul class="plan-features">
              {plan.features.map((f) => (
                <li class="plan-feature">{f}</li>
              ))}
            </ul>
            <a href="/register" class="plan-cta">{plan.cta}</a>
          </div>
        ))}
      </div>
      <p class="plans-note">{PLANS_NOTE}</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="section-inner">
      <h2 class="section-title">Preguntas frecuentes</h2>
      <div class="faq-list">
        {HOME_FAQ.map((item) => (
          <div class="faq-item">
            <p class="faq-q">{item.q}</p>
            <p class="faq-a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="cta-band-inner">
      <div class="cta-band-text">
        <h3 class="cta-band-title">{CTA_BAND.title}</h3>
        <p class="cta-band-subtitle">{CTA_BAND.subtitle}</p>
      </div>
      <a href="mailto:soporte@neonhub.es" class="btn">Contactar</a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <a href="/" class="footer-logo">NeonHub</a>
      <ul class="footer-links">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href="/terminos">Terminos</a></li>
        <li><a href="/privacidad">Privacidad</a></li>
      </ul>
      <p class="footer-copy">&copy; {new Date().getFullYear()} {SITE.company}. Todos los derechos reservados.</p>
    </div>
  </footer>

</body>
</html>
