---
import {
  PLANS,
  FEATURES,
  HOME_FAQ,
  HOW_IT_WORKS,
  HOME_SEO,
  HERO,
  SITE,
  NAV_LINKS,
  CTA_BAND,
  PLANS_NOTE,
  HOME_JSONLD,
} from "../../data/home-content.ts";

const orgJsonLd = JSON.stringify(HOME_JSONLD.organization);
const websiteJsonLd = JSON.stringify(HOME_JSONLD.website);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{HOME_SEO.title} | NeonHub</title>
  <meta name="description" content={HOME_SEO.description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={HOME_SEO.canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={orgJsonLd} />
  <script type="application/ld+json" set:html={websiteJsonLd} />

  <style>
    :root {
      --bg-primary: #050510;
      --bg-card: #0d0d1a;
      --bg-card-hover: #12122a;
      --neon-cyan: #00f5ff;
      --neon-violet: #b400ff;
      --neon-cyan-dim: rgba(0, 245, 255, 0.15);
      --neon-violet-dim: rgba(180, 0, 255, 0.15);
      --text-primary: #ffffff;
      --text-muted: #8888aa;
      --border-subtle: rgba(255, 255, 255, 0.06);
      --font-heading: 'Orbitron', sans-serif;
      --font-body: 'Outfit', sans-serif;
    }

    [data-theme="light"] {
      --bg-primary: #f0f0f8;
      --bg-card: #ffffff;
      --bg-card-hover: #f8f8ff;
      --text-primary: #0a0a1a;
      --text-muted: #555577;
      --border-subtle: rgba(0, 0, 0, 0.08);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-body);
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Navbar */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.3s, backdrop-filter 0.3s;
    }

    .navbar.scrolled {
      background: rgba(5, 5, 16, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    [data-theme="light"] .navbar.scrolled {
      background: rgba(240, 240, 248, 0.85);
    }

    .navbar-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text-primary);
    }

    .logo span {
      color: var(--neon-cyan);
      text-shadow:
        0 0 8px var(--neon-cyan),
        0 0 20px rgba(0, 245, 255, 0.6),
        0 0 40px rgba(0, 245, 255, 0.3);
    }

    .nav-links {
      display: flex;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
      transition: color 0.2s;
      letter-spacing: 0.02em;
    }

    .nav-links a:hover {
      color: var(--neon-cyan);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
      font-family: var(--font-body);
      transition: border-color 0.2s, color 0.2s;
    }

    .theme-toggle:hover {
      border-color: var(--neon-cyan);
      color: var(--neon-cyan);
    }

    .mobile-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 1.5rem;
      cursor: pointer;
    }

    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 120px 24px 80px;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 60% 50% at 50% 0%, rgba(0, 245, 255, 0.08) 0%, transparent 70%),
        radial-gradient(ellipse 40% 30% at 80% 20%, rgba(180, 0, 255, 0.06) 0%, transparent 60%),
        var(--bg-primary);
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 245, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 245, 255, 0.03) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 70%);
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .orb-1 {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(0, 245, 255, 0.15) 0%, transparent 70%);
      top: 10%;
      left: 10%;
      animation: float1 8s ease-in-out infinite;
    }

    .orb-2 {
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(180, 0, 255, 0.12) 0%, transparent 70%);
      bottom: 20%;
      right: 15%;
      animation: float2 10s ease-in-out infinite;
    }

    @keyframes float1 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(30px, -20px); }
    }

    @keyframes float2 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-20px, 30px); }
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 760px;
    }

    .hero h1 {
      font-family: var(--font-heading);
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 900;
      line-height: 1.15;
      margin-bottom: 24px;
      letter-spacing: 0.02em;
    }

    .hero p {
      font-size: 1.1rem;
      color: var(--text-muted);
      max-width: 560px;
      margin: 0 auto 40px;
      line-height: 1.7;
    }

    .hero-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .btn-primary {
      display: inline-block;
      padding: 14px 32px;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--bg-primary);
      background: var(--neon-cyan);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: box-shadow 0.2s, transform 0.15s;
      box-shadow: 0 0 20px rgba(0, 245, 255, 0.4), 0 0 40px rgba(0, 245, 255, 0.2);
    }

    .btn-primary:hover {
      box-shadow: 0 0 30px rgba(0, 245, 255, 0.6), 0 0 60px rgba(0, 245, 255, 0.3);
      transform: translateY(-2px);
    }

    .btn-secondary {
      display: inline-block;
      padding: 13px 31px;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--neon-cyan);
      background: transparent;
      border: 1px solid var(--neon-cyan);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s, box-shadow 0.2s;
    }

    .btn-secondary:hover {
      background: var(--neon-cyan-dim);
      box-shadow: 0 0 20px rgba(0, 245, 255, 0.15);
    }

    .hero-microcopy {
      font-size: 0.78rem;
      color: var(--text-muted);
      opacity: 0.7;
    }

    /* Features */
    .features {
      padding: 100px 24px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 3vw, 2rem);
      text-align: center;
      margin-bottom: 16px;
      letter-spacing: 0.03em;
    }

    .section-subtitle {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 60px;
      font-size: 1rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 32px 28px;
      transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
    }

    .feature-card:hover {
      border-color: rgba(0, 245, 255, 0.4);
      box-shadow: 0 0 30px rgba(0, 245, 255, 0.08), inset 0 0 30px rgba(0, 245, 255, 0.03);
      background: var(--bg-card-hover);
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      color: var(--neon-cyan);
      filter: drop-shadow(0 0 8px rgba(0, 245, 255, 0.5));
    }

    .feature-icon svg {
      width: 32px;
      height: 32px;
    }

    .feature-card h3 {
      font-family: var(--font-heading);
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 12px;
      letter-spacing: 0.03em;
    }

    .feature-card p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.65;
    }

    .feature-card a {
      display: inline-block;
      margin-top: 16px;
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--neon-cyan);
      transition: opacity 0.2s;
    }

    .feature-card a:hover {
      opacity: 0.75;
    }

    /* How it Works */
    .how-it-works {
      padding: 100px 24px;
      background: var(--bg-card);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }

    .how-it-works-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .steps {
      display: flex;
      gap: 40px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 60px;
    }

    .step {
      flex: 1;
      min-width: 240px;
      max-width: 320px;
      text-align: center;
      position: relative;
    }

    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 28px;
      right: -20px;
      width: 40px;
      height: 1px;
      background: linear-gradient(90deg, var(--neon-cyan), transparent);
    }

    .step-number {
      font-family: var(--font-heading);
      font-size: 2.4rem;
      font-weight: 900;
      color: transparent;
      -webkit-text-stroke: 2px var(--neon-cyan);
      text-shadow: 0 0 20px rgba(0, 245, 255, 0.4);
      margin-bottom: 16px;
      display: block;
    }

    .step h3 {
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 10px;
      letter-spacing: 0.03em;
    }

    .step p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Pricing */
    .pricing {
      padding: 100px 24px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .plans-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 16px;
    }

    .plan-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      transition: border-color 0.25s, box-shadow 0.25s;
      position: relative;
    }

    .plan-card.featured {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 40px rgba(0, 245, 255, 0.12), inset 0 0 40px rgba(0, 245, 255, 0.04);
    }

    .plan-card.featured::before {
      content: 'Popular';
      position: absolute;
      top: -1px;
      right: 24px;
      background: var(--neon-cyan);
      color: var(--bg-primary);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 0 0 8px 8px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .plan-name {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 8px;
      letter-spacing: 0.04em;
    }

    .plan-subtitle {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 28px;
      line-height: 1.5;
    }

    .plan-price {
      margin-bottom: 4px;
    }

    .plan-price .amount {
      font-family: var(--font-heading);
      font-size: 2.4rem;
      font-weight: 900;
      letter-spacing: 0.02em;
    }

    .plan-price .currency {
      font-size: 1.2rem;
      vertical-align: super;
    }

    .plan-price .label {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-left: 6px;
    }

    .plan-price .monthly {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .plan-note {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 28px;
      opacity: 0.8;
    }

    .plan-features {
      list-style: none;
      margin-bottom: 32px;
      flex-grow: 1;
    }

    .plan-features li {
      font-size: 0.88rem;
      color: var(--text-muted);
      padding: 8px 0;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .plan-features li:last-child {
      border-bottom: none;
    }

    .plan-features li::before {
      content: '✓';
      color: var(--neon-cyan);
      font-weight: 700;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .plan-cta {
      display: block;
      width: 100%;
      padding: 13px;
      font-family: var(--font-body);
      font-size: 0.9rem;
      font-weight: 600;
      text-align: center;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s, box-shadow 0.2s;
    }

    .plan-card:not(.featured) .plan-cta {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
    }

    .plan-card:not(.featured) .plan-cta:hover {
      border-color: var(--neon-cyan);
      color: var(--neon-cyan);
    }

    .plan-card.featured .plan-cta {
      background: var(--neon-cyan);
      color: var(--bg-primary);
      box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
    }

    .plan-card.featured .plan-cta:hover {
      box-shadow: 0 0 30px rgba(0, 245, 255, 0.5);
    }

    .plans-note {
      text-align: center;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 24px;
      opacity: 0.75;
    }

    /* FAQ */
    .faq {
      padding: 100px 24px;
      max-width: 800px;
      margin: 0 auto;
    }

    .faq-list {
      margin-top: 48px;
    }

    .faq-item {
      border-bottom: 1px solid var(--border-subtle);
    }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      padding: 24px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 500;
      color: var(--text-primary);
      text-align: left;
      gap: 16px;
    }

    .faq-question:hover {
      color: var(--neon-cyan);
    }

    .faq-icon {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      position: relative;
      transition: transform 0.25s;
    }

    .faq-icon::before,
    .faq-icon::after {
      content: '';
      position: absolute;
      background: currentColor;
    }

    .faq-icon::before {
      width: 14px;
      height: 2px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .faq-icon::after {
      width: 2px;
      height: 14px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      transition: opacity 0.25s;
    }

    .faq-item.open .faq-icon::after {
      opacity: 0;
    }

    .faq-item.open .faq-icon {
      transform: rotate(45deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
    }

    .faq-answer-inner {
      padding-bottom: 24px;
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.7;
    }

    /* CTA Band */
    .cta-band {
      padding: 80px 24px;
      text-align: center;
      position: relative;
      background: var(--bg-card);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
      overflow: hidden;
    }

    .cta-band::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 80% at 50% 50%, rgba(0, 245, 255, 0.06) 0%, transparent 60%),
        radial-gradient(ellipse 40% 60% at 50% 50%, rgba(180, 0, 255, 0.04) 0%, transparent 50%);
    }

    .cta-band-inner {
      position: relative;
      z-index: 1;
      max-width: 600px;
      margin: 0 auto;
    }

    .cta-band h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      margin-bottom: 16px;
      letter-spacing: 0.03em;
    }

    .cta-band p {
      color: var(--text-muted);
      font-size: 1rem;
      margin-bottom: 32px;
    }

    .cta-band a {
      color: var(--neon-cyan);
      font-weight: 500;
      transition: opacity 0.2s;
    }

    .cta-band a:hover {
      opacity: 0.75;
    }

    .cta-band .btn-glow {
      display: inline-block;
      padding: 14px 36px;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 600;
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      border-radius: 8px;
      background: var(--neon-cyan-dim);
      transition: box-shadow 0.2s, background 0.2s;
      box-shadow: 0 0 20px rgba(0, 245, 255, 0.2);
    }

    .cta-band .btn-glow:hover {
      background: rgba(0, 245, 255, 0.1);
      box-shadow: 0 0 30px rgba(0, 245, 255, 0.35);
    }

    /* Footer */
    .footer {
      padding: 48px 24px 32px;
      border-top: 1px solid var(--border-subtle);
    }

    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-brand {
      font-family: var(--font-heading);
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    .footer-brand span {
      color: var(--neon-cyan);
      text-shadow: 0 0 8px rgba(0, 245, 255, 0.5);
    }

    .footer-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }

    .footer-links a {
      font-size: 0.82rem;
      color: var(--text-muted);
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--neon-cyan);
    }

    .footer-copy {
      width: 100%;
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-muted);
      opacity: 0.6;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
    }

    /* Mobile */
    @media (max-width: 900px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .plans-grid {
        grid-template-columns: 1fr;
        max-width: 420px;
        margin-left: auto;
        margin-right: auto;
      }
    }

    @media (max-width: 640px) {
      .nav-links {
        display: none;
        position: fixed;
        top: 64px;
        left: 0;
        right: 0;
        background: var(--bg-primary);
        border-bottom: 1px solid var(--border-subtle);
        flex-direction: column;
        padding: 24px;
        gap: 20px;
      }

      .nav-links.open {
        display: flex;
      }

      .mobile-toggle {
        display: block;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .steps {
        flex-direction: column;
        align-items: center;
      }

      .step:not(:last-child)::after {
        display: none;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }

      .footer-links {
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <div class="navbar-inner">
      <a href="/" class="logo">Neon<span>Hub</span></a>
      <ul class="nav-links" id="nav-links">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        <button class="theme-toggle" id="theme-toggle">Cambiar tema</button>
        <button class="mobile-toggle" id="mobile-toggle" aria-label="Menu">☰</button>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="hero-content">
      <h1>{HERO.h1}</h1>
      <p>{HERO.subtitle}</p>
      <div class="hero-buttons">
        <a href={HERO.ctaPrimary.href} class="btn-primary">{HERO.ctaPrimary.label}</a>
        <a href={HERO.ctaSecondary.href} class="btn-secondary" target="_blank" rel="noopener">{HERO.ctaSecondary.label}</a>
      </div>
      <p class="hero-microcopy">{HERO.ctaMicrocopy}</p>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <h2 class="section-title">Todo lo que necesitas para vender online</h2>
    <p class="section-subtitle">Ferramientas esenciales integradas en una sola plataforma.</p>
    <div class="features-grid">
      {FEATURES.map((feature) => (
        <div class="feature-card">
          <div class="feature-icon">
            {feature.icon === "Palette" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
              </svg>
            )}
            {feature.icon === "CreditCard" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="5" rx="2"/>
                <line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
            )}
            {feature.icon === "LayoutDashboard" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="7" height="9" x="3" y="3" rx="1"/>
                <rect width="7" height="5" x="14" y="3" rx="1"/>
                <rect width="7" height="9" x="14" y="12" rx="1"/>
                <rect width="7" height="5" x="3" y="16" rx="1"/>
              </svg>
            )}
            {feature.icon === "Globe" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" x2="22" y1="12" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            )}
            {feature.icon === "ShieldCheck" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            )}
            {feature.icon === "LifeBuoy" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="4"/>
                <line x1="4.93" x2="9.17" y1="4.93" y2="9.17"/>
                <line x1="14.83" x2="19.07" y1="14.83" y2="19.07"/>
                <line x1="14.83" x2="19.07" y1="9.17" y2="4.93"/>
                <line x1="14.83" x2="18.36" y1="9.17" y2="5.64"/>
                <line x1="4.93" x2="9.17" y1="19.07" y2="14.83"/>
              </svg>
            )}
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
          {feature.linkTo && <a href={feature.linkTo}>Saber más →</a>}
        </div>
      ))}
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works">
    <div class="how-it-works-inner">
      <h2 class="section-title">Como funciona</h2>
      <p class="section-subtitle">Tu tienda lista en tres pasos sencillos.</p>
      <div class="steps">
        {HOW_IT_WORKS.map((step) => (
          <div class="step">
            <span class="step-number">{step.step}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing" id="pricing">
    <h2 class="section-title">Precios claros y sin sorpresas</h2>
    <p class="section-subtitle">Elige el plan que mejor se adapte a tu negocio.</p>
    <div class="plans-grid">
      {PLANS.map((plan) => (
        <div class={`plan-card${plan.featured ? " featured" : ""}`}>
          <div class="plan-name">{plan.name}</div>
          <div class="plan-subtitle">{plan.subtitle}</div>
          <div class="plan-price">
            <span class="amount">{plan.priceInstall.toLocaleString("es-ES")}</span>
            <span class="label">€</span>
            <span class="monthly">+ {plan.priceMonthly} €/mes</span>
          </div>
          <div class="plan-note">Alta única no reembolsable + IVA</div>
          <ul class="plan-features">
            {plan.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href="/register" class="plan-cta">{plan.cta}</a>
        </div>
      ))}
    </div>
    <p class="plans-note">{PLANS_NOTE}</p>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <h2 class="section-title">Preguntas frecuentes</h2>
    <div class="faq-list">
      {HOME_FAQ.map((item, i) => (
        <div class="faq-item" data-index={i}>
          <button class="faq-question">
            {item.q}
            <span class="faq-icon"></span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">{item.a}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="cta-band-inner">
      <h2>{CTA_BAND.title}</h2>
      <p>{CTA_BAND.subtitle}</p>
      <a href="mailto:soporte@neonhub.es" class="btn-glow">Contactar</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">Neon<span>Hub</span></div>
      <ul class="footer-links">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="footer-copy">
      &copy; {new Date().getFullYear()} {SITE.name} — {SITE.city}
    </div>
  </footer>

  <script>
    const navbar = document.getElementById("navbar");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        navbar?.classList.add("scrolled");
      } else {
        navbar?.classList.remove("scrolled");
      }
    });

    const themeToggle = document.getElementById("theme-toggle");
    themeToggle?.addEventListener("click", () => {
      const html = document.documentElement;
      const current = html.getAttribute("data-theme");
      html.setAttribute("data-theme", current === "light" ? "dark" : "light");
    });

    const mobileToggle = document.getElementById("mobile-toggle");
    const navLinks = document.getElementById("nav-links");
    mobileToggle?.addEventListener("click", () => {
      navLinks?.classList.toggle("open");
    });

    const faqItems = document.querySelectorAll(".faq-item");
    faqItems.forEach((item) => {
      const btn = item.querySelector(".faq-question");
      btn?.addEventListener("click", () => {
        const isOpen = item.classList.contains("open");
        faqItems.forEach((i) => i.classList.remove("open"));
        if (!isOpen) {
          item.classList.add("open");
        }
      });
    });
  </script>
</body>
</html>
