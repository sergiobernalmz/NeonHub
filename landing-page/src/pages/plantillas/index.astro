---
// Galería pública de variantes visuales para la home de NeonHub.
// Todas usan el mismo contenido de /src/data/home-content.ts.
// Noindex: solo para revisión interna.

export const VARIANTS = [
  {
    id: 1,
    slug: "editorial",
    name: "Editorial / Minimalist",
    description: "Limpio, tipográfico, espacios amplios. Blanco roto con detalles en verde bosque.",
    accent: "#2d5016",
    gradient: "linear-gradient(135deg, #fafaf8, #e8f0e0)",
    textColor: "#1a1a1a",
  },
  {
    id: 2,
    slug: "neon",
    name: "Neón Disciplinado",
    description: "Oscuro con bordes neón cyan/violeta. Disciplina y tecnología.",
    accent: "#00f5ff",
    gradient: "linear-gradient(135deg, #050510, #0d0d2a)",
    textColor: "#ffffff",
  },
  {
    id: 3,
    slug: "premium",
    name: "Premium Soft",
    description: "Violeta suave, sombras delicadas, elegante y premium.",
    accent: "#8b5cf6",
    gradient: "linear-gradient(135deg, #faf9ff, #f0eeff)",
    textColor: "#1e1b2e",
  },
  {
    id: 4,
    slug: "brutalist",
    name: "Brutalist / Swiss",
    description: "Cuadrícula rígida, bordes thick, tipografía condensada en negro sobre blanco.",
    accent: "#ff3c00",
    gradient: "linear-gradient(135deg, #ffffff, #f0f0f0)",
    textColor: "#000000",
  },
  {
    id: 5,
    slug: "colorful",
    name: "Colorful / Vivid",
    description: "Colores saturados, formas orgánicas, enérgico y vibrante.",
    accent: "#ec4899",
    gradient: "linear-gradient(135deg, #fef9ff, #fdf2fb)",
    textColor: "#1e1b2e",
  },
];

const title = "Plantillas — NeonHub";
const description = "5 variantes visuales de la home de NeonHub. mismo contenido, diferente diseño.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Outfit', system-ui, sans-serif;
        background: #0f0e1a;
        color: #e2e8f0;
        min-height: 100vh;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      header {
        padding: 60px 0 48px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        margin-bottom: 64px;
      }

      header .badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #a78bfa;
        border: 1px solid rgba(167,139,250,0.3);
        padding: 4px 12px;
        border-radius: 100px;
        margin-bottom: 20px;
      }

      header h1 {
        font-size: clamp(28px, 5vw, 48px);
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
      }

      header p {
        font-size: 18px;
        color: #94a3b8;
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.6;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 24px;
        padding-bottom: 80px;
      }

      .card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(167,139,250,0.3);
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
      }

      .card-preview {
        height: 220px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card-preview::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.25);
        pointer-events: none;
      }

      .card-body {
        padding: 28px;
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .card-number {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 10px;
      }

      .card h2 {
        font-size: 22px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 10px;
      }

      .card p {
        font-size: 14px;
        color: #94a3b8;
        line-height: 1.6;
        flex: 1;
      }

      .card-footer {
        padding: 20px 28px;
        border-top: 1px solid rgba(255,255,255,0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .card-accent-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      .card-link {
        font-size: 13px;
        font-weight: 600;
        color: #a78bfa;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s;
      }

      .card-link:hover {
        color: #c4b5fd;
      }

      .card-link svg {
        transition: transform 0.2s;
      }

      .card:hover .card-link svg {
        transform: translateX(3px);
      }

      footer {
        text-align: center;
        padding: 40px 0;
        border-top: 1px solid rgba(255,255,255,0.06);
        color: #475569;
        font-size: 13px;
      }

      @media (max-width: 640px) {
        .grid { grid-template-columns: 1fr; }
        header { padding: 40px 0 32px; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="badge">Galería de variantes</div>
        <h1>5 diseños para la home de NeonHub</h1>
        <p>Mesmo contenido, diferente mundo visual. Clic en cadatarjeta para abrir la variante en pantalla completa.</p>
      </header>

      <div class="grid">
        {VARIANTS.map((v) => (
          <article class="card">
            <div
              class="card-preview"
              style={`background: ${v.gradient};`}
            >
              <svg width="280" height="160" viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="20" y="20" width="240" height="14" rx="3" fill={v.textColor} opacity="0.12" />
                <rect x="20" y="44" width="160" height="8" rx="2" fill={v.textColor} opacity="0.08" />
                <rect x="20" y="60" width="80" height="28" rx="4" fill={v.accent} opacity="0.7" />
                <rect x="108" y="60" width="80" height="28" rx="4" fill={v.accent} opacity="0.3" />
                <rect x="20" y="100" width="70" height="40" rx="4" fill={v.textColor} opacity="0.06" />
                <rect x="98" y="100" width="70" height="40" rx="4" fill={v.textColor} opacity="0.06" />
                <rect x="176" y="100" width="70" height="40" rx="4" fill={v.textColor} opacity="0.06" />
              </svg>
            </div>
            <div class="card-body">
              <div class="card-number">Variante {v.id}</div>
              <h2>{v.name}</h2>
              <p>{v.description}</p>
            </div>
            <div class="card-footer">
              <div class="card-accent-dot" style={`background: ${v.accent};`} />
              <a href={`/plantillas/${v.id}-${v.slug}`} class="card-link">
                Ver variante
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <footer>
      NeonHub — Galería de variantes visuates. No indexar.
    </footer>
  </body>
</html>
