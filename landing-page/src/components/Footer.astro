---
import { validateSession } from '../lib/auth';
const year = new Date().getFullYear();
const sessionId = Astro.cookies.get('app_auth_token')?.value;
const session = sessionId ? await validateSession(sessionId) : null;
const footerUser = session ? session.user : null;
const isLoggedIn = !!footerUser;
const dashboardUrl = footerUser?.role === 'admin' ? '/admin' : '/dashboard';
---

<footer id="contact" class="bg-gray-50 dark:bg-slate-950 border-t border-gray-200 dark:border-white/10 py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="text-2xl font-bold tracking-tighter text-gray-900 dark:text-white flex items-center gap-2 mb-4">
          <img src="/neonhub.png" alt="NeonHub" class="w-8 h-8 rounded-lg" />
          NeonHub
        </a>
        <a href="https://getneonlabs.com/" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-400 transition-colors mb-2 block">
          GetNeonLabs
        </a>
        <p class="text-gray-500 dark:text-slate-400 max-w-sm">
          Transformando el futuro del comercio digital con tecnología de vanguardia y diseño excepcional.
        </p>
      </div>

      <div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-4">Producto</h4>
        <ul class="space-y-2">
          <li><a href="/servicio" class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Servicio</a></li>
          <li><a href="/precios" class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Precios</a></li>
          <li><a href="/contacto" class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Contacto</a></li>
          {isLoggedIn ? (
            <li><a href={dashboardUrl} class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Mi dashboard</a></li>
          ) : (
            <>
              <li><a href="/register" class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Crear cuenta gratis</a></li>
              <li><a href="/login" class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Iniciar sesión</a></li>
            </>
          )}
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-4">Contacto</h4>
        <ul class="space-y-2">
          <li><a href="mailto:soporte@neonhub.es" class="text-gray-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors">soporte@neonhub.es</a></li>
          <li class="text-gray-500 dark:text-slate-400">+34 662552645</li>
          <li class="text-gray-500 dark:text-slate-400">Valencia, España</li>
          <li class="mt-3"><a href="/legal/terminos" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-400 transition-colors text-sm">Términos de uso</a></li>
          <li><a href="/legal/privacidad" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-400 transition-colors text-sm">Política de privacidad</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-gray-200 dark:border-white/5 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 dark:text-slate-500 text-sm">
        &copy; {year} NeonHub. Todos los derechos reservados.
      </p>
      <div class="flex gap-4">
        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-white/5 hover:bg-gray-300 dark:hover:bg-white/10 transition-colors cursor-pointer"></div>
        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-white/5 hover:bg-gray-300 dark:hover:bg-white/10 transition-colors cursor-pointer"></div>
        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-white/5 hover:bg-gray-300 dark:hover:bg-white/10 transition-colors cursor-pointer"></div>
      </div>
    </div>
  </div>
</footer>
