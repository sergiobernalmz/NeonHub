---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
  favicon?: string;
}

const {
  title,
  description = 'NeonHub — Plataforma SaaS multi-tenant para crear y gestionar tiendas online profesionales. Pagos Stripe, analytics, personalización completa.',
  ogImage = 'https://neonhub.es/og-image.png',
  noindex = false,
  jsonLd,
  favicon
} = Astro.props;

const siteUrl = 'https://neonhub.es';
const canonical = Astro.props.canonical ?? `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- Anti-FOUC: aplica dark class antes del primer paint -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('landingTheme') || 'dark';
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Indexing -->
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="NeonLabs" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NeonHub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@neonhub_es" />

    <!-- Favicon -->
    {favicon ? (
      <link rel="icon" type="image/png" href={favicon} />
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-white dark:bg-slate-950 text-gray-900 dark:text-white font-['Outfit',sans-serif] overflow-x-hidden">
    <slot />
  </body>
</html>
