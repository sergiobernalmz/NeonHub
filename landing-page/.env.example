# ===========================================
# LANDING PAGE ENVIRONMENT — Astro SSR
# Copy this file to .env and fill in your values. Never commit .env.
# ===========================================

# ===========================================
# URLS
# ===========================================

# Canonical public URL of the landing page (used for canonical tags, sitemaps, OG tags)
# Example: https://neonhub.es
PUBLIC_SITE_URL=https://your-public-site-url-here

# Base URL of the NeonHub backend API consumed by the landing page
# Example: https://api.neonhub.es/api
PUBLIC_API_BASE_URL=https://your-api-base-url-here/api

# ===========================================
# SECURITY
# ===========================================

# Shared secret that authorises privileged calls from the landing page to the backend
# Must match ADMIN_API_SECRET in the backend .env
ADMIN_API_SECRET=your-admin-api-secret-here

# ===========================================
# LANDING DATABASE (PostgreSQL)
# ===========================================

# Hostname of the PostgreSQL server that stores landing page data
LANDING_DB_HOST=localhost

# Port of the PostgreSQL server (default: 5432)
LANDING_DB_PORT=5432

# Name of the landing page database
LANDING_DB_NAME=landing_db

# Database user with access to LANDING_DB_NAME
LANDING_DB_USER=your-landing-db-user-here

# Password for the landing database user above
LANDING_DB_PASSWORD=your-landing-db-password-here

# ===========================================
# N8N WEBHOOKS
# ===========================================

# Base webhook URL for your n8n automation instance
# Example: https://n8n.your-domain.com/webhook
N8N_WEBHOOK_URL=https://your-n8n-instance-here/webhook

# Webhook URL triggered when a new user requests email verification from the landing page
N8N_VERIFY_EMAIL_WEBHOOK=https://your-n8n-instance-here/webhook/verify-email
