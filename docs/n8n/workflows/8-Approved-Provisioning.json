            {
              "value1": "={{$json[\"body\"][\"tenant_name\"]}}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{$json[\"body\"][\"subdomain\"]}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Payload válido?",
