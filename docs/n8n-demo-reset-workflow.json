{
  "name": "NeonHub — Demo Reset (cada hora)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://neonhub.es/api/billing/admin/demo/reset",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Reset-Token",
              "value": "{{$env.DEMO_RESET_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "POST reset Demo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "¿Éxito?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "OK (sin acción)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "fromEmail": "soporte@neonhub.es",
        "toEmail": "soporte@neonhub.es",
        "subject": "⚠️ NeonHub — Demo reset fallido",
        "emailType": "text",
        "message": "El reset automático de la tienda Demo ha fallado.\n\nHora: {{ $now.toISO() }}\n\nDetalle:\n{{ JSON.stringify($json, null, 2) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Email — alerta error",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "POST reset Demo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST reset Demo": {
      "main": [
        [
          {
            "node": "¿Éxito?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Éxito?": {
      "main": [
        [
          {
            "node": "OK (sin acción)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email — alerta error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
