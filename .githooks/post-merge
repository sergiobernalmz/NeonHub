#!/usr/bin/env bash
# .githooks/post-merge
#
# Se ejecuta automáticamente tras un `git pull` / `git merge` exitoso en el
# servidor de producción, SOLO si está activado con:
#
#   git config core.hooksPath .githooks
#
# (ejecutar una sola vez en la VM; no se activa en local automáticamente
# porque core.hooksPath es config local de cada clon, no se trackea en git).
#
# Objetivo: que tras un `git push` desde tu máquina, en el servidor solo haga
# falta `git pull` y el deploy (install/migrate/build/pm2 reload) ocurra solo.

set -uo pipefail

ROOT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_PATH" || exit 1

echo "🔄 post-merge: comprobando qué cambió..."

CHANGED="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || echo "")"

changed_in() {
    printf '%s\n' "$CHANGED" | grep -q "^$1"
}

ran_something=0

if changed_in "backend/package.json" || changed_in "backend/package-lock.json"; then
    echo "📦 backend: package.json cambió, reinstalando..."
    (cd backend && npm install --omit=dev) && ran_something=1
fi

if changed_in "backend/src/database/migrations/"; then
    echo "🗄️  backend: nuevas migraciones, ejecutando..."
    (cd backend && npm run migrate) && ran_something=1
fi

if changed_in "frontend/package.json" || changed_in "frontend/package-lock.json"; then
    echo "📦 frontend: package.json cambió, reinstalando..."
    (cd frontend && npm install) && ran_something=1
fi

if changed_in "frontend/"; then
    if [ ! -f "frontend/.env.production" ]; then
        echo "❌ frontend/.env.production no existe. Build de frontend NO ejecutado."
        echo "   Crea el archivo según frontend/.env.example con los valores de prod"
        echo "   y vuelve a lanzar: cd frontend && npm run build && pm2 reload neonhub-backend"
    else
        echo "🔨 frontend: reconstruyendo build de producción..."
        (cd frontend && npm run build) && ran_something=1
    fi
fi

if changed_in "landing-page/package.json" || changed_in "landing-page/package-lock.json"; then
    echo "📦 landing: package.json cambió, reinstalando..."
    (cd landing-page && npm install) && ran_something=1
fi

if changed_in "landing-page/"; then
    echo "🔨 landing: reconstruyendo..."
    (cd landing-page && ASTRO_DATABASE_FILE="$ROOT_PATH/landing-page/landing.db" npm run build) && ran_something=1
fi

if [ "$ran_something" -eq 1 ] && command -v pm2 >/dev/null 2>&1; then
    echo "♻️  Recargando PM2..."
    pm2 reload "$ROOT_PATH/ecosystem.neonhub.config.js" --env production --update-env
    pm2 save
fi

echo "✅ post-merge completado."
