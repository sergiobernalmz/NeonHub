# ===========================================
# FRONTEND ENVIRONMENT — Vite
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
# Copy this file to .env (local) or .env.production (server) and fill in your values.
# Never commit .env, .env.local, or .env.production — only this .env.example is committed.
# ===========================================

# ===========================================
# ENTORNOS SOPORTADOS POR VITE
# ===========================================
#
# Vite carga automáticamente los siguientes archivos (por orden de prioridad):
#   1. .env                  → siempre (valores base)
#   2. .env.local            → siempre (overrides locales, ignorado por git)
#   3. .env.[mode]           → solo en el mode indicado (development | production | electron)
#   4. .env.[mode].local     → solo en el mode indicado, ignorado por git
#
# Modos relevantes en este proyecto:
#   - npm run dev    → mode=development  → usa .env.development
#   - npm run build  → mode=production   → usa .env.production  ✅ ESTE es el del build
#
# FLUJO RECOMENDADO:
#   • En tu máquina local:    cp .env.example .env            y edita con valores de local
#   • En el servidor (VM):    cp .env.example .env.production y edita con valores de prod
#                              (este archivo permanece en la VM, no se commitea)
#
# ===========================================
# API
# ===========================================

# Full base URL of the NeonHub backend API, including /api prefix
#
# ┌─ DESARROLLO LOCAL (tu máquina) ───────────────────────────────────┐
# │  VITE_API_BASE=http://localhost:3011/api                          │
# │  VITE_TENANT_BASE_DOMAIN=localhost                                │
# │  Vite usa el proxy de vite.config.js para redirigir /api → :3011  │
# └────────────────────────────────────────────────────────────────────┘
#
# ┌─ PRODUCCIÓN (VM con Nginx Proxy Manager) ─────────────────────────┐
# │  VITE_API_BASE=/api                                               │
# │  VITE_TENANT_BASE_DOMAIN=neonhub.es                               │
# │  Nginx enrutará /api → 10.10.10.2:4000 (backend) automáticamente │
# │  No pongas dominio absoluto, usa ruta relativa para multi-tenant  │
# └────────────────────────────────────────────────────────────────────┘
VITE_API_BASE=https://your-api-base-url-here/api
VITE_TENANT_BASE_DOMAIN=your-tenant-base-domain-here

# ===========================================
# STRIPE
# ===========================================

# Stripe publishable key (pk_live_… or pk_test_…)
# Must match the STRIPE_PUBLISHABLE_KEY configured in the backend
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# ===========================================
# APPLICATION
# ===========================================

# Human-readable application name shown in the UI and browser tab
VITE_APP_NAME=NeonHub

# Semantic version string of this frontend release (keep in sync with package.json)
VITE_APP_VERSION=1.0.0
