{
  "name": "frontend",
  "private": true,
  "version": "1.3.6",
  "description": "NeonHub - Panel de gestión SaaS",
  "author": {
    "name": "NeonLabs",
    "email": "soporte@neonhub.es"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:vite:build": "vite build --mode electron",
    "electron:build:win": "vite build --mode electron && electron-builder --win",
    "electron:build:mac": "vite build --mode electron && electron-builder --mac"
  },
  "build": {
    "appId": "es.neonlabs.neonhub",
    "productName": "NeonHub",
    "forceCodeSigning": false,
    "publish": {
      "provider": "generic",
      "url": "https://neonhub.es/updates/"
    },
    "directories": {
      "output": "../desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeonHub",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/neonhub.png"
    },
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.1",
    "axios": "^1.12.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.23.12",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jetbrains-mono": "^1.0.6",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.8",
    "autoprefixer": "^10.4.21",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.1.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2",
    "vitest": "^4.0.8"
  }
}
