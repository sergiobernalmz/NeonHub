{
  "name": "neonhub-backend",
  "version": "1.0.0",
  "description": "NeonHub Backend API - Enterprise Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'Backend build completed'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:security": "jest tests/security",
    "test:ci": "jest --coverage --passWithNoTests --detectOpenHandles --forceExit",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "db:reset": "npm run migrate && npm run seed"
  },
  "keywords": [
    "api",
    "express",
    "mysql",
    "jwt",
    "enterprise",
    "management"
  ],
  "author": "NeonHub Development Team",
  "license": "MIT",
  "dependencies": {
    "@logtail/node": "^0.5.8",
    "@sentry/node": "^10.47.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "pg": "^8.17.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "sharp": "^0.34.4",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.7",
    "stripe": "^20.1.2",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
