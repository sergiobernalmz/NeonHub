# ===========================================
# SERVER
# ===========================================

# Runtime environment: development | production | test
NODE_ENV=development

# Hostname the server binds to
HOST=localhost

# Port the API server listens on
PORT=4000

# API version prefix used in routes (e.g. /api/v1)
API_VERSION=v1

# Base domain used to resolve tenant subdomains (e.g. neonhub.es)
TENANT_BASE_DOMAIN=your-tenant-base-domain-here

# ===========================================
# URLs / CORS
# ===========================================

# URL of the main frontend SPA (used for CORS and email links)
FRONTEND_URL=https://your-frontend-url-here

# URL of the public landing page (used for CORS and redirects)
LANDING_URL=https://your-landing-url-here

# Public-facing base URL of this API (used in generated links)
PUBLIC_SITE_URL=https://your-public-site-url-here

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=https://your-frontend-url-here,https://your-landing-url-here

# ===========================================
# MAIN DATABASE (NeonHub — PostgreSQL)
# ===========================================

# Sequelize dialect: postgres | mysql | sqlite
DB_DIALECT=postgres

# Database server hostname
DB_HOST=localhost

# Database server port
DB_PORT=5432

# Name of the main application database
DB_NAME=neonhub_db

# Database user with full access to DB_NAME
DB_USER=your-db-user-here

# Password for the database user above
DB_PASSWORD=your-db-password-here

# ===========================================
# JWT AUTHENTICATION
# ===========================================

# Secret used to sign short-lived access tokens (use a long random string)
JWT_SECRET=your-jwt-secret-here

# Expiry duration for access tokens (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# Secret used to sign long-lived refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# Expiry duration for refresh tokens (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# SECURITY
# ===========================================

# Shared secret required to call protected admin API endpoints
ADMIN_API_SECRET=your-admin-api-secret-here

# Internal service-to-service API key
SERVICE_API_KEY=your-service-api-key-here

# Number of bcrypt rounds for password hashing (higher = slower but safer)
BCRYPT_ROUNDS=12

# Rate-limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per window per IP
RATE_LIMIT_MAX=100

# Token required to trigger demo data reset (leave empty to disable)
DEMO_RESET_TOKEN=

# ===========================================
# STRIPE
# ===========================================

# Stripe secret key (sk_live_… or sk_test_…)
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# Stripe publishable key (pk_live_… or pk_test_…) — also used by the frontend
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# Webhook signing secret for standard Stripe events (whsec_…)
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Webhook signing secret for Stripe Connect events
STRIPE_WEBHOOK_SECRET_CONNECT=your-stripe-webhook-secret-connect-here

# Default currency for Stripe charges (ISO 4217 lowercase, e.g. eur, usd)
STRIPE_CURRENCY=eur

# Billing mode: subscription | one_time
STRIPE_BILLING_MODE=subscription

# ===========================================
# EMAIL
# ===========================================

# SMTP server hostname
EMAIL_HOST=your-smtp-host-here

# SMTP server port (usually 587 for STARTTLS, 465 for SSL)
EMAIL_PORT=587

# Set to true if using implicit SSL on port 465
EMAIL_SECURE=false

# SMTP authentication username
EMAIL_USER=your-email-user-here

# SMTP authentication password
EMAIL_PASS=your-email-password-here

# "From" address shown to recipients (e.g. NeonHub <no-reply@neonhub.es>)
EMAIL_FROM=your-email-from-here

# ===========================================
# UPLOADS
# ===========================================

# Directory where uploaded files are stored (relative to backend root)
UPLOAD_PATH=./uploads

# Maximum upload size in bytes (default: 10 MB)
MAX_FILE_SIZE=10485760

# ===========================================
# REDIS
# ===========================================

# Redis connection URL (used for caching / pub-sub)
REDIS_URL=redis://localhost:6379

# Set to true to enable Redis integration
REDIS_ENABLED=false

# ===========================================
# SUSTAINABILITY — External APIs
# ===========================================

# Enable/disable background certification scheduler (true | false)
ENABLE_CERTIFICATION_SCHEDULER=false

# Enable/disable real-time sustainability data updates (true | false)
ENABLE_REAL_TIME_SUSTAINABILITY=false

# Interval in milliseconds between sustainability data refreshes
SUSTAINABILITY_UPDATE_INTERVAL=60000

# CO2 Signal API key (https://www.co2signal.com)
CO2SIGNAL_API_KEY=your-co2signal-api-key-here

# OpenWeather API key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Electricity Map API key (https://electricitymaps.com)
ELECTRICITYMAP_API_KEY=your-electricitymap-api-key-here

# Energy Star API key
ENERGYSTAR_API_KEY=your-energystar-api-key-here

# EPEAT API key
EPEAT_API_KEY=your-epeat-api-key-here

# FSC (Forest Stewardship Council) API key
FSC_API_KEY=your-fsc-api-key-here

# C2C (Cradle to Cradle) API key
C2C_API_KEY=your-c2c-api-key-here

# ===========================================
# N8N WEBHOOKS
# ===========================================

# Base URL of your n8n instance (used to construct webhook URLs)
N8N_WEBHOOK_URL=https://your-n8n-instance-here/webhook

# Webhook triggered on new tenant onboarding
N8N_WEBHOOK_ONBOARDING=

# Webhook triggered on order events
N8N_WEBHOOK_ORDERS=

# Webhook triggered on return/refund events
N8N_WEBHOOK_RETURNS=

# Webhook triggered on license activation events
N8N_WEBHOOK_ACTIVATIONS=

# Webhook triggered on billing events
N8N_WEBHOOK_BILLING=

# Webhook triggered on notification dispatch
N8N_WEBHOOK_NOTIFICATIONS=

# Webhook triggered on report generation
N8N_WEBHOOK_REPORTS=

# Webhook triggered on support ticket events
N8N_WEBHOOK_SUPPORT=

# Webhook triggered on supplier events
N8N_WEBHOOK_SUPPLIERS=

# Webhook triggered on inventory changes
N8N_WEBHOOK_INVENTORY=

# Webhook triggered on analytics events
N8N_WEBHOOK_ANALYTICS=

# Webhook triggered on sustainability data events
N8N_WEBHOOK_SUSTAINABILITY=

# Webhook triggered on user events
N8N_WEBHOOK_USERS=

# Webhook triggered on deployment events
N8N_WEBHOOK_DEPLOYMENTS=

# ===========================================
# MONITORING / OBSERVABILITY
# ===========================================

# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=your-sentry-dsn-here

# Logtail / Better Stack source token for log shipping
LOGTAIL_KEY=your-logtail-key-here

# ===========================================
# DEPLOY
# ===========================================

# API key used to authenticate automated deployment scripts
DEPLOY_API_KEY=your-deploy-api-key-here
